-- 버튼 정중앙 좌표를 계산해서 실제 마우스 클릭 시뮬레이션
-- ============================================================
local function clickExactly(button)
    if button and button.AbsoluteSize.X > 0 and button.Visible then
        local absPos = button.AbsolutePosition
        local absSize = button.AbsoluteSize
        local topBarHeight = GuiService:GetGuiInset().Y
        local centerX = absPos.X + (absSize.X / 2)
        local centerY = absPos.Y + (absSize.Y / 2) + topBarHeight

        showClickIndicator(centerX, centerY)
        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 0)
        return true
    end
    return false
end

-- ============================================================
-- 밀도 시각화 — STATE.ShowDensityViz가 켜져 있으면 각 "장소"(클러스터)마다
-- 라벨 1개만 표시 (초록 = 파트 적음/확률 높음, 빨강 = 파트 많음/확률 낮음).
-- 파트 하나하나에 라벨을 달면 렉이 심해서 장소 단위로 딱 하나씩만 띄운다.
-- ============================================================
local vizGuis = {} -- 대표 파트 -> BillboardGui 캐시

local function updateDensityViz(clusterList)
    if not STATE.ShowDensityViz then
        if next(vizGuis) then
            for part, gui in pairs(vizGuis) do
                if gui then gui:Destroy() end
            end
            vizGuis = {}
        end
        return
    end

    local seen = {}
    local maxCount = 1
    for _, cluster in ipairs(clusterList) do
        if #cluster.parts > maxCount then maxCount = #cluster.parts end
    end

    for _, cluster in ipairs(clusterList) do
        local anchorPart = cluster.parts[1]
        seen[anchorPart] = true
        local count = #cluster.parts
        local t = maxCount > 1 and math.clamp((count - 1) / (maxCount - 1), 0, 1) or 0
        local color = Color3.new(t, 1 - t, 0) -- 초록(안전) -> 빨강(몰림)

        local gui = vizGuis[anchorPart]
        if not gui then
            gui = Instance.new("BillboardGui")
            gui.Name = "DensityVizGui"
            gui.Size = UDim2.new(0, 70, 0, 26)
            gui.StudsOffset = Vector3.new(0, 3, 0)
            gui.AlwaysOnTop = true
            gui.Parent = anchorPart

            local label = Instance.new("TextLabel")
            label.Name = "Label"
            label.Size = UDim2.new(1, 0, 1, 0)
            label.TextSize = 18
            label.Font = Enum.Font.GothamBold
            label.TextColor3 = Color3.new(1, 1, 1)
            label.Parent = gui

            vizGuis[anchorPart] = gui
        end

        local label = gui:FindFirstChild("Label")
        if label then
            label.Text = tostring(count)
            label.BackgroundColor3 = color
            label.BackgroundTransparency = 0.2
        end
    end

    for part, gui in pairs(vizGuis) do
        if not seen[part] then
            if gui then gui:Destroy() end
            vizGuis[part] = nil
        end
    end
end

-- ============================================================
-- 파트 크기(Size)까지 반영해서, 기준 위치에서 가장 먼 "모서리 지점"을 계산
-- (중심점만 보지 않고, 파트가 크면 그만큼 더 멀리 뻗어있는 모서리까지 고려)
-- ============================================================
local function getFarthestCornerXZ(part, fromPos)
    local cf = part.CFrame
    local halfSize = part.Size / 2
    local farthestPoint = nil
    local farthestDistSq = -1
    for sx = -1, 1, 2 do
        for sz = -1, 1, 2 do
            local corner = (cf * CFrame.new(halfSize.X * sx, 0, halfSize.Z * sz)).Position
            local dx = corner.X - fromPos.X
            local dz = corner.Z - fromPos.Z
            local distSq = dx * dx + dz * dz
            if distSq > farthestDistSq then
                farthestDistSq = distSq
                farthestPoint = corner
            end
        end
    end
    return farthestPoint, farthestDistSq
end

