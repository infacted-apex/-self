-- ============================================================
-- Auto Eating (통합 기능) — STATE.AutoEating 일 때만 동작
--   1) Fragmentable 랜덤 텔레포트 (최근 30개 중복 제외, 스폰 대기 좌표 제외)
--   2) LocalEvents.Grab / LocalEvents.Eat Fire (0.01초 별도 루프)
--   3) ProgressText 정체 감지 (15초/30초/60초 3단계) → Fire만 일시정지, 60초는 Sell 3번+리셋
-- ============================================================
local function autoEatingLoop()
    local RECENT_EXCLUDE_COUNT = 5
    local recentClusterKeys = {}
    local CLUSTER_GRID_SIZE = 10 -- 이 범위(스터드) 안에 몰려있는 파트는 "같은 위치"로 묶음

    local lastProgressText = nil
    local lastChangeTime = tick()
    local stalledFor15Triggered = false
    local stalledFor30Triggered = false
    local stalledFor60Triggered = false
    local vizTickCounter = 0
    local CLUSTER_REBUILD_INTERVAL = 5 -- 초 단위 - 무거운 그룹핑 계산은 이 주기로만 다시 함
    local lastClusterBuildTime = 0
    local cachedClusterList = nil

    local function rememberCluster(clusterKey, capCount)
        table.insert(recentClusterKeys, clusterKey)
        while #recentClusterKeys > capCount do
            table.remove(recentClusterKeys, 1)
        end
    end

    -- ✅ [최적화] 매초 fragmentable:GetChildren()으로 전체 목록을 통째로 다시 긁어오는
    -- 대신, ChildAdded/ChildRemoved로 실시간 목록(Set)을 한 번만 만들어두고 계속
    -- 갱신한다. 파트 개수가 계속 늘어나는 버그가 있는 상황에서, 매초 전체 배열을
    -- 새로 만드는 GetChildren()이 반복될수록 점점 더 무거워지는 걸 방지한다.
    local watchFolder = nil
    local watchParts = {} -- Set: part -> true
    local watchAddedConn, watchRemovedConn

    local function ensureFragmentableWatch()
        local map = workspace:FindFirstChild("Map")
        local fragmentable = map and map:FindFirstChild("Fragmentable")
        if not fragmentable then
            return nil
        end
        if watchFolder ~= fragmentable then
            if watchAddedConn then watchAddedConn:Disconnect() end
            if watchRemovedConn then watchRemovedConn:Disconnect() end
            watchFolder = fragmentable
            watchParts = {}
            for _, child in ipairs(fragmentable:GetChildren()) do
                if child:IsA("BasePart") then
                    watchParts[child] = true
                end
            end
            watchAddedConn = fragmentable.ChildAdded:Connect(function(child)
                if child:IsA("BasePart") then
                    watchParts[child] = true
                end
            end)
            watchRemovedConn = fragmentable.ChildRemoved:Connect(function(child)
                watchParts[child] = nil
            end)
        end
        return watchFolder
    end

    task.spawn(function()
        while true do
            task.wait(1)
            if STATE.AutoEating and not STATE.SellConditionActive and not STATE.GlobalPause then
                -- 1) 랜덤 Fragmentable 텔레포트 (고정 그리드로 위치를 묶어서 균등하게 선택)
                local ok1, err1 = pcall(function()
                    local fragmentable = ensureFragmentableWatch()
                    if not fragmentable then return end

                    local PENDING_POS = Vector3.new(0, -20, 0)
                    local PENDING_EPSILON = 1 -- 스터드 오차 허용

                    -- ✅ [최적화] "위치 그룹핑"(전체 파트 훑기)은 무거운 작업이라, 텔레포트할
                    -- 때마다(매초) 매번 다시 하지 않고 CLUSTER_REBUILD_INTERVAL(5초)에
                    -- 한 번만 다시 계산한다. 그 사이의 텔레포트들은 캐시된 목록에서만
                    -- 골라서, 무거운 계산과 실제 순간이동(물리 스텝)이 매번 겹쳐서 렉이
                    -- 겹으로 오는 걸 줄인다.
                    local now = tick()
                    if not cachedClusterList or (now - lastClusterBuildTime) >= CLUSTER_REBUILD_INTERVAL then
                        -- 문자열 키(string.format) 대신 좌표를 그대로 중첩 테이블의 인덱스로
                        -- 써서 묶는다. 파트 개수만큼 반복되는 문자열 생성 비용이 없어지고,
                        -- 문자열 키는 최종적으로 훨씬 적은 "장소" 개수만큼만 만든다.
                        local gridX = {}
                        for part in pairs(watchParts) do
                            if part.Parent and (part.Position - PENDING_POS).Magnitude > PENDING_EPSILON then
                                local pos = part.Position
                                local cx = math.floor(pos.X / CLUSTER_GRID_SIZE + 0.5)
                                local cy = math.floor(pos.Y / CLUSTER_GRID_SIZE + 0.5)
                                local cz = math.floor(pos.Z / CLUSTER_GRID_SIZE + 0.5)

                                local yTab = gridX[cx]
                                if not yTab then
                                    yTab = {}
                                    gridX[cx] = yTab
                                end
                                local zTab = yTab[cy]
                                if not zTab then
                                    zTab = {}
                                    yTab[cy] = zTab
                                end
                                local bucket = zTab[cz]
                                if not bucket then
                                    bucket = {}
                                    zTab[cz] = bucket
                                end
                                table.insert(bucket, part)
                            end
                        end

                        local freshClusterList = {}
                        for cx, yTab in pairs(gridX) do
                            for cy, zTab in pairs(yTab) do
                                for cz, parts in pairs(zTab) do
                                    table.insert(freshClusterList, {
                                        key = cx .. "_" .. cy .. "_" .. cz,
                                        parts = parts,
                                        -- 그리드 칸 중심 좌표(정확한 평균은 아니지만 "이 장소가
                                        -- 대략 어디쯤인지" 비교하는 용도로는 충분하고, 계산 비용이
                                        -- 거의 없음 - 매번 파트를 다시 훑지 않아도 됨)
                                        centroidX = cx * CLUSTER_GRID_SIZE,
                                        centroidZ = cz * CLUSTER_GRID_SIZE,
                                    })
                                end
                            end
                        end

                        cachedClusterList = freshClusterList
                        lastClusterBuildTime = now
                    end

                    local clusterList = cachedClusterList

                    -- 인게임 시각화: 켜져있을 때만 3틱(약 3초)에 한 번씩 갱신해서 부담을
                    -- 줄임. 꺼져있으면 즉시 정리(가벼운 작업)한다.
                    if not STATE.ShowDensityViz then
                        vizTickCounter = 0
                        updateDensityViz(clusterList)
                    else
                        vizTickCounter = vizTickCounter + 1
                        if vizTickCounter >= 3 then
                            vizTickCounter = 0
                            updateDensityViz(clusterList)
                        end
                    end

                    local totalCount = #clusterList
                    if totalCount == 0 then return end

                    -- 후보(장소) 총 개수가 5개보다 적으면, 제외 개수도 "장소 수 - 1"로 줄여서
                    -- pickPool이 절대 비지 않게(항상 최소 1곳은 선택 가능하게) 만든다.
                    local effectiveExcludeCount = math.max(0, math.min(RECENT_EXCLUDE_COUNT, totalCount - 1))
                    while #recentClusterKeys > effectiveExcludeCount do
                        table.remove(recentClusterKeys, 1)
                    end

                    local excludeSet = {}
                    for _, k in ipairs(recentClusterKeys) do
                        excludeSet[k] = true
                    end

                    local pickPool = {}
                    for _, cluster in ipairs(clusterList) do
                        if not excludeSet[cluster.key] then
                            table.insert(pickPool, cluster)
                        end
                    end
                    if #pickPool == 0 then
                        pickPool = clusterList
                    end

                    -- 장소 단위로 균등 랜덤 선택 (한 곳에 몇 개가 있든 각 장소는 1표씩)
                    local chosenCluster = pickPool[math.random(1, #pickPool)]

                    -- ✅ 캐시된 목록이라 그 사이(최대 5초) 파트가 사라졌을 수 있음 - 실제
                    -- 사용 직전에 살아있는 파트만 걸러낸다. 이 장소가 통째로 사라졌으면
                    -- 다음 틱에 강제로 재계산하도록 캐시를 비우고 이번 틱은 건너뛴다.
                    local validParts = {}
                    for _, p in ipairs(chosenCluster.parts) do
                        if p.Parent then
                            table.insert(validParts, p)
                        end
                    end
                    if #validParts == 0 then
                        cachedClusterList = nil
                        return
                    end

                    rememberCluster(chosenCluster.key, effectiveExcludeCount)

                    -- 뽑힌 장소 안에서는 살아있는 파트 중 아무거나 하나 사용
                    local targetPart = validParts[math.random(1, #validParts)]

                    local char = LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if not hrp then return end

                    local partTopOffset = targetPart.Size.Y / 2
                    local partTopPosition = (targetPart.CFrame * CFrame.new(0, partTopOffset, 0)).Position

                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    local hipHeight = (humanoid and humanoid.HipHeight) or 2
                    local safeMargin = (hrp.Size.Y / 2) + hipHeight + 1

                    local finalPosition = partTopPosition + Vector3.new(0, safeMargin, 0)

                    -- ✅ [사용자 요청] "가장 먼 지점"을 이번에 도착한 좁은 칸(10스터드) 안이
                    -- 아니라, 지도 전체의 장소(클러스터) 중에서 찾는다. 매번 파트 수천 개를
                    -- 다 훑으면 다시 느려지니, 2단계로 나눈다:
                    --   1) 먼저 장소(클러스터)들의 중심 좌표끼리만 비교해서(개수가 훨씬
                    --      적음) 가장 먼 "장소"를 찾고,
                    --   2) 그 장소 안에서만 파트 크기(Size)까지 반영한 진짜 모서리를 계산.
                    local farthestCluster = nil
                    local farthestCentroidDistSq = -1
                    for _, cluster in ipairs(clusterList) do
                        local dx = cluster.centroidX - finalPosition.X
                        local dz = cluster.centroidZ - finalPosition.Z
                        local distSq = dx * dx + dz * dz
                        if distSq > farthestCentroidDistSq then
                            farthestCentroidDistSq = distSq
                            farthestCluster = cluster
                        end
                    end

                    local overallFarthestPoint = nil
                    local overallFarthestDistSq = -1
                    if farthestCluster then
                        for _, p in ipairs(farthestCluster.parts) do
                            if p.Parent then
                                local corner, distSq = getFarthestCornerXZ(p, finalPosition)
                                if distSq > overallFarthestDistSq then
                                    overallFarthestDistSq = distSq
                                    overallFarthestPoint = corner
                                end
                            end
                        end
                    end

                    if overallFarthestPoint and overallFarthestDistSq > 0.01 then
                        local lookAtPos = Vector3.new(overallFarthestPoint.X, finalPosition.Y, overallFarthestPoint.Z)
                        hrp.CFrame = CFrame.new(finalPosition, lookAtPos)
                        showFarthestPointMarker(overallFarthestPoint)
                    else
                        hrp.CFrame = CFrame.new(finalPosition)
                    end
                end)
                if not ok1 then
                    warn("[Auto Eating - 텔레포트 오류] " .. tostring(err1))
                end

                -- 2) ProgressText 정체 감지 (3단계: 15초 -> 5초 대기 / 30초 -> 10초 대기 /
                --    60초 -> 10초 대기 후 Sell 버튼 3번 클릭 후 재설정)
                local ok2, err2 = pcall(function()
                    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                    local screenGui = playerGui and playerGui:FindFirstChild("ScreenGui")
                    local sell = screenGui and screenGui:FindFirstChild("Sell")
                    local progressText = sell and sell:FindFirstChild("ProgressText")
                    if not progressText then return end

                    local currentText = progressText.Text
                    if currentText ~= lastProgressText then
                        lastProgressText = currentText
                        lastChangeTime = tick()
                        stalledFor15Triggered = false
                        stalledFor30Triggered = false
                        stalledFor60Triggered = false
                        STATE.FirePausedUntil = 0 -- 진행 재개됐으니 Fire 일시정지도 즉시 해제
                        return
                    end

                    local elapsed = tick() - lastChangeTime

                    if elapsed >= 60 and not stalledFor60Triggered then
                        stalledFor60Triggered = true
                        STATE.FirePausedUntil = tick() + 10 -- Fire만 10초 정지 (텔레포트는 계속 작동)

                        -- 10초 대기 -> Sell 3번 클릭 -> 재설정 은 별도 코루틴으로 처리해서
                        -- 이 함수(=메인 루프)를 블로킹하지 않게 함 (텔레포트가 계속 돌아야 하므로)
                        task.spawn(function()
                            task.wait(10)

                            local okClick, errClick = pcall(function()
                                local playerGui2 = LocalPlayer:FindFirstChild("PlayerGui")
                                local screenGui2 = playerGui2 and playerGui2:FindFirstChild("ScreenGui")
                                local sell2 = screenGui2 and screenGui2:FindFirstChild("Sell")
                                local outline2 = sell2 and sell2:FindFirstChild("outline")
                                for _ = 1, 3 do
                                    if outline2 then
                                        clickExactly(outline2)
                                    end
                                    task.wait(0.2)
                                end
                            end)
                            if not okClick then
                                warn("[Auto Eating - 60초 정체 Sell 클릭 오류] " .. tostring(errClick))
                            end

                            local char = LocalPlayer.Character
                            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                            if humanoid then
                                humanoid.Health = 0
                            end
                        end)
                    elseif elapsed >= 30 and not stalledFor30Triggered then
                        stalledFor30Triggered = true
                        STATE.FirePausedUntil = tick() + 10 -- Fire만 10초 정지
                    elseif elapsed >= 15 and not stalledFor15Triggered then
                        stalledFor15Triggered = true
                        STATE.FirePausedUntil = tick() + 5 -- Fire만 5초 정지
                    end
                end)
                if not ok2 then
                    warn("[Auto Eating - 정체 감지 오류] " .. tostring(err2))
                end
            end
        end
    end)
end

-- ============================================================
-- Auto Eating - Grab/Eat Fire 전용 루프 (0.01초 간격, 텔레포트/정체감지와 분리)
-- ============================================================
local function autoEatingFireLoop()
    task.spawn(function()
        while true do
            task.wait(0.01)
            if STATE.AutoEating and not STATE.SellConditionActive and tick() >= STATE.FirePausedUntil and not STATE.GlobalPause then
                local ok, err = pcall(function()
                    local localEvents = ReplicatedStorage:FindFirstChild("LocalEvents")
                    local grab = localEvents and localEvents:FindFirstChild("Grab")
                    local eat = localEvents and localEvents:FindFirstChild("Eat")
                    if grab then grab:Fire() end
                    if eat then eat:Fire() end
                end)
                if not ok then
                    warn("[Auto Eating - Grab/Eat Fire 오류] " .. tostring(err))
                end
            end
        end
    end)
end

-- ============================================================
-- Auto Time Reward — STATE.AutoTimeReward 일 때만 동작
--   1) Rewards.TimedRewards.RewardGrid 안의 모든 Template 감시
--   2) Template.Time.Text == "Tap to claim!" 이면 Rewards.Visible 켜고(0.35초) 클릭 ->
--      0.25초 대기 후 Rewards.Visible 끄기. 여러 개면 각각 5초 간격으로 순서대로 처리.
--   3) 모든 Template.Time.Text == "Claimed!" 이면, 전체 로직 10초 정지 -> Sell 3번 클릭
--      -> 재접속 (재접속 전 토글 상태 저장, 재접속 후 자동 복원)
-- ============================================================
local function autoTimeRewardLoop()
    task.spawn(function()
        while true do
            task.wait(1)
            if STATE.AutoTimeReward and not STATE.GlobalPause then
                local ok, err = pcall(function()
                    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                    local screenGui = playerGui and playerGui:FindFirstChild("ScreenGui")
                    local rewards = screenGui and screenGui:FindFirstChild("Rewards")
                    local timedRewards = rewards and rewards:FindFirstChild("TimedRewards")
                    local rewardGrid = timedRewards and timedRewards:FindFirstChild("RewardGrid")
                    if not rewardGrid then return end

                    local templates = {}
                    for _, child in ipairs(rewardGrid:GetChildren()) do
                        if child.Name == "Template" then
                            table.insert(templates, child)
                        end
                    end
                    if #templates == 0 then return end

                    local claimableTemplates = {}
                    local allClaimed = true
                    for _, tmpl in ipairs(templates) do
                        local timeLabel = tmpl:FindFirstChild("Time")
                        local txt = timeLabel and timeLabel.Text
                        if txt ~= "Claimed!" then
                            allClaimed = false
                        end
                        if txt == "Tap to claim!" then
                            table.insert(claimableTemplates, tmpl)
                        end
                    end

                    -- 모든 템플릿이 Claimed! 상태 -> 전체 정지 -> Sell 3번 -> 재접속
                    if allClaimed then
                        STATE.GlobalPause = true
                        task.wait(10)

                        local okClick, errClick = pcall(function()
                            local playerGui2 = LocalPlayer:FindFirstChild("PlayerGui")
                            local screenGui2 = playerGui2 and playerGui2:FindFirstChild("ScreenGui")
                            local sell2 = screenGui2 and screenGui2:FindFirstChild("Sell")
                            local outline2 = sell2 and sell2:FindFirstChild("outline")
                            for _ = 1, 3 do
                                if outline2 then
                                    clickExactly(outline2)
                                end
                                task.wait(0.2)
                            end
                        end)
                        if not okClick then
                            warn("[Auto Time Reward - Sell 클릭 오류] " .. tostring(errClick))
                        end

                        PersistCurrentToggleStates()
                        ReconnectNow()
                        return
                    end

                    -- Tap to claim! 인 것들을 순서대로 처리 (여러 개면 5초 간격)
                    for _, tmpl in ipairs(claimableTemplates) do
                        if not (STATE.AutoTimeReward and not STATE.GlobalPause) then break end

                        if rewards then
                            rewards.Visible = true
                        end
                        task.wait(0.35)
                        clickExactly(tmpl)
                        task.wait(0.25)
                        if rewards then
                            rewards.Visible = false
                        end
                        task.wait(5)
                    end
                end)
                if not ok then
                    warn("[Auto Time Reward 오류] " .. tostring(err))
                end
            end
        end
    end)
end

-- ============================================================
-- 재접속 시 UI 자동 숨김 + 이미지 표시 (P키로 다시 보이기)
-- (붙여넣어주신 자작 스크립트의 TriggerUIHide 로직을 그대로 참고해서 이식함)
-- ============================================================
getgenv().TriggerUIHide = function(customImageId, onShowCallback)
    local coreGui = game:GetService("CoreGui")

    -- 이미 실행 중인 숨김 UI 및 이벤트 제거 (중복 방지)
    if getgenv()._reconScreenGui then
        pcall(function() getgenv()._reconScreenGui:Destroy() end)
    end
    if getgenv()._reconMoveConn then
        getgenv()._reconMoveConn:Disconnect()
    end
    if getgenv()._reconInputConn then
        getgenv()._reconInputConn:Disconnect()
    end
    if getgenv()._reconForceHideConn then
        getgenv()._reconForceHideConn:Disconnect()
    end

    -- ETW 매크로 UI의 ScreenGui 이름 (Material.Load의 Title과 동일)
    local scriptUIName = "ETW 매크로"
    local isHidden = true
    local scriptUI
    local forceHideConn

    local function hideUI(gui)
        if gui:IsA("ScreenGui") and isHidden then
            scriptUI = gui
            gui.Enabled = false
            if not forceHideConn then
                forceHideConn = gui:GetPropertyChangedSignal("Enabled"):Connect(function()
                    if isHidden and gui.Enabled then
                        gui.Enabled = false
                    end
                end)
                getgenv()._reconForceHideConn = forceHideConn
            end
        end
    end

    local function checkChild(child)
        if child.Name == scriptUIName then
            hideUI(child)
        end
    end

    coreGui.ChildAdded:Connect(checkChild)
    for _, child in ipairs(coreGui:GetChildren()) do checkChild(child) end

    local hiddenUI = coreGui:FindFirstChild("HiddenUI")
    if hiddenUI then
        hiddenUI.ChildAdded:Connect(checkChild)
        for _, child in ipairs(hiddenUI:GetChildren()) do checkChild(child) end
    end

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ETWReconnectionPromptGui"
    screenGui.Parent = coreGui
    getgenv()._reconScreenGui = screenGui

    local imgLabel = Instance.new("ImageLabel")
    imgLabel.Size = UDim2.new(0, 960, 0, 288)
    imgLabel.Position = UDim2.new(0.5, -480, 1, -300)
    imgLabel.BackgroundTransparency = 1

    -- 최고 화질 로딩: 썸네일 우회 후 원본 데칼 텍스처 직접 추출
    local imgId = customImageId or "rbxassetid://129920542078687"
    task.spawn(function()
        pcall(function()
            local objs = game:GetObjects(imgId)
            if objs and objs[1] and objs[1]:IsA("Decal") then
                imgLabel.Image = objs[1].Texture
            end
        end)
    end)
    imgLabel.Image = imgId

    imgLabel.ScaleType = Enum.ScaleType.Fit
    imgLabel.ImageTransparency = 0.1
    imgLabel.Parent = screenGui

    -- 무한 기호(∞) 궤적을 그리며 둥둥 떠다니는 부드러운 모션 (Lissajous 곡선)
    local RS = game:GetService("RunService")
    local basePos = UDim2.new(0.5, -480, 1, -300)
    local moveConn

    moveConn = RS.RenderStepped:Connect(function()
        local t = os.clock() * 1.5
        local offsetX = math.sin(t) * 45
        local offsetY = math.sin(t * 2) * 20
        local rot = math.cos(t) * 2.5
        local trans = 0.35 + math.sin(t * 0.8) * 0.25

        imgLabel.Position = UDim2.new(basePos.X.Scale, basePos.X.Offset + offsetX, basePos.Y.Scale,
            basePos.Y.Offset + offsetY)
        imgLabel.Rotation = rot
        imgLabel.ImageTransparency = trans
    end)
    getgenv()._reconMoveConn = moveConn

    local uis = game:GetService("UserInputService")
    local conn
    conn = uis.InputBegan:Connect(function(input, gp)
        if not gp and input.KeyCode == Enum.KeyCode.P then
            if isHidden then
                isHidden = false
                if forceHideConn then forceHideConn:Disconnect() end
                if scriptUI then scriptUI.Enabled = true end
                if conn then conn:Disconnect() end

                if onShowCallback then
                    pcall(onShowCallback)
                end

                if moveConn then moveConn:Disconnect() end
                local TS = TweenService
                local fadeOut = TS:Create(imgLabel, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    { ImageTransparency = 1 })
                fadeOut:Play()
                fadeOut.Completed:Connect(function()
                    if screenGui then screenGui:Destroy() end
                end)
            end
        end
    end)
    getgenv()._reconInputConn = conn
end

-- 재접속(텔레포트)으로 다시 실행된 경우, UI가 만들어지는 즉시 숨기고 이미지를 띄운다
