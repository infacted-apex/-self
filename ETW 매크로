local TOGGLE_STATE_FILE = ACCOUNT_FOLDER .. "/ETW_ToggleStates.json"

local function SaveToggleStates(state)
    if not writefile then return end
    local ok, err = pcall(function()
        writefile(TOGGLE_STATE_FILE, HttpService:JSONEncode({
            AutoEating = state.AutoEating,
            AutoSell = state.AutoSell,
            AutoTimeReward = state.AutoTimeReward,
            AntiAFK = state.AntiAFK,
        }))
    end)
    if not ok then
        warn("[토글 상태 저장 오류] " .. tostring(err))
    end
end

local function LoadToggleStates()
    if not (isfile and readfile and isfile(TOGGLE_STATE_FILE)) then return nil end
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(TOGGLE_STATE_FILE))
    end)
    if ok and type(decoded) == "table" then
        return decoded
    end
    return nil
end

