                    Services.Debris:AddItem(ghost, 0.4)
                end)

                -- [STYLISH] 3. 채도 순간 저하 (Desaturation Pulse)
                task.spawn(function()
                    local elements = { UIElements.displayName, UIElements.userName, UIElements.hpNumber, UIElements
                        .teamText }
                    local originalColors = {}
                    for _, el in ipairs(elements) do
                        originalColors[el] = el.TextColor3
                        el.TextColor3 = Color3.fromRGB(120, 120, 120) -- 순간 무채색
