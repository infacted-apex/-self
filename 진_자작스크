                -- [STYLISH] 2. 텍스트 잔상 (Afterimage)
                task.spawn(function()
                    local ghost = UIElements.distText:Clone()
                    ghost.Parent = UIElements.rightFrame
                    ghost.Position = UIElements.distText.Position
                    ghost.ZIndex = UIElements.distText.ZIndex - 1
