                -- [STYLISH] 1. HUD 샤프 로테이션 (날카로운 회전 후 복귀)
                Services.TweenService:Create(UIElements.leftFrame,
                    TweenInfo.new(0.05, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Rotation = -18 }):Play()
                Services.TweenService:Create(UIElements.rightFrame,
                    TweenInfo.new(0.05, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Rotation = 18 }):Play()
                task.delay(0.1, function()
                    Services.TweenService:Create(UIElements.leftFrame,
                        TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = -6 }):Play()
                    Services.TweenService:Create(UIElements.rightFrame,
                        TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = 6 }):Play()
