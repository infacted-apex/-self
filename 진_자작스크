        if char then
            -- [ADVANCED] 캐릭터 기본 효과음을 제외한 모든 음악 파일 자동 감지
            local excluded = { "Climbing", "Died", "FreeFalling", "GettingUp", "Jumping", "Landing", "Running", "Splash",
                "Swimming" }
            for _, child in ipairs(char:GetDescendants()) do
                if child:IsA("Sound") and child.IsPlaying and child.TimeLength > 0 then
                    if not table.find(excluded, child.Name) then
                        child.Volume = 1 -- 음악 볼륨 1 고정
                        return child
                    end
                end
            end
        end
    end

    -- 2순위: 기존 Funny 음악 기능
    if getgenv and getgenv().FunnyMusicPlaying and getgenv().CurrentFunnyMusic and getgenv().CurrentFunnyMusic ~= "" then
        local funnySound = game:GetService("CoreGui"):FindFirstChild(getgenv().CurrentFunnyMusic)
        if funnySound and funnySound:IsA("Sound") and funnySound.IsPlaying and funnySound.TimeLength > 0 then
            return funnySound
        end
    end
    return nil
end

Settings.MusicVisualizerSetting.MotionAlpha = 0
-- Settings.MusicVisualizerSetting.VisualizerTime in settings registry
-- Settings.MusicVisualizerSetting.lastCamLook in settings registry
-- Settings.MusicVisualizerSetting.lastCamPos in settings registry -- 캐릭터 움직임 감지를 위한 위치 추적 추가
-- Settings.MusicVisualizerSetting.currentSway in settings registry

-- 비주얼라이저 및 타임라인 실시간 렌더링
Services.RunService.RenderStepped:Connect(function(dt)
    local sound = GetCurrentPlayingSound()

    -- [NEW] 동기화 모드 시 파티클 이미터 색상 감지
    local syncColor = nil
    if Settings.Sols.musicSync then
        local char = LocalPlayer.Character or (workspace:FindFirstChild(LocalPlayer.Name))
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            for _, descendant in ipairs(hrp:GetDescendants()) do
                if descendant:IsA("ParticleEmitter") then
                    syncColor = descendant.Color.Keypoints[1].Value
                    break
                end
            end
        end
    end

    -- 카메라/캐릭터 움직임 물리 효과 (현실적인 스웨이)
    local currentLook = Camera.CFrame.LookVector
    local currentPos = Camera.CFrame.Position

    local lookDelta = currentLook - Settings.MusicVisualizerSetting.lastCamLook
    -- 카메라 로컬 좌표계 기준으로 위치 변화량 산출 (이동 방향 감지)
    local posDelta = Camera.CFrame:VectorToObjectSpace(currentPos - Settings.MusicVisualizerSetting.lastCamPos)

    Settings.MusicVisualizerSetting.lastCamLook = currentLook
    Settings.MusicVisualizerSetting.lastCamPos = currentPos

    -- 회전(관성)과 이동(가속도 느낌)을 결합하여 타겟 스웨이 계산
    -- 화면 회전에 따른 감도를 3배 낮춤 (20 -> 6.6)

    -- [보정] 3인칭 줌 아웃 시 위치 변화량이 과하게 커지는 현상 방지
    local camDistance = (currentPos - Camera.Focus.Position).Magnitude
    local posDamping = math.max(1, camDistance / 10) -- 거리가 멀수록 이동 감도 감쇄

    local targetSway = Vector2.new(
        (lookDelta.X * 6.6) - (posDelta.X * 1.5 / posDamping),
        (lookDelta.Y * 6.6) + (posDelta.Y * 1.5 / posDamping)
    )

    -- 타임라인이 화면 밖으로 너무 크게 벗어나는 것 방지 (Cap)
    targetSway = Vector2.new(math.clamp(targetSway.X, -0.3, 0.3), math.clamp(targetSway.Y, -0.3, 0.3))

    Settings.MusicVisualizerSetting.currentSway = Settings.MusicVisualizerSetting.currentSway:Lerp(targetSway, 0.1)
    Settings.MusicVisualizerSetting.currentSway = Settings.MusicVisualizerSetting.currentSway * 0.92 -- 감쇠(관성 유지)

    local swayX, swayY = Settings.MusicVisualizerSetting.currentSway.X * 100,
        Settings.MusicVisualizerSetting.currentSway.Y * 100

    -- 비주얼라이저 바는 고정 (스웨이 제거)
    leftContainer.Position = UDim2.new(0, 0, 0.5, 0)
    rightContainer.Position = UDim2.new(1, 0, 0.5, 0)

    -- 타임라인 바에만 위치 상향(0.85) 및 스웨이 오프셋 적용
    -- [NEW] 사운드 크기에 따른 타임라인 떨림(Shake) 계산 (과하지 않게 normalized 기반 jitter 적용)
    local timelineShakeX, timelineShakeY = 0, 0
    if sound and sound.IsPlaying then
        local loudness = sound.PlaybackLoudness or 0
        -- [EXPONENTIAL SHAKE] 작은 소리에는 둔감하게, 큰 소리에는 폭발적으로 반응 (상한 15.0)
        -- (loudness/500)의 제곱을 사용하여 낮은 볼륨에서의 떨림을 억제합니다.
        local factor = loudness / 500
        local shakeIntensity = 0.1 + (math.pow(factor, 2) * 14.9)
        timelineShakeX = math.random(-100, 100) / 100 * shakeIntensity
        timelineShakeY = math.random(-100, 100) / 100 * shakeIntensity
    end

    local targetAlpha = (sound and sound.IsPlaying) and 1 or 0
    -- 더욱 부드러운 프레임 독립적 보간 (dt 사용)
    local lerpSpeed = (targetAlpha == 1) and 10 or 6 -- 나타날 때 조금 더 빠르게, 사라질 때 조금 더 여유있게
    Settings.MusicVisualizerSetting.MotionAlpha = Settings.MusicVisualizerSetting.MotionAlpha +
        (targetAlpha - Settings.MusicVisualizerSetting.MotionAlpha) * math.clamp(dt * lerpSpeed, 0, 1)

    local motion = Settings.MusicVisualizerSetting.MotionAlpha
    -- [Refinement] Cubic Easing (motion^3) 적용 - 0에 가까워질수록 급격히 작아져서 '툭' 사라지는 느낌 방지
    local m3 = math.pow(motion, 3)

    -- 투명도 제어 (invMotion: 0(나타남)~1(사라짐))
    local invM = 1 - motion

    -- [MODIFIED] 타임라인 투명도 개선 (더 밝게)
    timelineBox.BackgroundTransparency = 0.5 + (0.5 * invM)
    timelineProgress.BackgroundTransparency = 0.15 + (0.85 * invM) -- 0.3 -> 0.15로 밝기 개선

    -- [MODIFIED] 동기화 모드일 때 제목 숨김
    musicTitle.TextTransparency = Settings.Sols.musicSync and 1 or invM
    musicTitle.TextStrokeTransparency = 0.5 + (0.5 * invM)

    -- [NEW] 동기화 색상 감지 (기존 그라데이션 대신 단색 적용)
    local targetUIBaseColor = syncColor or Settings.MusicVisualizerSetting.leftBars[1].BackgroundColor3

    -- 브라켓 투명도 제어
    for _, child in ipairs(timelineBox:GetChildren()) do
        if child:IsA("Frame") and child.ZIndex == 1 then -- Brackets are added locally
            child.BackgroundTransparency = 0.4 + (0.6 * invM)
            local h = child:FindFirstChildOfClass("Frame")
            if h then
                h.BackgroundTransparency = child.BackgroundTransparency
                for _, f in ipairs(child:GetChildren()) do
                    if f:IsA("Frame") then f.BackgroundTransparency = child.BackgroundTransparency end
                end
            end
        end
    end

    -- 타임라인 바 위치 (제자리에서 나타나도록 오프셋 제거)
    timelineBox.Position = UDim2.new(0.5, swayX + timelineShakeX, 0.83, swayY + timelineShakeY)

    -- [NEW] 달 오브젝트 위치/크기 업데이트 (진동 1.5배 약하게, 펄스 동기화)
    if moonFrame then
        moonFrame.ImageTransparency = 0.4 + (0.6 * invM)

        -- [MODIFIED] 달 색상 동기화 (파티클 색상 및 사용자 선택 색상 적용)
        local colorName = Settings.MusicVisualizerSetting and Settings.MusicVisualizerSetting.color or "하얀색"
        local selectedColor = getVisualizerColor(colorName)
        local baseMoonColor = syncColor or selectedColor

        -- 사각형 스트로크 투명도 및 색상 제어
        if bigSquare:FindFirstChildOfClass("UIStroke") then
            bigSquare:FindFirstChildOfClass("UIStroke").Transparency = 0.2 + (0.8 * invM)
            bigSquare:FindFirstChildOfClass("UIStroke").Color = baseMoonColor
        end
        if smallSquare:FindFirstChildOfClass("UIStroke") then
            local smallColor = Color3.new(0, 0, 0)
            if Settings.MusicVisualizerSetting and Settings.MusicVisualizerSetting.baseColorType == "흰색" then
                smallColor = Color3.new(1, 1, 1)
            end
            smallSquare:FindFirstChildOfClass("UIStroke").Transparency = 0.2 + (0.8 * invM)
            smallSquare:FindFirstChildOfClass("UIStroke").Color = syncColor or smallColor
        end

        local moonShakeX = timelineShakeX / 1.5
        local moonShakeY = timelineShakeY / 1.5
        -- 타임라인 기준 정중앙 정렬을 해제하고 시각적으로 더 높이 띄웁니다. (Y = 0.65)
        local moonY = 0.73
        moonFrame.Position = UDim2.new(0.5, swayX + moonShakeX, moonY, swayY + moonShakeY)

        if sound and sound.IsPlaying then
            local loudness = sound.PlaybackLoudness or 0
            local pulseNormalized = math.clamp(loudness / 500, 0, 1)
            local moonSizeScale = (1 + (pulseNormalized * 0.08)) * m3
            moonFrame.Size = UDim2.new(0.24 * moonSizeScale, 0, 0.24 * moonSizeScale, 0)

            -- [MODIFIED] 달 색상 (소리 크기에 비례하여 밝아짐, 파티클 색상 반영)
            local brightness = math.clamp(pulseNormalized * 0.8, 0.1, 1)
            moonFrame.ImageColor3 = baseMoonColor:Lerp(Color3.new(0, 0, 0), 1 - brightness)

            -- [NEW] 사각형 회전 (맥스 스피드 7배 상향)
            bigSquare.Rotation = (Settings.MusicVisualizerSetting.VisualizerTime * 245) % 360
            smallSquare.Rotation = -(Settings.MusicVisualizerSetting.VisualizerTime * 595) % 360

            -- [NEW] 사각형 동적 크기 (소리가 클수록 커짐, 최대 2.5배)
            local sqScale = 1 + (pulseNormalized * 1.5)
            bigSquare.Size = UDim2.new(bigSquareBase * sqScale * m3, 0, bigSquareBase * sqScale * m3, 0)
            smallSquare.Size = UDim2.new(smallSquareBase * sqScale * m3, 0, smallSquareBase * sqScale * m3, 0)
        else
            moonFrame.Size = UDim2.new(0.24 * m3, 0, 0.24 * m3, 0)
            -- [MODIFIED] 무음 시 달 색상 (어둡게 유지)
            moonFrame.ImageColor3 = baseMoonColor:Lerp(Color3.new(0, 0, 0), 0.9)

            bigSquare.Rotation = (Settings.MusicVisualizerSetting.VisualizerTime * 105) % 360 -- 기본 속도 (7배)
            smallSquare.Rotation = -(Settings.MusicVisualizerSetting.VisualizerTime * 210) % 360
            bigSquare.Size = UDim2.new(bigSquareBase * m3, 0, bigSquareBase * m3, 0)
            smallSquare.Size = UDim2.new(smallSquareBase * m3, 0, smallSquareBase * m3, 0)
        end
    end


    -- [NEW] 소리 크기에 따른 타임라인 크기 동적 스케일링 (Pulse Effect)
    -- normalized 변수가 아래에서 선언되므로, 여기서 직접 참조하거나 아래에서 처리
    if sound and sound.IsPlaying then
        local loudness = sound.PlaybackLoudness or 0
        local pulseNormalized = math.clamp(loudness / 500, 0, 1)
        local sizeScale = (1 + (pulseNormalized * 0.12)) * m3
        timelineBox.Size = UDim2.new(0.36 * sizeScale, 0, 0.013 * sizeScale, 0)
    else
        timelineBox.Size = UDim2.new(0.36 * m3, 0, 0.013 * m3, 0)
    end

    if motion > 0.001 then
        Settings.MusicVisualizerSetting.Gui.Enabled = true
        if sound and sound.IsPlaying then
            -- [NEW] 음악 제목 업데이트
            musicTitle.Text = FormatMusicTitle(sound.Name)

            -- 드래그 중이 아닐 때만 사운드 진행도에 따라 타임라인 업데이트
            if not Settings.MusicVisualizerSetting.isDraggingTimeline then
                local progress = math.clamp(sound.TimePosition / sound.TimeLength, 0, 1)
                timelineProgress.Size = UDim2.new(progress, 0, 1, 0)
            end

            local loudness = sound.PlaybackLoudness or 0
            local normalized = math.clamp(loudness / 500, 0.05, 1)

            -- [RESTORED] 비주얼라이저 흐름 속도는 원래대로 복구 (0.5 ~ 3.0)
            local speedMultiplier = 0.5 + (normalized * 2.5)
            Settings.MusicVisualizerSetting.VisualizerTime = Settings.MusicVisualizerSetting.VisualizerTime +
                (dt * speedMultiplier)

            for i = 1, numBars do
                local factor = (i - 1) / (numBars - 1)
                local wave = math.sin((Settings.MusicVisualizerSetting.VisualizerTime * 15) - (i * 0.3)) * 0.05

                -- [RESTORED] 컴프레서 제거 및 고정 고감도(1.35x) 복구
                local targetScale = math.clamp(normalized * 1.35 * (0.55 - factor * 0.25) + wave, 0.01, 1.35)

                local curL = Settings.MusicVisualizerSetting.leftBars[i].Size.X.Scale
                -- m3를 직접 곱하여 retraction을 MotionAlpha와 완벽히 동기화
                local newL = curL + (targetScale * m3 - curL) * 0.25
                Settings.MusicVisualizerSetting.leftBars[i].Size = UDim2.new(newL, 0,
                    Settings.MusicVisualizerSetting.leftBars[i].Size.Y.Scale, 0)

                local curR = Settings.MusicVisualizerSetting.rightBars[i].Size.X.Scale
                local newR = curR + (targetScale * m3 - curR) * 0.25
                Settings.MusicVisualizerSetting.rightBars[i].Size = UDim2.new(newR, 0,
                    Settings.MusicVisualizerSetting.rightBars[i].Size.Y.Scale, 0)

                -- [MODIFIED] 색상 설정 및 흑백 설정 기반 그라데이션 보정
                local cosWave = math.cos(Settings.MusicVisualizerSetting.VisualizerTime * 3 - (i / numBars) * 6.25)
                local t = math.clamp(0.4 + 0.7 * cosWave, 0, 1)

                local maxColor
                if syncColor then
                    maxColor = syncColor
                else
                    local colorName = Settings.MusicVisualizerSetting and Settings.MusicVisualizerSetting.color or "하얀색"
                    maxColor = getVisualizerColor(colorName)
                end

                local minColor = Color3.new(0, 0, 0)
                if Settings.MusicVisualizerSetting and Settings.MusicVisualizerSetting.baseColorType == "흰색" then
                    minColor = Color3.new(1, 1, 1)
                end

                local targetColor = minColor:Lerp(maxColor, t)

                Settings.MusicVisualizerSetting.leftBars[i].BackgroundColor3 = targetColor
                Settings.MusicVisualizerSetting.rightBars[i].BackgroundColor3 = targetColor

                -- 바 투명도 제어 (기본 0.75)
                Settings.MusicVisualizerSetting.leftBars[i].BackgroundTransparency = 0.75 + (0.25 * invM)
                Settings.MusicVisualizerSetting.rightBars[i].BackgroundTransparency = 0.75 + (0.25 * invM)
            end
            -- 타임라인 색상도 일관성 있게 흑백으로 공유
            timelineProgress.BackgroundColor3 = Settings.MusicVisualizerSetting.leftBars[1].BackgroundColor3

            -- [NEW] 파티클 스폰 로직 (프레임 단위 스폰)
            local spawnCount = math.floor(normalized * 2) -- 최대 개수 절반
            if math.random() < normalized then
                spawnCount = math.max(1, spawnCount)
            else
                spawnCount = 0
            end

            for pIdx = 1, spawnCount do
                local pSide = math.random() > 0.5 and "Left" or "Right"

                local pObj = Instance.new("Frame")
                pObj.BackgroundTransparency = 0
                pObj.Rotation = math.random(0, 90) -- 정사각형이거나 마름모
                pObj.BorderSizePixel = 0

                -- 색상 결정 (색1 ~ 색2 사이 랜덤)
                local pMaxColor
                if syncColor then
                    pMaxColor = syncColor
                else
                    local colorName = Settings.MusicVisualizerSetting and Settings.MusicVisualizerSetting.color or "하얀색"
                    pMaxColor = getVisualizerColor(colorName)
                end
                local pMinColor = Color3.new(0, 0, 0)
                if Settings.MusicVisualizerSetting and Settings.MusicVisualizerSetting.baseColorType == "흰색" then
                    pMinColor = Color3.new(1, 1, 1)
                end
                pObj.BackgroundColor3 = pMinColor:Lerp(pMaxColor, math.random())

                local baseSizeRnd = math.random(8, 17) * (0.2 + normalized * 1) -- 기본 크기 2배, 대비 증가
                pObj.Size = UDim2.new(0, baseSizeRnd, 0, baseSizeRnd)
                pObj.AnchorPoint = Vector2.new(0.5, 0.5)

                local startY = math.random(10, 90) / 100
                local startX = pSide == "Left" and -0.05 or 1.05
                pObj.Position = UDim2.new(startX, 0, startY, 0)
                pObj.Parent = Settings.MusicVisualizerSetting.Gui

                table.insert(Settings.MusicVisualizerSetting.Particles, {
                    Obj = pObj,
                    StartX = startX,
                    TargetX = pSide == "Left" and (0.06 + math.random() * 0.14) or (0.94 - math.random() * 0.14), -- 이동거리 1.5배 감소
                    StartY = startY,
                    TargetY = startY + (math.random() - 0.5) * 0.3,
                    Progress = 0,
                    Duration = 1.5 + math.random() * 2.5,
                    RotationSpeed = math.random(-3, 3),
                    BaseSize = baseSizeRnd
                })
            end
        else
            -- 사운드가 없더라도 motion(m3)이 살아있으면 바를 MotionAlpha 속도에 맞춰 줄여줌
            for i = 1, numBars do
                local curL = Settings.MusicVisualizerSetting.leftBars[i].Size.X.Scale
                local newL = curL + (0 - curL) * 0.25
                Settings.MusicVisualizerSetting.leftBars[i].Size = UDim2.new(newL, 0,
                    Settings.MusicVisualizerSetting.leftBars[i].Size.Y.Scale, 0)

                local curR = Settings.MusicVisualizerSetting.rightBars[i].Size.X.Scale
                local newR = curR + (0 - curR) * 0.25
                Settings.MusicVisualizerSetting.rightBars[i].Size = UDim2.new(newR, 0,
                    Settings.MusicVisualizerSetting.rightBars[i].Size.Y.Scale, 0)

                Settings.MusicVisualizerSetting.leftBars[i].BackgroundTransparency = 0.75 + (0.25 * invM)
                Settings.MusicVisualizerSetting.rightBars[i].BackgroundTransparency = 0.75 + (0.25 * invM)
            end
        end

        -- [NEW] 파티클 업데이트 로직 (easeOutCubic 적용)
        local curLoudness = (sound and sound.IsPlaying) and (sound.PlaybackLoudness or 0) or 0
        local curNorm = math.clamp(curLoudness / 500, 0.05, 1)
        local curSpeedMult = (sound and sound.IsPlaying) and (0.5 + (curNorm * 9)) or 1

        local aliveParticles = {}
        for _, p in ipairs(Settings.MusicVisualizerSetting.Particles or {}) do
            if p.Obj and p.Obj.Parent then
                -- dt와 음악 기반 배율에 따라 Progress 증가 (음악이 빠를/클수록 빨리 진행)
                p.Progress = p.Progress + (dt / p.Duration) * curSpeedMult

                if p.Progress >= 1 then
                    p.Obj:Destroy()
                else
                    -- easeOutCubic: 1 - (1 - t)^3
                    local easeVal = 1 - math.pow(1 - p.Progress, 3)

                    local currentX = p.StartX + (p.TargetX - p.StartX) * easeVal
                    local currentY = p.StartY + (p.TargetY - p.StartY) * easeVal

                    p.Obj.Position = UDim2.new(currentX, 0, currentY, 0)
                    p.Obj.Rotation = p.Obj.Rotation + p.RotationSpeed

                    -- 동적 크기 조절 (최대 크기는 BaseSize 유지, 소리가 작아지면 0.4배까지 축소)
                    local dynSize = p.BaseSize * (0.4 + curNorm * 0.6)
                    p.Obj.Size = UDim2.new(0, dynSize, 0, dynSize)

                    -- Progress가 진행될수록 투명해짐 (0 -> 1)
                    local pTrans = p.Progress
                    pTrans = 1 - ((1 - pTrans) * m3) -- 전체 UI 투명도(m3)와 결합
                    pTrans = math.clamp(pTrans, 0, 1)

                    p.Obj.BackgroundTransparency = pTrans

                    table.insert(aliveParticles, p)
                end
            end
        end
        Settings.MusicVisualizerSetting.Particles = aliveParticles
    else
        Settings.MusicVisualizerSetting.Gui.Enabled = false
    end
end)

