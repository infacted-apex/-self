    if UIElements.aimIndicator then
        UIElements.aimIndicator.Visible = Settings.Aim.enabled
        if Settings.Aim.enabled then
            if not wasAimEnabled then
                CreateAimRipple(false) -- 켤 때 큰 파동
                lastSmallRippleTime = os.clock()
            elseif os.clock() - lastSmallRippleTime >= 1 then
                CreateAimRipple(true) -- 1초마다 작은 파동
                lastSmallRippleTime = os.clock()
            end
        end
        wasAimEnabled = Settings.Aim.enabled
    end

