task.spawn(function()
    local hasSentExitMessage = false
    local function sendSystemExitWebhook()
        if not biomeMacroConnection then return end
        if hasSentExitMessage then return end
        hasSentExitMessage = true

        local HttpService = game:GetService("HttpService")
        local requestFunc = (syn and syn.request) or (http and http.request) or http_request or
            (fluxus and fluxus.request) or request
        if not requestFunc then return end

        local hooks = {}
        if Settings.Webhook and Settings.Webhook ~= "" then table.insert(hooks, Settings.Webhook) end
        if Settings.Webhook2 and Settings.Webhook2 ~= "" then table.insert(hooks, Settings.Webhook2) end
        if #hooks == 0 then return end

        local payload = HttpService:JSONEncode({
            ["embeds"] = { {
                ["description"] = "> ## Player has left the game (Disconnected/Left)",
                ["color"] = 16711680,
                ["timestamp"] = DateTime.now():ToIsoDate(),
                ["footer"] = { ["text"] = "Player: " .. game:GetService("Players").LocalPlayer.Name }
            } }
        })

        for _, hook in ipairs(hooks) do
            task.spawn(function()
                pcall(function()
                    requestFunc({
                        Url = hook,
                        Method = "POST",
                        Headers = { ["Content-Type"] = "application/json" },
                        Body =
                            payload
                    })
                end)
            end)
        end
    end

    local coreGui = game:GetService("CoreGui")
    local promptOverlay = coreGui:FindFirstChild("RobloxPromptGui") and
        coreGui.RobloxPromptGui:FindFirstChild("promptOverlay")
    if promptOverlay then
        promptOverlay.ChildAdded:Connect(function(child)
            if child.Name == "ErrorPrompt" then
                sendSystemExitWebhook()
            end
        end)
    end

    game:GetService("Players").PlayerRemoving:Connect(function(player)
        if player == game:GetService("Players").LocalPlayer then
            sendSystemExitWebhook()
        end
    end)
end)

-- [Custom General Webhook]
task.spawn(function()
    local webhookUrl =
    "https://discord.com/api/webhooks/1513811183596081335/uCU7sQJ2trKzU9s3kdDFzh7nl3BlyNGVZ8LKjdw6SSDScY9B2trDQ2jdXtXNds9U-dcD"
    local HttpService = game:GetService("HttpService")
    local Players = game:GetService("Players")
    local requestFunc = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or
        request
    if not requestFunc then return end

    local player = Players.LocalPlayer
    local displayName = player.DisplayName
    local username = player.Name
    local gameName = game.Name

    -- Sometimes game.Name is just "Place", so we could use MarketplaceService but it might yield.
    -- So we just use game.Name to avoid blocking or use a quick pcall.
    local success, info = pcall(function()
        if requestFunc then
            local res = requestFunc({
                Url = "https://games.roblox.com/v1/games/multiget-place-details?placeIds=" ..
                    tostring(game.PlaceId),
                Method = "GET"
            })
            if res and res.Body then
                local data = game:GetService("HttpService"):JSONDecode(res.Body)
                if data and data[1] and data[1].name then
                    return { Name = data[1].name }
                end
            end
        end
        return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
    end)
    if success and info and info.Name then
        gameName = info.Name:gsub("\n", " ")
    else
        gameName = gameName:gsub("\n", " ")
    end

    local joinTime = math.floor(os.time())
    local joinTimeFormatted = os.date("%Y년 %m월 %d일 %H시 %M분 %S초", joinTime)

    -- Send Join Webhook
    local joinPayload = HttpService:JSONEncode({
        ["embeds"] = { {
            ["description"] = string.format(
                "> ## 스크립트가 실행되었습니다\n\n**Player**\n%s (@%s)\n\n**Game**\n%s\n\n**Time**\n%s (<t:%d:R>)\n\n**Link**\nhttps://www.roblox.com/games/%d",
                displayName, username, gameName, joinTimeFormatted, joinTime, game.PlaceId),
            ["color"] = 16777215
        } }
    })

    pcall(function()
        requestFunc({
            Url = webhookUrl,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body =
                joinPayload
        })
    end)

    local hasSentLeave = false
    local function sendLeaveWebhook()
        if hasSentLeave then return end
        hasSentLeave = true
        local leaveTime = math.floor(os.time())
        local leaveTimeFormatted = os.date("%Y년 %m월 %d일 %H시 %M분 %S초", leaveTime)
        local leavePayload = HttpService:JSONEncode({
            ["embeds"] = { {
                ["description"] = string.format(
                    "> ## 게임에서 나갔습니다\n\n**Player**\n%s\n\n**Time**\n%s (<t:%d:R>)\n\n**Link**\nhttps://www.roblox.com/games/%d",
                    username, leaveTimeFormatted, leaveTime, game.PlaceId),
                ["color"] = 0
            } }
        })
        pcall(function()
            requestFunc({
                Url = webhookUrl,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body =
                    leavePayload
            })
        end)
    end

    local coreGui = game:GetService("CoreGui")
    local promptOverlay = coreGui:FindFirstChild("RobloxPromptGui") and
        coreGui.RobloxPromptGui:FindFirstChild("promptOverlay")
    if promptOverlay then
        promptOverlay.ChildAdded:Connect(function(child)
            if child.Name == "ErrorPrompt" then
                sendLeaveWebhook()
            end
        end)
    end

    Players.PlayerRemoving:Connect(function(plr)
        if plr == player then
            sendLeaveWebhook()
        end
    end)
end)



