function AntiVoidModule.start()
    AntiVoidModule.stop()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end

    Settings.AntiVoid.isFollowing = true
    Settings.AntiVoid.fixedY = hrp.Position.Y - 18

    Settings.AntiVoid.currentPart = Instance.new("Part")
    Settings.AntiVoid.currentPart.Name = "TallFollowPart"
    Settings.AntiVoid.currentPart.Size = Vector3.new(10, 30, 10)
    Settings.AntiVoid.currentPart.Anchored = true
    Settings.AntiVoid.currentPart.CanCollide = true
    Settings.AntiVoid.currentPart.Transparency = 0.9
    Settings.AntiVoid.currentPart.Material = Enum.Material.Glass
    Settings.AntiVoid.currentPart.Parent = workspace

    Settings.AntiVoid.connection = Services.RunService.PostSimulation:Connect(function()
        if Settings.AntiVoid.currentPart and char:FindFirstChild("HumanoidRootPart") then
            local rootPos = char.HumanoidRootPart.Position
            if Settings.AntiVoid.smartMode then
                local function getFloorRay(origin, maxDist)
                    local rayParams = RaycastParams.new()
                    rayParams.FilterType = Enum.RaycastFilterType.Exclude
                    local localExclude = { char, Settings.AntiVoid.currentPart }

                    for i = 1, 15 do
                        rayParams.FilterDescendantsInstances = localExclude
                        local rayResult = workspace:Raycast(origin, Vector3.new(0, -maxDist, 0), rayParams)
                        if rayResult then
                            -- 충돌이 불가능한 파트(공허 파트 등)와 투명도가 1인 파트는 무시
                            if rayResult.Instance.CanCollide and rayResult.Instance.Transparency < 1 then
                                return rayResult
                            else
                                table.insert(localExclude, rayResult.Instance)
                            end
                        else
                            return nil
                        end
                    end
                    return nil
                end

                -- 진짜 바닥이 발 아래에 있는지 확인 (경사로 등에서 걷고 있는지 파악)
                local directFloor = getFloorRay(rootPos + Vector3.new(0, 2, 0), 15)

                if directFloor then
                    -- 바닥 위에 있을 때는 파트 모서리가 튀어나오지 않게 바닥 아래로 숨김
                    Settings.AntiVoid.fixedY = directFloor.Position.Y - 18
                else
                    -- 허공에 완전히 떠있을 때만 주변 바닥을 감지하여 오르내림 적용
                    local cf = char.HumanoidRootPart.CFrame
                    local offsets = {
                        Vector3.new(0, 0, 0),
                        cf.LookVector * 4,  -- 앞쪽
                        cf.LookVector * -2, -- 뒤쪽
                        cf.RightVector * 3, -- 오른쪽
                        cf.RightVector * -3 -- 왼쪽
                    }

                    local highestY = -math.huge
                    local found = false

                    for _, offset in ipairs(offsets) do
                        -- 거리 제한을 없앰 (매우 깊게 감지)
                        local origin = rootPos + Vector3.new(offset.X, 2, offset.Z)
                        local hit = getFloorRay(origin, 5000)
                        if hit and hit.Position.Y > highestY then
                            highestY = hit.Position.Y
                            found = true
                        end
                    end

                    if found then
                        -- 가장 높은 바닥의 Y좌표에 완벽히 맞춤
                        Settings.AntiVoid.fixedY = highestY - 15
                    end
                end
            end
            Settings.AntiVoid.currentPart.Position = Vector3.new(rootPos.X, Settings.AntiVoid.fixedY, rootPos.Z)
        end
    end)
end

