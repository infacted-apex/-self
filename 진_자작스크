local function CreateAimRipple(isSmall)
    if not UIElements.aimIndicator then return end
    local pulse = Instance.new("Frame")
    pulse.Name = "AimPulse"
    pulse.AnchorPoint = Vector2.new(0.5, 0.5)
    pulse.Position = UDim2.new(0.5, 0, 0.5, 0)
    pulse.Size = UDim2.new(1, 0, 1, 0)
    pulse.BackgroundColor3 = Color3.fromRGB(50, 150, 255)
    pulse.BackgroundTransparency = 0 -- 완전히 불투명하게 시작
    pulse.ZIndex = 0

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = pulse

    pulse.Parent = UIElements.aimIndicator

    local targetSize = isSmall and UDim2.new(2, 0, 2, 0) or UDim2.new(3, 0, 3, 0)
    local duration = isSmall and 0.4 or 0.6
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local goal = {
        Size = targetSize,
        BackgroundTransparency = 1
    }
    local tween = Services.TweenService:Create(pulse, tweenInfo, goal)
    tween:Play()
    Services.Debris:AddItem(pulse, duration)
end

