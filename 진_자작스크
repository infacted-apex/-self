                    end

                    local dist = (currentHrp.Position - targetPosition).Magnitude

                    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
                    local pGuiPrompts = pGui and pGui:FindFirstChild("PromptsGui")
                    local wPrompt = pGuiPrompts and pGuiPrompts:FindFirstChild("WaterSourcePrompt")
                    local pFrame = wPrompt and wPrompt:FindFirstChild("Frame")
                    local initialSize = pFrame and pFrame.Size

                    local promptChanged = false

                    hum:MoveTo(targetPosition)

                    local timeLimit = 15 -- 15초 제한
                    local startTime = tick()

                    while tick() - startTime < timeLimit do
                        if not currentHrp.Parent or not survivalEnabled or hum.Health <= 0 then
                            break
                        end

                        -- 프롬프트 확인
                        local dynamicGui = LocalPlayer:FindFirstChild("PlayerGui")
                        local dynamicPrompts = dynamicGui and dynamicGui:FindFirstChild("PromptsGui")
                        local dynamicPrompt = dynamicPrompts and dynamicPrompts:FindFirstChild("WaterSourcePrompt")
                        local currentFrame = dynamicPrompt and dynamicPrompt:FindFirstChild("Frame")

                        if currentFrame then
                            if initialSize and currentFrame.Size ~= initialSize then
                                promptChanged = true
                                break
                            elseif (not initialSize) and currentFrame.Size.X.Scale > 0 then
                                promptChanged = true
                                break
                            end
                        end

                        if (currentHrp.Position - targetPosition).Magnitude < 3 then
                            -- 목표에 도달했으나 프롬프트가 안 뜬 경우 조금 더 대기
                            for _ = 1, 10 do
                                task.wait(0.1)
                                dynamicGui = LocalPlayer:FindFirstChild("PlayerGui")
                                dynamicPrompts = dynamicGui and dynamicGui:FindFirstChild("PromptsGui")
                                dynamicPrompt = dynamicPrompts and dynamicPrompts:FindFirstChild("WaterSourcePrompt")
                                currentFrame = dynamicPrompt and dynamicPrompt:FindFirstChild("Frame")
                                if currentFrame then
                                    if initialSize and currentFrame.Size ~= initialSize then
                                        promptChanged = true
                                        break
                                    elseif (not initialSize) and currentFrame.Size.X.Scale > 0 then
                                        promptChanged = true
                                        break
                                    end
                                end
                            end
                            break
                        end

                        task.wait(0.1)
                    end

                    if currentHrp.Parent then
                        hum:MoveTo(currentHrp.Position) -- 이동 멈춤
                    end

                    return promptChanged
                end

                local function grabFood()
                    local itemsFolder = workspace:FindFirstChild("Items")
                    if not itemsFolder then
                        warn("Items 폴더(또는 모델)를 찾을 수 없습니다.")
                        return false
                    end

                    local char = LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if not hrp then return false end

                    local closestItem = nil
                    local minDistance = math.huge
                    for _, item in ipairs(itemsFolder:GetChildren()) do
                        if item:IsA("Model") and item.Name == "Worms" and not foodBlacklist[item] then
                            local itemPivot = item:GetPivot()
                            local dist = (hrp.Position - itemPivot.Position).Magnitude
                            if dist < minDistance then
                                minDistance = dist
                                closestItem = item
                            end
                        end
                    end

                    local originalCFrame = hrp.CFrame
                    if not closestItem then
                        warn("맵에 Worms가 존재하지 않습니다. 임의의 섬으로 텔레포트합니다.")
                        local islands = workspace:FindFirstChild("Islands")
                        if islands then
                            local validIslands = {}
                            for _, obj in ipairs(islands:GetChildren()) do
                                if obj:IsA("Model") and string.find(string.lower(obj.Name), "island") then
                                    local islandPos = obj:GetPivot().Position
                                    if obj:GetPivot() == CFrame.new() then
                                        local baseParts = obj:FindFirstChild("BaseParts")
                                        if baseParts then
                                            for _, v in ipairs(baseParts:GetDescendants()) do
                                                if (v:IsA("Model") or v:IsA("BasePart")) and v:GetPivot() ~= CFrame.new() then
                                                    islandPos = v:GetPivot().Position
                                                    break
                                                end
                                            end
                                        end
                                    end
                                    local dist = (hrp.Position - islandPos).Magnitude
                                    table.insert(validIslands, { island = obj, dist = dist })
                                end
                            end

                            if #validIslands > 0 then
                                table.sort(validIslands, function(a, b) return a.dist < b.dist end)

                                local topIslands = {}
                                for i = 1, math.min(10, #validIslands) do
                                    table.insert(topIslands, validIslands[i].island)
                                end

                                local currentHrp = char:FindFirstChild("HumanoidRootPart")
                                if currentHrp then
                                    bypassTeleport(CFrame.new(0, currentHrp.Position.Y, 0))
                                    task.wait(0.25)
                                end

                                for _, targetIsland in ipairs(topIslands) do
                                    if not survivalEnabled or LocalPlayer.Character ~= char then break end
                                    local baseParts = targetIsland:FindFirstChild("BaseParts")
                                    if baseParts then
                                        local models = {}
                                        for _, v in ipairs(baseParts:GetDescendants()) do
                                            if v:IsA("Model") and v:GetPivot() ~= CFrame.new() then
                                                table.insert(models, v)
                                            end
                                        end
                                        if #models > 0 then
                                            local randomModel = models[math.random(1, #models)]
                                            bypassTeleport(randomModel:GetPivot() + Vector3.new(0, 3, 0))
                                            task.wait(0.25)
                                        end
                                    end
                                end

                                if survivalEnabled and LocalPlayer.Character == char then
                                    local endHrp = char:FindFirstChild("HumanoidRootPart")
                                    if endHrp then
                                        bypassTeleport(CFrame.new(0, endHrp.Position.Y, 0))
                                        task.wait(0.25)
                                    end
                                    bypassTeleport(originalCFrame + Vector3.new(0, 3, 0))
                                end
                                task.wait(0.25)
                            end
                        end
                        return false
                    end

                    bypassTeleport(closestItem:GetPivot())
                    task.wait(0.25)

                    local disappeared = false
                    for i = 1, 4 do
                        if not survivalEnabled then break end
                        vim:SendKeyEvent(true, Enum.KeyCode.X, false, game)
                        task.wait(0.05)
                        vim:SendKeyEvent(false, Enum.KeyCode.X, false, game)
                        task.wait(0.2)
                        if not closestItem.Parent then
                            disappeared = true
                            break
                        end
                    end

                    if not disappeared then
                        foodBlacklist[closestItem] = true
                    end

                    task.wait(0.1)
                    if LocalPlayer.Character == char and survivalEnabled then
                        bypassTeleport(originalCFrame + Vector3.new(0, 3, 0))
                    end

                    task.wait(0.25)
                    if survivalEnabled then
                        vim:SendKeyEvent(true, Enum.KeyCode.X, false, game)
                        task.wait(0.05)
                        vim:SendKeyEvent(false, Enum.KeyCode.X, false, game)
                    end

                    return true
                end

                local function findMyNest()
                    local structures = workspace:FindFirstChild("Structures")
                    if not structures then return nil end

                    for _, item in ipairs(structures:GetChildren()) do
                        if item:IsA("Model") and item.Name == "Nest" then
                            local isOwner = false
                            local attr = item:GetAttribute("Owner")
                            if attr then
                                if typeof(attr) == "Instance" and attr:IsA("Player") then
                                    isOwner = (attr == LocalPlayer)
                                elseif typeof(attr) == "string" then
                                    isOwner = (attr == LocalPlayer.Name)
                                end
                            end
                            if not isOwner then
                                local ownerObj = item:FindFirstChild("Owner")
                                if ownerObj then
                                    if ownerObj:IsA("StringValue") then
                                        isOwner = (ownerObj.Value == LocalPlayer.Name)
                                    elseif ownerObj:IsA("ObjectValue") then
                                        isOwner = (ownerObj.Value == LocalPlayer)
                                    end
                                end
                            end
                            if isOwner then
                                return item
                            end
                        end
                    end
                    return nil
                end

                local function getVal(obj, valName)
                    local attr = obj:GetAttribute(valName)
                    if attr ~= nil then return attr end
                    local child = obj:FindFirstChild(valName)
                    if child and (child:IsA("IntValue") or child:IsA("NumberValue")) then
                        return child.Value
                    end
                    return nil
                end

                local function checkBabyHunger()
                    local myNest = findMyNest()
                    if not myNest then return false end
                    local primaryPart = myNest:FindFirstChild("PrimaryPart") or myNest.PrimaryPart
                    if not primaryPart then return false end
                    for i = 1, 3 do
                        local slot = primaryPart:FindFirstChild("Slot" .. i)
                        if slot then
                            local age = getVal(slot, "Age") or 0
                            local hunger = getVal(slot, "Hunger") or 100
                            if age > 0 and hunger <= 25 then
                                return true
                            end
                        end
                    end
                    return false
                end

                local function setMechanismState(newState)
                    if survivalMechanism == newState then return end

                    if survivalMechanism == "Sleep" and survivalSleeping then
                        pressKey(Enum.KeyCode.Z)
                        survivalSleeping = false
                        task.wait(1)
                    elseif survivalMechanism ~= nil then
                        task.wait(1)
                    end

                    survivalMechanism = newState

                    if newState ~= nil then
                        task.wait(1)
                    end
                end

                local initialNest = findMyNest()
                if initialNest then
                    bypassTeleport(initialNest:GetPivot())
                end

                local sleepBugCount = 0
                local lastInsomniaVal = 0

                while survivalEnabled do
                    task.wait(0.1)

                    local hungerVal = getHunger()
                    local thirstVal = getThirst()
                    local insomniaVal = getInsomnia()

                    -- 0. [새끼 관리] 매커니즘 (우선순위 0 - 수면 중단 가능)
                    if babyManagementEnabled and checkBabyHunger() then
                        setMechanismState("BabyManagement")
                        if not survivalEnabled then break end

                        local myNest = findMyNest()
                        if myNest then
                            local nestPivot = myNest:GetPivot()
                            -- X-0.7로 순간이동
                            local targetCFrame = nestPivot * CFrame.new(-0.7, 0, 0)
                            bypassTeleport(targetCFrame)
                            task.wait(0.25)

                            -- Nest 쪽을 바라보게 조정
                            local char = LocalPlayer.Character
                            local currentHrp = char and char:FindFirstChild("HumanoidRootPart")
                            if currentHrp then
                                currentHrp.CFrame = CFrame.lookAt(currentHrp.Position, nestPivot.Position)
                            end
                            task.wait(0.25)

                            -- Worms 하나 가져오기
                            local success = grabFood()
                            task.wait(0.5)

                            -- 먹이 주기 완료 후 Nest로 완벽히 복귀
                            bypassTeleport(nestPivot)
                            task.wait(0.25)
                        end

                        setMechanismState(nil)

                        -- 1. [먹기] 매커니즘 (우선순위 1)
                    elseif hungerVal < 0.5 then
                        setMechanismState("Eat")
                        if not survivalEnabled then break end

                        local originalCFrame = LocalPlayer.Character and
                            LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and
                            LocalPlayer.Character.HumanoidRootPart.CFrame

                        local myNest = findMyNest()
                        if myNest then
                            bypassTeleport(myNest:GetPivot())
                            task.wait(0.5)
                        end

                        while survivalEnabled and getHunger() <= 0.94 do
                            local success = grabFood()
                            if not success then
                                task.wait(1)
                                break
                            end
                            task.wait(0.25)
                            if survivalEnabled then
                                pressKey(Enum.KeyCode.V)
                            end
                            task.wait(0.25)
                        end

                        if LocalPlayer.Character and originalCFrame and survivalEnabled then
                            bypassTeleport(originalCFrame + Vector3.new(0, 3, 0))
                        end

                        setMechanismState(nil)

                        -- 2. [갈증] 매커니즘 (우선순위 1)
                    elseif thirstVal < 0.25 then
                        setMechanismState("Thirst")
                        if not survivalEnabled then
                            break
                        end

                        local myNest = findMyNest()
                        if myNest then
                            local originalCFrame = LocalPlayer.Character and
                                LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and
                                LocalPlayer.Character.HumanoidRootPart.CFrame

                            bypassTeleport(myNest:GetPivot())
                            task.wait(0.5)

                            local closestWater = nil
                            local minWaterDist = math.huge
                            local islandsFolder = workspace:FindFirstChild("Islands") or
                                workspace:FindFirstChild("Workspace") -- 호환성을 위해 둘 다 확인
                            local hrp = LocalPlayer.Character and
                                LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            if islandsFolder and hrp then
                                for _, model in ipairs(islandsFolder:GetChildren()) do
                                    if model:IsA("Model") then
                                        local waterFolder = model:FindFirstChild("Water")
                                        if waterFolder then
                                            for _, child in ipairs(waterFolder:GetDescendants()) do
                                                if child:IsA("BasePart") and child.Name == "Water" then
                                                    local dist = (hrp.Position - child.Position).Magnitude
                                                    if dist < minWaterDist then
                                                        minWaterDist = dist
                                                        closestWater = child
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            else
                            end

                            if closestWater then
                                local promptTriggered = walkToWithPromptCheck(closestWater.Position)
                                if promptTriggered then
                                    while survivalEnabled and getThirst() <= 0.94 do
                                        pressKey(Enum.KeyCode.V)
                                        task.wait(0.1)
                                    end
                                else
                                    warn("[갈증 디버그] WaterSourcePrompt 가 전혀 변경되지 않았거나 이동 중 프롬프트를 감지하지 못했습니다.")
                                end
                            else
                            end

                            if LocalPlayer.Character and originalCFrame and survivalEnabled then
                                bypassTeleport(originalCFrame + Vector3.new(0, 3, 0))
                            end
                        else
                            warn("[갈증 디버그] 둥지를 찾을 수 없어 갈증 기능을 실행할 수 없습니다.")
                        end

                        setMechanismState(nil)

                        -- 3. [수면] 매커니즘 (우선순위 2 - 중단 가능)
                    elseif insomniaVal < 0.5 and not survivalSleeping then
                        setMechanismState("Sleep")
                        if not survivalEnabled then break end

                        local myNest = findMyNest()
                        if myNest then
                            bypassTeleport(myNest:GetPivot())
                            task.wait(1)
                            if survivalEnabled then
                                pressKey(Enum.KeyCode.Z)
                                survivalSleeping = true
                            end
                        else
                            warn("둥지를 찾을 수 없어 수면 기능 실행 불가능")
                            setMechanismState(nil)
                        end

                        -- 4. 자연 수면 완료 감시
                    elseif survivalSleeping and insomniaVal > 0.95 then
                        setMechanismState(nil)
                        sleepBugCount = 0
                    elseif survivalSleeping and sleepBugCount < 2 then
                        if lastInsomniaVal > 0 and (lastInsomniaVal - insomniaVal) >= 0.05 then
                            warn("수면 버그 감지: Nest로 텔레포트 및 Z키 재입력")
                            sleepBugCount = sleepBugCount + 1
                            local myNest = findMyNest()
                            if myNest then
                                bypassTeleport(myNest:GetPivot())
                                task.wait(1)
                                if survivalEnabled then
                                    pressKey(Enum.KeyCode.Z)
                                end
                            end
                        end
                    end

                    if survivalSleeping then
                        lastInsomniaVal = insomniaVal
                    else
                        lastInsomniaVal = 0
                        if survivalMechanism ~= "Sleep" then
                            sleepBugCount = 0
                        end
                    end

                    if babyManagementEnabled and not checkBabyHunger() and survivalMechanism == nil then
                        local myNest = findMyNest()
                        if myNest then
                            local char = LocalPlayer.Character
                            local currentHrp = char and char:FindFirstChild("HumanoidRootPart")
                            if currentHrp and (currentHrp.Position - myNest:GetPivot().Position).Magnitude > 10 then
                                bypassTeleport(myNest:GetPivot())
                            end
                        end
                    end
                end

                -- 안전 장치: 루프 종료 시 수면 중이라면 반드시 깨우기
                if survivalSleeping then
                    pressKey(Enum.KeyCode.Z)
                    survivalSleeping = false
                end
                survivalMechanism = nil
            end)
        else
            -- 생존 토글이 꺼질 때 즉시 수면 중이면 깨우기
            if survivalSleeping then
                task.spawn(function()
                    local vim = game:GetService("VirtualInputManager")
                    vim:SendKeyEvent(true, Enum.KeyCode.Z, false, game)
                    task.wait(0.05)
                    vim:SendKeyEvent(false, Enum.KeyCode.Z, false, game)
                    survivalSleeping = false
                    survivalMechanism = nil
                end)
            end
        end
    end
})

