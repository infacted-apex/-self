-- ✅ [사용자 요청] "HP를 직접 깎는 방식(Health = 0) 말고, 게임에서 직접 재설정을
-- 하는 것처럼" - LocalPlayer:LoadCharacter()는 실제 게임의 "재설정" 기능과 동일하게
-- 캐릭터를 즉시 파괴하고 새로 생성한다(죽는 애니메이션 없이 바로 리스폰). exploit
-- 환경에 따라 클라이언트에서 이 호출이 막혀있을 수 있으므로, 실패하면 기존 방식
-- (Humanoid.Health = 0)으로 자동 대체된다.
--
-- ✅ [사용자 요청] "연속 재설정 방지 로직" - 최근 3초 안에 이미 재설정을 했거나,
-- 마지막 재설정 이후로 캐릭터가 5스터드 이상 이동하지 않았으면 이번 재설정은
-- 건너뛴다. 포션 제작의 "이동 실패, 처음부터 재시도" 같은 경로가 아무 제한 없이
-- 재설정을 계속 요청할 수 있는데, 재설정을 해도 캐릭터가 제자리에서 못 벗어나는
-- 상황이면 또 재설정해봐야 의미가 없고 오히려 초당 여러 번 재설정만 남발하게 된다.
-- ResetCharacter() 하나에만 가드를 걸어서, 호출하는 12곳 전부에 자동으로 적용되게 함.
local lastResetTime = -math.huge
local lastResetPosition = nil
-- ✅ [사용자 요청] "처음 재설정을 스킵하게" - 스크립트 시작 후 맨 첫 ResetCharacter()
-- 호출은 실제로 재설정을 실행하지 않고 건너뛴다 (그 이후 호출부터 위 3초/5스터드
-- 가드가 정상적으로 적용됨).
local hasResetOnce = false

local function ResetCharacter(force)
    -- ✅ [치명적 버그 수정] "처음 매크로를 틀 때 오토 미니게임 - 재설정 후 부활 대기에서
    -- 멈춤" - 이 함수를 건너뛰는(스킵) 분기들(처음 1회, 3초 이내, 5스터드 미만 이동)이
    -- 전부 아무 값도 반환하지 않아서, 호출부는 "재설정이 실제로 일어났는지"를 전혀 알
    -- 방법이 없었다. 여러 호출부(오토 미니게임/바다 아이템 자동 수집)가 "ResetCharacter()
    -- 호출 -> CharacterAdded 이벤트 대기(최대 30초)" 패턴을 쓰는데, 실제로는 재설정이
    -- 스킵되어 캐릭터가 죽지 않았으니 CharacterAdded는 절대 발생하지 않고 매번 30초를
    -- 헛되이 기다리게 됐다(스킵되기 가장 쉬운 "맨 처음 1회"에 특히 잘 걸림). 이제 실제로
    -- 재설정을 실행했으면 true, 스킵했으면 false를 반환해서 호출부가 그에 맞게 대기
    -- 여부를 결정할 수 있게 한다.
    -- ✅ [버그 수정] "상인 자동 구매 후 재설정을 안 함" - 상인 텔레포트 후 복귀처럼
    -- "반드시 재설정해야 원래 자리로 돌아오는" 경우가 있는데, 그게 세션의 첫 재설정이면
    -- 아래 첫 1회 스킵에 걸려 상인 앞에 그대로 남아버렸다. force=true면 모든 스킵 가드를
    -- 무시하고 무조건 재설정한다.
    if force then
        hasResetOnce = true
    elseif not hasResetOnce then
        hasResetOnce = true
        return false
    end

    local now = tick()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local currentPos = hrp and hrp.Position

    if not force then
        if (now - lastResetTime) < 3 then
            return false
        end
        if lastResetPosition and currentPos and (currentPos - lastResetPosition).Magnitude < 5 then
            return false
        end
    end

    lastResetTime = now
    lastResetPosition = currentPos

    local ok = pcall(function()
        LocalPlayer:LoadCharacter()
    end)
    if not ok then
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.Health = 0
        end
    end
    return true
end

