    -- 여전히 "stats"/"alltime"으로 남아있는 상태에서, 매크로를 다시 켠 뒤 "통계 보기"를
    -- 누르면 switchToScreen("stats")가 "currentScreen == targetScreen"에 걸려 아무 것도
    -- 안 하고 조용히 return해버려서, 화면이 실제로는 잘못된 상태(상태 UI와 스탯 UI가
    -- 동시에 Visible=true)로 남아 겹쳐 보였음. 로컬 변수를 없애고 getgenv() 하나만
    -- 참조하도록 통합해서, 두 함수가 항상 같은 상태를 보게 만든다.
    local function getCurrentScreen()
        return (getgenv()._SwitchButtonState and getgenv()._SwitchButtonState.currentScreen) or "status"
    end

    local HOME_POSITION_LOCAL = UDim2.new(1, 0, 0, 0)  -- 각 화면의 "제자리" (MasterFrame 기준)
    local SLIDE_OFFSET_LOCAL = UDim2.new(1, 300, 0, 0) -- 슬라이드 애니메이션용 짧은 이동 거리

    local isTransitioning = false

    local function switchToScreen(targetScreen)
        local currentScreen = getCurrentScreen()
        if isTransitioning or currentScreen == targetScreen then return end
        isTransitioning = true

        -- ✅ [치명적 버그 수정] 캐싱된 StatusFrameInstance 대신 매번 새로 조회
        local statusUIForSwitch = LocalPlayer.PlayerGui:FindFirstChild("MacroStatusDisplay")
        local currentStatusFrame = statusUIForSwitch and statusUIForSwitch:FindFirstChild("MasterFrame")
            and statusUIForSwitch.MasterFrame:FindFirstChild("StatusFrame")

        local fromFrame = (currentScreen == "status" and currentStatusFrame)
            or (currentScreen == "stats" and StatsFrame)
            or (currentScreen == "alltime" and AllTimeFrame)
            or (currentScreen == "event" and EventStatsFrame)
            or (currentScreen == "eventalltime" and EventAllTimeStatsFrame)
        local toFrame = (targetScreen == "status" and currentStatusFrame)
            or (targetScreen == "stats" and StatsFrame)
            or (targetScreen == "alltime" and AllTimeFrame)
            or (targetScreen == "event" and EventStatsFrame)
            or (targetScreen == "eventalltime" and EventAllTimeStatsFrame)

        -- ✅ getgenv() 상태 하나만 갱신 (로컬 currentScreen은 이제 함수 진입 시점의
        -- 값만 담는 임시 변수라 재할당이 불필요함)
        if getgenv()._SwitchButtonState then getgenv()._SwitchButtonState.currentScreen = targetScreen end
        statsUIVisibleFlag = (targetScreen == "stats")
        allTimeUIVisibleFlag = (targetScreen == "alltime")
        -- ✅ [사용자 요청] 이벤트 통계 화면도 보일 때만 실시간으로 갱신
        eventStatsUIVisibleFlag = (targetScreen == "event")
        if eventStatsUIVisibleFlag then
            pcall(getgenv()._UpdateEventStatsUI)
        end
        -- ✅ [사용자 요청] "올타임은 다른 탭으로" - 이벤트 올타임 화면도 보일 때만 갱신
        eventAllTimeStatsUIVisibleFlag = (targetScreen == "eventalltime")
        if eventAllTimeStatsUIVisibleFlag then
            pcall(getgenv()._UpdateEventAllTimeStatsUI)
        end

        if fromFrame then
            -- ✅ 기존 화면이 짧게 미끄러지며 사라짐 (Out Expo)
            local exitTween = getgenv()._TweenService:Create(
                fromFrame,
                TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
                { Position = SLIDE_OFFSET_LOCAL }
            )
            exitTween:Play()
            exitTween.Completed:Connect(function()
                if fromFrame ~= toFrame then
                    fromFrame.Visible = false
                end
                fromFrame.Position = HOME_POSITION_LOCAL -- 다음에 다시 보일 때를 위해 원위치로 복구
            end)
        end

        if toFrame then
            toFrame.Position = SLIDE_OFFSET_LOCAL
            toFrame.Visible = true
            -- ✅ 새 화면이 제자리로 미끄러져 들어옴 (In-Out Expo)
            local enterTween = getgenv()._TweenService:Create(
                toFrame,
                TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.InOut),
                { Position = HOME_POSITION_LOCAL }
            )
            enterTween:Play()
            enterTween.Completed:Connect(function()
                isTransitioning = false
            end)
        else
            isTransitioning = false
        end
    end

    -- ✅ [사용자 요청] "AAA가 활성화된 상태면 색이 반전되게" - 활성화(합산 모드)일 때는
    -- 배경 검정 + 텍스트 흰색, 비활성화(원래 상태)일 때는 다른 버튼들과 동일한 배경
    -- 흰색 + 텍스트 검정으로 되돌린다.
    -- ✅ [사용자 요청] "색 반전될 때 부드럽게(0.5초)" - 즉시 바뀌던 색을 TweenService로
    -- 0.5초에 걸쳐 자연스럽게 전환한다.
    local AAAColorTweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local function updateAAAButtonColors(isActive)
        local targetBg = isActive and Color3.new(0, 0, 0) or Color3.fromRGB(255, 255, 255)
        local targetText = isActive and Color3.new(1, 1, 1) or Color3.fromRGB(0, 0, 0)
        getgenv()._TweenService:Create(AAAButton, AAAColorTweenInfo, { BackgroundColor3 = targetBg }):Play()
        getgenv()._TweenService:Create(AAAButton, AAAColorTweenInfo, { TextColor3 = targetText }):Play()
    end

    SwitchButton.MouseButton1Click:Connect(function() switchToScreen("stats") end)
    EventStatsSwitchButton.MouseButton1Click:Connect(function() switchToScreen("event") end)
    EventStatsBackButton.MouseButton1Click:Connect(function() switchToScreen("status") end)
    EventAllTimeOpenButton.MouseButton1Click:Connect(function() switchToScreen("eventalltime") end)
    EventAllTimeBackButton.MouseButton1Click:Connect(function() switchToScreen("event") end)
    StatsSwitchButton.MouseButton1Click:Connect(function() switchToScreen("status") end)
    AllTimeOpenButton.MouseButton1Click:Connect(function()
        -- ✅ [사용자 요청] "올타임" 버튼은 항상 "내 계정" 모드로 연다.
        getgenv()._AllTimeShowingAllAccounts = false
        AAAModeLabel.Visible = false
        updateAAAButtonColors(false)
        switchToScreen("alltime")
    end)
    AAAButton.MouseButton1Click:Connect(function()
        -- ✅ [사용자 요청] "다시 누르면 원래 올타임으로 돌아가게" - AAA 버튼이 토글처럼
        -- 동작한다. 이미 합산 모드라면 다시 눌렀을 때 내 계정(올타임) 모드로 되돌리고,
        -- 아니라면 합산 모드로 전환한다. 버튼 라벨 자체는 항상 "AAA"로 고정, 대신 화면
        -- 안에 "All time All Account" 표시와 버튼 색 반전으로 현재 상태를 알려준다.
        local nowActive = not getgenv()._AllTimeShowingAllAccounts
        getgenv()._AllTimeShowingAllAccounts = nowActive
        AAAModeLabel.Visible = nowActive
        updateAAAButtonColors(nowActive)
        if nowActive then
            local combined = getgenv()._GetAllAccountsCombinedStats()
            pcall(getgenv()._UpdateAllTimeStatsUI, combined, true)
        else
            pcall(getgenv()._UpdateAllTimeStatsUI)
        end
        switchToScreen("alltime")
    end)
    AllTimeSwitchButton.MouseButton1Click:Connect(function()
        -- ✅ [사용자 요청] 되돌리는 버튼("통계 보기")을 누르면 다시 "내 계정"(올타임)
        -- 모드로 리셋한다.
        getgenv()._AllTimeShowingAllAccounts = false
        AAAModeLabel.Visible = false
        updateAAAButtonColors(false)
        switchToScreen("stats")
    end)

    getgenv()._SwitchButtonState = {
        SwitchButton = SwitchButton,
        EventStatsSwitchButton = EventStatsSwitchButton,
        EventStatsBackButton = EventStatsBackButton,
        EventAllTimeOpenButton = EventAllTimeOpenButton,
        EventAllTimeBackButton = EventAllTimeBackButton,
        StatsSwitchButton = StatsSwitchButton,
        AllTimeOpenButton = AllTimeOpenButton,
        AAAButton = AAAButton,
        AllTimeSwitchButton = AllTimeSwitchButton,
        StatsFrame = StatsFrame,
        AllTimeFrame = AllTimeFrame,
        EventStatsFrame = EventStatsFrame,
        EventAllTimeStatsFrame = EventAllTimeStatsFrame,
        currentScreen = "status",
        statusButtonDivider = statusButtonDivider,
        statsButtonDivider = statsButtonDivider,
        allTimeButtonDivider = allTimeButtonDivider,
    }

    -- ✅ [사용자 요청] "처음에 뜨는 창은 무조건 메인 매크로 UI" + "매크로가 꺼지면 모든
    -- 창이 페이드아웃" - MasterFrame(CanvasGroup) 구조로 바뀌면서 이 함수가 훨씬
    -- 단순해졌다. 더 이상 Position이나 투명도를 여러 곳에서 따로 강제 동기화할 필요가
    -- 없다 - MasterFrame 하나의 GroupTransparency(FadeStatusUI가 관리)만 매크로 켜짐
    -- 여부를 따르면 전체가 자동으로 함께 나타나고 사라진다. 이 함수는 그냥 "매크로가
    -- 꺼지면 내부적으로 상태 화면으로 되돌려놓는다"는 상태 관리만 담당한다.
    getgenv()._UpdateSwitchButtonVisibility = function()
        local s = getgenv()._SwitchButtonState
        local macroOn = Settings.Sols.masterMacroEnabled == true

        -- ✅ [사용자 요청] "메인 창 말고 다른 UI를 켜고 있으면 UI가 안 뜬다" - 게임 자체가
        -- 인벤토리/상점 등 다른 UI를 열 때 HUD를 자동으로 숨기는 로직이 있다면, 그 로직이
        -- 우리 ScreenGui까지 함께 Enabled=false로 꺼버릴 수 있음. 매 틱마다 강제로 다시
        -- 켜서 게임의 숨김 로직과 무관하게 항상 보이도록 만든다.
        if getgenv()._StatusUIRef then getgenv()._StatusUIRef.Enabled = true end
        if getgenv()._StatsUIRef then getgenv()._StatsUIRef.Enabled = true end

        s.SwitchButton.Visible = macroOn
        -- ✅ [사용자 요청] Summer 이벤트 종료 - "이벤트 통계" 버튼은 항상 숨김
        s.EventStatsSwitchButton.Visible = false
        s.EventStatsBackButton.Visible = macroOn
        s.EventAllTimeOpenButton.Visible = macroOn
        s.EventAllTimeBackButton.Visible = macroOn
        s.StatsSwitchButton.Visible = macroOn
        s.AllTimeOpenButton.Visible = macroOn
        s.AAAButton.Visible = macroOn
        s.AllTimeSwitchButton.Visible = macroOn

        -- ✅ [치명적 버그 수정] 버튼 밑 구분선들도 매크로 켜짐 여부에 맞게 투명도를
        -- 관리한다 (매크로를 안 켠 상태에서도 보이던 문제의 수정 - 목표 투명도 0.9).
        local dividerTransparency = macroOn and 0.9 or 1
        s.statusButtonDivider.BackgroundTransparency = dividerTransparency
        s.statsButtonDivider.BackgroundTransparency = dividerTransparency
        s.allTimeButtonDivider.BackgroundTransparency = dividerTransparency

        if not macroOn and s.currentScreen ~= "status" then
            -- ✅ [사용자 요청] 매크로가 꺼지면 어느 화면에 있었든 조용히 상태 화면으로
            -- 되돌림 - 다음에 매크로를 다시 켜면 항상 메인 매크로 UI부터 보이게 된다.
            s.currentScreen = "status"
            statsUIVisibleFlag = false
            allTimeUIVisibleFlag = false
            eventStatsUIVisibleFlag = false
            eventAllTimeStatsUIVisibleFlag = false
            s.StatsFrame.Visible = false
            s.AllTimeFrame.Visible = false
            s.EventStatsFrame.Visible = false
            s.EventAllTimeStatsFrame.Visible = false
            -- ✅ [사용자 요청] "AAA 통계" 합산 모드 상태도 확실히 리셋 - 다음에 매크로를
            -- 다시 켰을 때 의도치 않게 AAA 모드로 남아있는 것을 방지.
            getgenv()._AllTimeShowingAllAccounts = false
            if AAAModeLabel then AAAModeLabel.Visible = false end
            if updateAAAButtonColors then updateAAAButtonColors(false) end

            local statusUI = LocalPlayer.PlayerGui:FindFirstChild("MacroStatusDisplay")
            local statusFrameForReset = statusUI and statusUI:FindFirstChild("MasterFrame")
                and statusUI.MasterFrame:FindFirstChild("StatusFrame")
            if statusFrameForReset then
                statusFrameForReset.Visible = true
            end
        end

        -- ✅ [사용자 요청] MasterFrame은 AutomaticSize를 껐으므로(3개 화면이 동시에
        -- 자식으로 있어서 자동 계산이 부정확해질 수 있었음), 지금 실제로 보이는 화면의
        -- 높이(AbsoluteSize.Y)를 읽어서 매 틱 수동으로 맞춰준다. 각 화면은 여전히
        -- AutomaticSize.Y라 내용에 따라 자기 스스로는 정확한 높이를 유지한다.
        local activeFrame = (s.currentScreen == "stats" and s.StatsFrame)
            or (s.currentScreen == "alltime" and s.AllTimeFrame)
            or (s.currentScreen == "event" and s.EventStatsFrame)
            or (s.currentScreen == "eventalltime" and s.EventAllTimeStatsFrame)
            or nil
        if not activeFrame then
            local statusUIForSize = LocalPlayer.PlayerGui:FindFirstChild("MacroStatusDisplay")
            activeFrame = statusUIForSize and statusUIForSize:FindFirstChild("MasterFrame")
                and statusUIForSize.MasterFrame:FindFirstChild("StatusFrame")
        end
        if activeFrame then
            local h = activeFrame.AbsoluteSize.Y
            if h > 0 then
                getgenv()._MasterFrame.Size = UDim2.new(0, 560, 0, h)
            end
        end
    end

    task.spawn(function()
        while true do
            task.wait(0.2)
            -- ✅ [사용자 요청] 안정성 - pcall로 감싸서 에러가 나도 이 루프 자체는 죽지 않게
            local ok, err = pcall(getgenv()._UpdateSwitchButtonVisibility)
            if not ok then
                warn("[전환 버튼 갱신 오류] " .. tostring(err))
            end
        end
    end)
end

-- =============================
-- [ 상태 UI용 독립 바이옴 인식 감시 ]
-- =============================
-- ✅ [치명적 버그 수정] 기존엔 "인식중인 바이옴"이 "바이옴 매크로 (준비)" 토글이 켜져
-- 있을 때만 연결되는 감시(updateBiomeMacroState 안의 ChildAdded 연결)에 얹혀있었음.
-- 그래서 "레어 바이옴 자동 팝핑"만 켜고 "바이옴 매크로"는 안 켠 상태에서는 이 감시
-- 자체가 아예 연결이 안 되어, 실제로 바이옴이 떠 있어도 항상 "없음"으로 표시됐음.
-- "인식중인 바이옴"은 특정 매크로 기능과 무관하게 항상 알아야 하는 정보이므로,
-- 마스터 매크로가 켜져 있으면(다른 토글과 무관하게) 항상 독립적으로 감시하는 루프를
-- 따로 둔다. 기존 웹훅/레어 팝핑 트리거 로직과는 완전히 분리되어 있어 중복 실행 위험이 없다.
do
    local biomeWatchTargetBiomes = {
        "WINDY", "SNOWY", "RAINY", "SANDSTORM", "HELL",
        "STARFALL", "HEAVEN", "CORRUPTION", "NULL",
        "GLITCHED", "DREAMSPACE", "CYBERSPACE", "SINGULARITY"
    }

    local function biomeWatchIsValidBiome(biomeStr)
        local cleanBiome = biomeStr:upper():gsub(" ", "")
        for _, tb in ipairs(biomeWatchTargetBiomes) do
            if cleanBiome == tb then
                return cleanBiome
            end
        end
        return nil
    end

    local function biomeWatchFindScrollingFrame()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not playerGui then return nil end
        local mainInterface = playerGui:FindFirstChild("MainInterface")
        if not mainInterface then return nil end

        for _, frame in pairs(mainInterface:GetChildren()) do
            if frame:IsA("Frame") then
                local textLabel = frame:FindFirstChildWhichIsA("TextLabel")
                if textLabel and textLabel.Text == "Private Server" then
                    local f1 = frame:FindFirstChildWhichIsA("Frame")
                    if f1 then
                        local f2 = f1:FindFirstChildWhichIsA("Frame")
                        if f2 then
                            local f3 = f2:FindFirstChildWhichIsA("Frame")
                            if f3 then
                                for _, f4 in pairs(f3:GetChildren()) do
                                    if f4:IsA("Frame") and math.abs(f4.Position.X.Scale - 0.675) < 0.01 and f4.Position.Y.Scale == 0 then
                                        local scrollingFrame = f4:FindFirstChildWhichIsA("ScrollingFrame")
                                        if scrollingFrame then
                                            return scrollingFrame
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        return nil
    end

    local biomeWatchConn = nil
    local biomeWatchFrame = nil

    -- 로그 한 줄(TextLabel)이 새로 추가될 때마다 처리
    local function handleBiomeLogLabel(child)
        if not child:IsA("TextLabel") then return end
        task.wait(0.2)
        local text = child.Text
        -- ✅ [사용자 요청] "상인 자동 구매" - "'Mari' has arrived" 또는
        -- "'Jester' has arrived" 로그가 뜨면 상인 도착 신호를 켠다.
        if text:find("'Mari' has arrived") or text:find("'Jester' has arrived") then
            getgenv().MerchantBuyWantsSlot = true
            getgenv().MerchantBuyMerchantName = text:find("Mari") and "Mari" or "Jester"
        end

        local lowerText = text:lower()
        if not (lowerText:find("biome") and (lowerText:find("started") or lowerText:find("ended"))) then
            return
        end
        local biomeRaw = text:match('"(.-)"')
        if not biomeRaw then return end
        local validBiome = biomeWatchIsValidBiome(biomeRaw)
        if not validBiome then return end
        local action = lowerText:find("started") and "started" or "ended"

        if action == "started" then
            getgenv().CurrentBiomeName = validBiome
            -- ✅ [사용자 요청] 알림 텍스트 자체에 있는 바이옴 색을
            -- 그대로 가져와서 상태 UI에서도 같은 색으로 표시.
            getgenv().CurrentBiomeColor = child.TextColor3

            -- ✅ [치명적 버그 수정] "바이옴이 새로 뜰 때마다 기존에
            -- 있던 다른 바이옴의 색이 사라진다" - 바이옴별로 마지막 색을 개별 저장해둔다.
            if not getgenv().BiomeColors then
                getgenv().BiomeColors = {}
            end
            getgenv().BiomeColors[validBiome] = child.TextColor3

            -- ✅ [사용자 요청] 스탯 UI의 "바이옴이 뜬 횟수" 집계.
            if not getgenv().BiomeAppearCounts then
                getgenv().BiomeAppearCounts = {}
            end
            getgenv().BiomeAppearCounts[validBiome] =
                (getgenv().BiomeAppearCounts[validBiome] or 0) + 1
            -- ✅ [사용자 요청] 올타임 통계에도 같이 누적
            getgenv()._AllTimeAddBiomeAppear(validBiome, child.TextColor3)
        elseif action == "ended" and getgenv().CurrentBiomeName == validBiome then
            getgenv().CurrentBiomeName = nil
            getgenv().CurrentBiomeColor = nil
        end

        -- ✅ 디스코드 바이옴 웹후크 - "바이옴 매크로 (웹후크 알림)" 토글이 켜져 있을 때만
        -- 보내는 함수가 등록돼 있다(updateBiomeMacroState 참고).
        local sender = getgenv()._BiomeWebhookSender
        if sender then
            local timeStr = text:match("%[(%d+:%d+)%]") or "Unknown"
            local okW, errW = pcall(sender, validBiome, action, timeStr)
            if not okW then
                warn("[바이옴 웹후크 오류] " .. tostring(errW))
            end
        end

        -- ✅ [버그 수정] 레어 바이옴 자동 팝핑 - 예전엔 이 트리거가 "바이옴 매크로 (웹후크
        -- 알림)" 토글의 감시 안에만 들어있어서, 웹후크 토글을 끄면 "레어 바이옴 자동 팝핑"을
        -- 켜놔도 절대 발동하지 않았다. 이제 웹후크와 무관하게 여기서 발동한다(팝핑 함수가
        -- 자체적으로 팝핑 토글/바이옴별 토글을 확인함).
        if action == "started" and (validBiome == "GLITCHED" or validBiome == "DREAMSPACE" or validBiome == "CYBERSPACE") then
            local pop = getgenv()._PerformRareBiomePop
            if pop then
                task.spawn(function()
                    local okP, errP = pcall(pop, validBiome)
                    if not okP then
                        warn("[레어 바이옴 자동 팝핑 오류] " .. tostring(errP))
                    end
                end)
            end
        end
    end

    task.spawn(function()
        while true do
            task.wait(1)

            local ok, err = pcall(function()
                if Settings.Sols.masterMacroEnabled then
                    -- ✅ [안정화] 자가 복구 - 예전엔 한 번 연결하면 다시는 확인하지 않아서, 게임이
                    -- 로그 창(ScrollingFrame)을 새로 만들거나(재설정/UI 리셋 등) 연결이 끊기면 그 뒤로
                    -- 바이옴 인식/상인 도착 감지/레어 팝핑이 소리 없이 영구히 멈췄다(오래 켜둘수록
                    -- 발생 확률↑). 매 초 연결이 살아있는지 확인하고, 끊겼으면 새로 연결한다.
                    if biomeWatchConn and (not biomeWatchConn.Connected or not biomeWatchFrame
                        or not biomeWatchFrame.Parent or not biomeWatchFrame:IsDescendantOf(game)) then
                        pcall(function() biomeWatchConn:Disconnect() end)
                        biomeWatchConn, biomeWatchFrame = nil, nil
                    end

                    if not biomeWatchConn then
                        local scrollingFrame = biomeWatchFindScrollingFrame()
                        if scrollingFrame then
                            biomeWatchFrame = scrollingFrame
                            biomeWatchConn = scrollingFrame.ChildAdded:Connect(function(child)
                                -- ✅ [사용자 요청] 안정성 - 콜백 안에서 에러가 나도 그 순간의 알림만
                                -- 건너뛰고 감시는 계속되도록 pcall로 감싼다.
                                local okH, errH = pcall(handleBiomeLogLabel, child)
                                if not okH then
                                    warn("[바이옴 감시 오류] " .. tostring(errH))
                                end
                            end)
                        end
                    end
                else
                    if biomeWatchConn then
                        pcall(function() biomeWatchConn:Disconnect() end)
                        biomeWatchConn = nil
                    end
                    biomeWatchFrame = nil
                    getgenv().CurrentBiomeName = nil
                    getgenv().CurrentBiomeColor = nil
                end
            end)
            if not ok then
                warn("[바이옴 감시 루프 오류] " .. tostring(err))
            end
        end
    end)
end

-- =============================
-- [ Fish Point 증가량 추적 (스탯 UI용) ]
-- =============================
-- ✅ [사용자 요청] Players -> LocalPlayer -> PlayerGui -> MainInterface 안, Position이
-- {0, 10}, {0.930000007, -10}인 Frame -> 그 안의 TextLabel(쉼표 포함 숫자)을 실시간으로
-- 읽어서, 매크로가 켜진 시점의 값을 기준으로 그 이후 증가한 양만 계산한다.
do
    local function findFishPointFrame()
        local mainUI = LocalPlayer.PlayerGui:FindFirstChild("MainInterface")
        if not mainUI then return nil end
        for _, frame in ipairs(mainUI:GetChildren()) do
            if frame:IsA("Frame") then
                local dx = math.abs(frame.Position.X.Scale - 0)
                local dOffX = math.abs(frame.Position.X.Offset - 10)
                local dy = math.abs(frame.Position.Y.Scale - 0.930000007)
                local dOffY = math.abs(frame.Position.Y.Offset - (-10))
                if dx < 0.01 and dOffX < 2 and dy < 0.01 and dOffY < 2 then
                    return frame
                end
            end
        end
        return nil
    end

    local function readFishPointValue()
        local frame = findFishPointFrame()
        if not frame then return nil end
        local label = frame:FindFirstChildWhichIsA("TextLabel", true)
        if not label then return nil end
        -- ✅ 쉼표(,)가 포함된 숫자 텍스트("1,234" 등)를 정리해서 숫자로 변환
        local cleaned = label.Text:gsub(",", ""):gsub("%s+", ""):match("%d+")
        if not cleaned then return nil end
        return tonumber(cleaned)
    end

    getgenv()._FishPointBaseline = nil -- 매크로를 켠 시점의 Fish Point 값

    task.spawn(function()
        local lastMasterEnabled = false
        while true do
            task.wait(1)

            -- ✅ [사용자 요청] 안정성 - pcall로 감싸서 UI 요소 접근 실패 등 에러가 나도
            -- 이 루프 자체는 죽지 않게 함
            local ok, err = pcall(function()
                local nowEnabled = Settings.Sols.masterMacroEnabled == true
                if nowEnabled and not lastMasterEnabled then
                    -- ✅ 매크로가 막 켜진 시점 - 기준값을 다시 잡는다
                    getgenv()._FishPointBaseline = readFishPointValue()
                elseif not nowEnabled then
                    getgenv()._FishPointBaseline = nil
                end
                lastMasterEnabled = nowEnabled

                if nowEnabled then
                    local current = readFishPointValue()
                    if current and getgenv()._FishPointBaseline then
                        getgenv().FishPointGained = math.max(0, current - getgenv()._FishPointBaseline)
                    end
                end
            end)
            if not ok then
                warn("[Fish Point 감시 오류] " .. tostring(err))
            end
        end
    end)
end

-- =============================
-- [ 롤수 대비 자동 킥 ]
-- =============================
-- ✅ [사용자 요청] Players -> LocalPlayer -> PlayerGui -> Stats -> ScrollingFrame -> Rolls
-- 안의 텍스트(쉼표 포함 숫자)를 실시간으로 읽어서, 사용자가 설정한 롤 수에 도달하면
-- 지정된 게임(PlaceId 118377355457595)으로 텔레포트한다.
do
    local function readRollCount()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        local stats = playerGui and playerGui:FindFirstChild("Stats")
        local scrollingFrame = stats and stats:FindFirstChild("ScrollingFrame")
        local rolls = scrollingFrame and scrollingFrame:FindFirstChild("Rolls")
        if not rolls then return nil end

        local label = rolls:IsA("TextLabel") and rolls or rolls:FindFirstChildWhichIsA("TextLabel", true)
        if not label then return nil end

        -- ✅ 쉼표(,)가 포함된 숫자 텍스트("1,234,567" 등)를 정리해서 숫자로 변환
        local cleaned = label.Text:gsub(",", ""):gsub("%s+", ""):match("%d+")
        if not cleaned then return nil end
        return tonumber(cleaned)
    end

    local ROLL_KICK_TARGET_PLACE_ID = 8425637426
    -- ✅ [치명적 버그 수정] "이제는 롤수가 차도 텔레포트를 아예 안 함" - 이전 방식(유예
    -- 시간 5초)은, 그 5초 동안 우연히 "이미 목표를 넘긴 상태"로 판정되면
    -- hasTriggeredKick이 true로 고정됐다. 그런데 롤 수는 시간이 지나면서 계속 증가만
    -- 하는 값이라, 한 번 목표를 넘기면 그 이후로도 계속 그 이상을 유지하므로 다시는
    -- 조건(currentRolls >= target and not hasTriggeredKick)이 성립하지 않아 영원히
    -- 트리거되지 않았다. "얼마나 기다렸는지" 같은 시간 개념 자체를 없애고, 토글을 켠
    -- 바로 그 순간(정확히 처음으로 롤 수를 읽는 데 성공한 딱 1번)의 롤 수를 "기준값"
    -- 으로 저장한 뒤, 그 이후로 "기준값보다 낮았다가 목표에 새로 도달"하는 상황만
    -- 감시한다. 이미 목표를 넘긴 상태로 토글을 켰다면 기준값 자체가 이미 목표 이상
    -- 이므로 자연스럽게 트리거되지 않고, 이후 서버가 바뀌어 롤 수가 낮아졌다가 다시
    -- 목표에 도달하면 정상적으로 트리거된다.
    local baselineRolls = nil

    task.spawn(function()
        while true do
            task.wait(1)

            local ok, err = pcall(function()
                -- ✅ [사용자 요청] "자동으로 안 감" - masterMacroEnabled(매크로 시작) 조건이
                -- 걸려있어서, 매크로 전체를 켜지 않으면 이 기능이 전혀 작동하지 않았다.
                -- 롤수 대비 자동 킥은 낚시/포션 제작 등 다른 매크로 기능과 무관하게 독립적으로
                -- 동작해야 하므로, 이 토글 하나만 켜면 바로 작동하도록 조건을 완화한다.
                if not Settings.Sols.autoRollKick then
                    baselineRolls = nil
                    return
                end

                local target = tonumber(Settings.Sols.rollKickTarget) or 0
                if target <= 0 then return end

                local currentRolls = readRollCount()
                if not currentRolls then return end

                -- ✅ 토글을 켠 뒤 처음으로 값을 성공적으로 읽은 시점 - 이 값을 기준값으로
                -- 저장하고, 이번 확인에서는 트리거하지 않는다.
                if not baselineRolls then
                    baselineRolls = currentRolls
                    return
                end

                -- ✅ [사용자 요청] "이미 롤수가 그 이상이면 튕기지 않게" - 기준값 자체가
                -- 이미 목표 이상이었다면(토글을 켰을 때 이미 넘긴 상태) 절대 트리거하지
                -- 않는다. 기준값이 목표 미만이었는데 지금 목표 이상이 됐을 때만(=진짜로
                -- 새로 도달했을 때만) 트리거한다.
                if baselineRolls < target and currentRolls >= target then
                    SetCurrentAction("롤수 대비 자동 킥 - 목표 도달, 텔레포트 중")
                    game:GetService("TeleportService"):Teleport(ROLL_KICK_TARGET_PLACE_ID, LocalPlayer)
                end
            end)
            if not ok then
                warn("[롤수 대비 자동 킥 오류] " .. tostring(err))
            end
        end
    end)
end

-- ✅ B(알림) 프레임 찾기: MainInterface 안, Position {0.994, 0.899} / Size {0.199, 0.5}
local function GetPotionCraftNotificationFrame()
    local mainUI = LocalPlayer.PlayerGui:FindFirstChild("MainInterface")
    if not mainUI then
        return nil
    end

    -- ✅ [디버그] 조건에 맞는 후보가 여러 개 있을 수 있으니, 전부 찾아서 오차가 가장 작은
    -- 것을 고른다. (매초 호출되므로 여기서는 로그를 남기지 않고, 호출부에서 프레임이
    -- 새로 바뀔 때만 로그를 남긴다.)
    local candidates = {}
    for _, frame in ipairs(mainUI:GetChildren()) do
        if frame:IsA("Frame") then
            local dx1 = math.abs(frame.Position.X.Scale - 0.994)
            local dy1 = math.abs(frame.Position.Y.Scale - 0.899)
            local dx2 = math.abs(frame.Size.X.Scale - 0.199)
            local dy2 = math.abs(frame.Size.Y.Scale - 0.5)
            if dx1 < 0.02 and dy1 < 0.02 and dx2 < 0.02 and dy2 < 0.02 then
                table.insert(candidates, { frame = frame, score = dx1 + dy1 + dx2 + dy2 })
            end
        end
    end

    if #candidates == 0 then return nil end

    table.sort(candidates, function(a, b) return a.score < b.score end)
    return candidates[1].frame
end

-- ✅ [사용자 요청] 매크로가 시작되거나 진행 중일 때 항상 B를 감시해서, 새로 생기는 Frame들 중
-- TextLabel의 Text 값이 "Auto Crafted"인 게 있으면 포션 자동 제작 신호를 켠다.
-- ✅ [치명적 버그 수정] 인스턴스(child) 기준 중복 방지가 실제로는 11번 이상 카운트되는
-- 문제가 있었음 - 게임이 "Auto Crafted" 알림 하나를 표시할 때 애니메이션 단계 등으로
-- 여러 개의 서로 다른 Frame/TextLabel 인스턴스를 순차적으로 생성하는 것으로 보임(우리
-- 코드 관점에서는 매번 "새로운" 인스턴스라 인스턴스 기준 중복 방지가 무력화됨). 대신
-- 마지막으로 카운트한 시점 이후 일정 시간 안에는 추가 카운트를 무시하는 시간 기반
-- 디바운스로 바꾼다.
-- ✅ [치명적 버그 수정] "8번 카운트됨" - 원인은 하나의 함수(CheckFrameForAutoCrafted)가
-- "신호 유지"와 "카운트"라는 두 가지 다른 목적을 같이 처리했던 것. 신호 유지는 알림이
-- 떠있는 내내(몇 초짜리 진행바 애니메이션 동안) 매초 계속 확인해야 하지만, 카운트는
-- "이 알림이 새로 생겼을 때" 딱 한 번만 세야 한다. 매초 재스캔이 그 알림의 텍스트
-- 라벨(또는 메인 프레임)을 계속 다시 발견해서 반복 카운트했던 것으로 보임(알림이 약
-- 8초간 떠있으면 1초 간격 재스캔에 정확히 8번 카운트되는 것과 일치). 두 역할을 완전히
-- 분리한다: 카운트는 ChildAdded(새로 생성되는 순간)에서만 하고, 매초 재스캔은 신호
-- 유지만 담당한다.
-- ✅ [사용자 요청] "2026 Summer Event" - 오토 미니게임 알림("Minigame" 제목 + "Auto
-- Crafted!" 아래에 "You've got N ItemName!" 형식의 텍스트)을 포션 자동 제작의 "Auto
-- Crafted" 알림과 정확히 같은 프레임에서 감지한다. 새로 뜬 알림에서만 성공 횟수와
-- 보상을 집계한다(ChildAdded로 정확히 1번 호출).
local function CountMinigameRewardOnce(child)
    if not (child and child:IsA("Frame")) then return end
    local isMinigameNotice = false
    local clearedText = false
    local rewardText = nil
    for _, desc in ipairs(child:GetDescendants()) do
        if desc:IsA("TextLabel") then
            if desc.Text == "Minigame" then
                isMinigameNotice = true
            elseif desc.Text:find("cleared the minigame") then
                clearedText = true
            elseif desc.Text:find("You've got") then
                rewardText = desc.Text
            end
        end
    end
    if not isMinigameNotice then return end

    -- ✅ [치명적 버그 수정] "미니게임을 한 번 깰 때마다 성공 횟수가 X2씩 늘어남" - 하나의
    -- 미니게임 완료가 제목이 똑같이 "Minigame"인 별도의 두 알림("You've cleared the
    -- minigame!" / "You've got N ItemName!")을 각각 띄우는데, 기존엔 제목만 보고
    -- 무조건 성공 횟수를 올려서 두 알림 모두에서 카운트되어 정확히 2배가 됐다.
    -- "cleared" 알림에서만 성공 횟수를 세고, 보상은 "You've got" 알림에서만 별도로
    -- 집계하도록 완전히 분리한다.
    if clearedText then
        -- ✅ [사용자 요청] 세션(이번 실행 동안) / 올타임(누적) 통계를 구분해서 기록.
        getgenv().MinigameSessionSuccessCount = (getgenv().MinigameSessionSuccessCount or 0) + 1
        getgenv()._AllTimeStats.MinigameSuccessCount = (getgenv()._AllTimeStats.MinigameSuccessCount or 0) + 1
        getgenv()._SaveAllTimeStats()
    end

    if rewardText then
        -- "You've got 3 Normal Summer Random Box!" -> 개수(3), 아이템명("Normal Summer Random Box")
        local amountStr, itemName = rewardText:match("You've got (%d+)%s+(.-)!?$")
        if amountStr and itemName then
            local amount = tonumber(amountStr)
            if amount then
                -- ✅ 세션 보상 목록도 별도로 누적
                getgenv().MinigameSessionRewards = getgenv().MinigameSessionRewards or {}
                getgenv().MinigameSessionRewards[itemName] = (getgenv().MinigameSessionRewards[itemName] or 0) + amount

                local rewards = getgenv()._AllTimeStats.MinigameRewards
                rewards[itemName] = (rewards[itemName] or 0) + amount
                getgenv()._SaveAllTimeStats()
            end
        end
    end
end

-- ✅ [사용자 요청] 바다 아이템 자동 수집 알림("Item Collected" 제목 + "You've collected
-- a/an ItemName." 텍스트) 감지. "Item Collected" 알림이 뜨는 것 자체가 성공 1회로
