-- ✅ [뼈대] Memory Match/Auto Item Use와 동일한 "단일성" 패턴:
--   - Fish가 돌고 있으면: Flexibility 지점에서 자리를 양보받아 실행
--   - Fish가 없으면: 다른 단일성 행동(Memory Match, Auto Item Use)이 끝날 때까지 기다렸다가 실행
--   - 이 기능이 실행되는 동안엔: StartMacro("PotionCraft")로 자리를 쥐고 다른 행동을 막음
-- ✅ [정리] 예전엔 "감지 조건 미정"이라는 TODO가 남아있었는데, 실제로는 이미 구현되어
-- 있음: 게임의 "Auto Crafted" 알림 프레임을 감시하는 별도 코루틴(CountAutoCraftedOnce/
-- RefreshAutoCraftedSignal, 파일 아래쪽)이 그 알림을 감지할 때마다
-- getgenv().PotionCraftWantsSlot을 true로 세팅한다. 여기서는 그 신호를 그대로 읽기만
-- 하면 됨 - 추가로 채워 넣을 감지 로직은 없음.
local function IsPotionCraftSignaled()
    if not (Settings.Sols and Settings.Sols.autoPotionCraft and Settings.Sols.masterMacroEnabled) then
        return false
    end
    if MacroPriority.IsActive.PotionCraft then
        return true
    end
    -- ✅ [안정화] 연속 실패로 쉬는 중이면 신호를 무시(낚시가 계속 양보만 하다 멈추는 것 방지)
    if getgenv()._PotionCraftCooldownUntil and tick() < getgenv()._PotionCraftCooldownUntil then
        return false
    end
    return getgenv().PotionCraftWantsSlot == true
end

-- ✅ [사용자 요청] "하드코딩 정리" - YieldFishingForMemoryMatch/YieldFishingForPotionCraft
-- (Memory Match/Potion Craft 각각을 개별적으로 기다리던 예전 함수)는 이제 통합 함수
-- YieldFishingForSingleActions()로 완전히 대체되어 실제로 호출되는 곳이 없었다(죽은
-- 코드). 실제 동작에 영향 없이 제거한다.

-- ✅ [사용자 요청] "2026 Summer Event" - 오토 미니게임 신호 감지. 인벤토리가 닫혀있어도
-- (Visible=false여도) 인스턴스 자체는 계속 존재하므로, 열지 않고도 아이템 개수를 확인할
-- 수 있다. Minigame Ticket을 정확 일치(exact match) 기준으로 확인한다.
local function GetInventoryItemAmountWithoutOpening(itemName)
    local mainInterface = LocalPlayer.PlayerGui:FindFirstChild("MainInterface")
    local inventory = mainInterface and mainInterface:FindFirstChild("Inventory")
    local scrollingFrame = inventory and inventory:FindFirstChild("Items") and inventory.Items:FindFirstChild("ItemGrid")
        and inventory.Items.ItemGrid:FindFirstChild("ItemGridScrollingFrame")
    if not scrollingFrame then return 0 end

    local item = getgenv()._FindInventoryItemByName(scrollingFrame, itemName)
    if not item then return 0 end

    local btn = item:FindFirstChild("Button")
    if btn and btn:FindFirstChild("ItemAmount") then
        local txt = btn.ItemAmount.Text
        local num = txt:match("x(%d+)")
        if num then return tonumber(num) end
    end
    return 1
end

-- ✅ [사용자 요청] 오토 미니게임 신호 감지 - Minigame Ticket을 2개 초과(=3개 이상은 물론
-- 정확히는 요청하신 "1개 초과", 즉 2개 이상) 보유하고 있으면 신호를 켠다.
local function IsAutoMinigameSignaled()
    if not (Settings.Sols and Settings.Sols.autoMinigame and Settings.Sols.masterMacroEnabled) then
        return false
    end
    if MacroPriority.IsActive.AutoMinigame then
        return true
    end
    local ok, amount = pcall(GetInventoryItemAmountWithoutOpening, "Minigame Ticket")
    return ok and amount and amount >= 2
end

-- ✅ [사용자 요청] "2026 Summer Event" - 바다에 있는 아이템 자동 수집 신호 감지.
-- Workspace 안에 FloatingItem 모델이 하나라도 있으면 신호를 켠다.
local function IsAutoSeaItemCollectSignaled()
    if not (Settings.Sols and Settings.Sols.autoSeaItemCollect and Settings.Sols.masterMacroEnabled) then
        return false
    end
    if MacroPriority.IsActive.AutoSeaItemCollect then
        return true
    end
    return workspace:FindFirstChild("FloatingItem") ~= nil
end

-- ✅ [사용자 요청] 상인 자동 구매 신호 감지. 'Mari'/'Jester' 도착 로그를 감지하면
-- getgenv().MerchantBuyWantsSlot이 true로 세팅된다(바이옴 감시 콜백에서 처리).
local function IsMerchantBuySignaled()
    if not (Settings.Sols and Settings.Sols.autoMerchantBuy and Settings.Sols.masterMacroEnabled) then
        return false
    end
    if MacroPriority.IsActive.MerchantBuy then
