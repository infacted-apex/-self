-- ✅ [사용자 요청] 아이템이 시간이 지날수록 늘어나면서, 카테고리 버튼(QuickCategory,
-- LayoutOrder로 특정 분류를 찾는 방식)에 의존하는 기존 방식은 그 카테고리 안에서도
-- 원하는 아이템을 못 찾을 위험이 커짐. 포션 자동 제작(ScrollToPotionButton)과 동일한
-- 원리로, 목표 아이템의 실제 화면 좌표를 계산해서 스크롤 프레임을 정확히 그 위치로
-- 이동시키는 방식으로 통일한다. ItemGridScrollingFrame은 Roblox의 ScrollingFrame이라
-- CanvasPosition으로 직접 스크롤한다(포션 제작 쪽의 Position 이동과 원리는 동일하고,
-- ScrollingFrame이라는 실제 타입에 맞는 표준 스크롤 속성을 사용).
-- ✅ 파일이 이미 로컬 변수 슬롯 200개 한도에 근접해 있어서, getgenv()에 저장한다.
getgenv()._ScrollToInventoryItem = function(targetItem, scrollingFrame)
    if not (targetItem and scrollingFrame) then return end

    local btnPos = targetItem.AbsolutePosition
    local btnSize = targetItem.AbsoluteSize
    local viewportPos = scrollingFrame.AbsolutePosition
    local viewportSize = scrollingFrame.AbsoluteSize

    local deltaY = (btnPos.Y + btnSize.Y / 2) - (viewportPos.Y + viewportSize.Y / 2)

    local currentCanvas = scrollingFrame.CanvasPosition
    local newY = currentCanvas.Y + deltaY

    local maxScrollY = math.max(0, scrollingFrame.AbsoluteCanvasSize.Y - viewportSize.Y)
    newY = math.clamp(newY, 0, maxScrollY)

    scrollingFrame.CanvasPosition = Vector2.new(currentCanvas.X, newY)
end

-- ✅ [사용자 요청] 인벤토리 전체(카테고리 필터 없이)에서 이름으로 아이템을 찾는 헬퍼.
-- 카테고리 버튼을 거치지 않으므로, 아이템이 늘어나도 항상 정확하게 찾을 수 있다.
getgenv()._FindInventoryItemByName = function(scrollingFrame, itemName)
    for _, item in pairs(scrollingFrame:GetChildren()) do
        -- ✅ [치명적 버그 수정] "이름이 들어가있는 다른 아이템까지 사용한다" - 기존에
        -- string.find(desc.Text, itemName)로 부분 문자열 매칭을 했는데, 이러면 예를 들어
        -- "Warp Potion"을 찾을 때 "Warp Potion X"나 "Super Warp Potion" 같은 다른
        -- 아이템의 텍스트에도 매칭되어 잘못된 아이템을 클릭해버릴 수 있었음. item.Name과
        -- 아이템 이름을 표시하는 텍스트 라벨 모두 정확히 완전히 일치(exact match)할
        -- 때만 인정하도록 강화한다.
        if item.Name == itemName then
            return item
        end
        for _, desc in ipairs(item:GetDescendants()) do
            if desc:IsA("TextLabel") and desc.Text == itemName then
                return item
            end
        end
    end
    return nil
end

-- ✅ [안정화] 아이템 상세 패널(사용 개수 입력칸/사용 버튼)을 시간 제한 있게 찾는다. 예전엔
-- WaitForChild에 시간 제한이 없어서, 아이템 클릭이 씹혀 패널이 안 뜨면 그 자리에서 영원히
-- 멈췄다(레어 바이옴 팝핑 도중이면 Emergency가 켜진 채로 굳어서 매크로 전체가 멈춤).
getgenv()._GetItemUseControls = function(inventory)
    local index = inventory:WaitForChild("Index", 5)
    local itemIndex = index and index:WaitForChild("ItemIndex", 5)
    local useHolder = itemIndex and itemIndex:WaitForChild("UseHolder", 5)
    local useAmount = useHolder and useHolder:WaitForChild("UseAmount", 5)
    local useButton = useHolder and useHolder:WaitForChild("UseButton", 5)
    return useAmount, useButton
end

local function useSpecificItemByName(itemName)
    local mainInterface = LocalPlayer.PlayerGui:FindFirstChild("MainInterface")
    local inventory = mainInterface and mainInterface:FindFirstChild("Inventory")
    if not inventory then return false end

    local scrollingFrame = inventory:FindFirstChild("Items") and inventory.Items:FindFirstChild("ItemGrid") and
        inventory.Items.ItemGrid:FindFirstChild("ItemGridScrollingFrame")
    if not scrollingFrame then return false end

    local targetItem = getgenv()._FindInventoryItemByName(scrollingFrame, itemName)

    if targetItem then
        -- ✅ [사용자 요청] 클릭 전에 정확한 위치로 스크롤 (포션 자동 제작과 동일한 방식)
        getgenv()._ScrollToInventoryItem(targetItem, scrollingFrame)
        task.wait(0.2)
        clickExactly(targetItem)
        -- ✅ [사용자 요청] 클릭 후 대기 시간이 체감될 만큼 길었음. 0.5 -> 0.3으로 단축.
        task.wait(0.3)
        local useAmount, useButton = getgenv()._GetItemUseControls(inventory)
        if not (useAmount and useButton) then return false end

        if useAmount.Text == "1" then
            clickExactly(useButton)
        else
            useAmount.Text = "1"
            if useAmount:IsA("TextBox") then useAmount:ReleaseFocus() end
            task.wait(0.25)
            clickExactly(useButton)
        end
        return true
    end
    return false
end

local function useSpecificItemByNameWithAmount(itemName, useAmountNum)
    local mainInterface = LocalPlayer.PlayerGui:FindFirstChild("MainInterface")
    local inventory = mainInterface and mainInterface:FindFirstChild("Inventory")
    if not inventory then return false end

    local scrollingFrame = inventory:FindFirstChild("Items") and inventory.Items:FindFirstChild("ItemGrid") and
        inventory.Items.ItemGrid:FindFirstChild("ItemGridScrollingFrame")
    if not scrollingFrame then return false end

    -- ✅ [치명적 버그 수정] "이름이 들어가있는 다른 아이템까지 사용한다" - 부분 문자열
    -- 매칭 대신, 위쪽의 정확 일치(exact match) 검색 함수를 그대로 재사용한다.
    local targetItem = getgenv()._FindInventoryItemByName(scrollingFrame, itemName)
    local currentAmount = 0
    if targetItem then
        local btn = targetItem:FindFirstChild("Button")
        if btn and btn:FindFirstChild("ItemAmount") then
            local txt = btn.ItemAmount.Text
            -- e.g., 'x15' -> 15
            local num = txt:match("x(%d+)")
            if num then currentAmount = tonumber(num) end
        end
    end

    if targetItem then
        if currentAmount <= 0 then currentAmount = 1 end -- fallback
        local amountToUse = currentAmount
        if useAmountNum ~= "ALL" and type(useAmountNum) == "number" then
            if currentAmount > useAmountNum then
                amountToUse = useAmountNum
            end
        end

        -- ✅ [사용자 요청] 클릭 전에 정확한 위치로 스크롤 (포션 자동 제작과 동일한 방식)
        getgenv()._ScrollToInventoryItem(targetItem, scrollingFrame)
        task.wait(0.2)
        clickExactly(targetItem)
        -- ✅ [사용자 요청] 클릭 후 대기 시간이 체감될 만큼 길었음. 0.5 -> 0.3으로 단축.
        task.wait(0.3)
        local useAmountBox, useButton = getgenv()._GetItemUseControls(inventory)
        if not (useAmountBox and useButton) then return false end

        useAmountBox.Text = tostring(amountToUse)
        if useAmountBox:IsA("TextBox") then useAmountBox:ReleaseFocus() end
        task.wait(0.25)
        clickExactly(useButton)
        task.wait(0.77)
        return true
    end
    return false
end

