        return Settings.Sols.autoMerchantBuy and Settings.Sols.masterMacroEnabled
    end,
    isSignaled = IsMerchantBuySignaled,
    run = RunAutoMerchantBuy
})

-- =============================
-- [ 2026 Summer Event - 오토 미니게임 ]
-- =============================
-- ✅ [사용자 요청] Minigame Ticket을 2개 이상 보유하면, Click To Move를 활성화하고
-- Workspace -> Map -> Lime으로 이동한 뒤, (자동 상인 구매와 동일한 방식으로) 화면을
-- 위로 향하게 하고 E키를 눌러 대화를 연다. [Minigame] 버튼 -> [-1 Minigame Ticket]
-- 버튼을 순서대로 누르고, 5초 대기 후 Workspace -> Watermelon으로 이동해 E키를 1번
-- 누른 뒤 7.5초 대기한다.
-- ✅ [사용자 요청] "안되면 그냥 포기 로직" - Players -> LocalPlayer -> PlayerGui ->
-- MainInterface 안, Size 값이 {0.0500000007, 0}, {0.0199999996, 0}인 ImageButton을
-- 1번 클릭한다(포기/닫기 버튼으로 추정).
-- ✅ [정리] ShouldContinueMinigame이 Emergency 발생 시 이 함수를 참조할 수 있도록
-- 순서를 앞으로 옮김 (기존엔 ShouldContinueMinigame이 먼저 정의되어 있어서, 그 안에서
-- 이 함수를 직접 부르려면 아직 존재하지 않는 지역변수를 참조하게 되는 문제가 있었음).
local function ClickMinigameGiveUpButton()
    local mainInterface = LocalPlayer.PlayerGui:FindFirstChild("MainInterface")
    if not mainInterface then return false end

    for _, obj in ipairs(mainInterface:GetDescendants()) do
        if obj:IsA("ImageButton")
            and math.abs(obj.Size.X.Scale - 0.0500000007) < 0.0001
            and math.abs(obj.Size.Y.Scale - 0.0199999996) < 0.0001 then
            clickExactly(obj)
            return true
        end
    end
    return false
end

-- ✅ [정리/안정화] 기존엔 Emergency가 뜨면 그냥 false만 반환하고 끝나서, 미니게임
-- 대화창/선택지 UI가 열린 채로 방치될 수 있었음 (바다 아이템 자동 수집은 이미
-- HandleSeaItemEmergencyIfNeeded로 안전 정리 절차가 있는데, 오토 미니게임엔 없었음).
-- Emergency가 새로 감지된 시점에 최선을 다해 한 번만 포기 버튼을 눌러본다 - 실패해도
-- 치명적이지 않음(다음 진입 때 캐릭터 재설정 단계가 어차피 상태를 정리해줌).
local __minigameEmergencyCleanupDone = false
local function ShouldContinueMinigame()
    -- ✅ [사용자 요청] "오토 미니게임 중에 긴급 신호가 발생하면 즉시 중단 루프를 타게" -
    -- 이 함수는 RunAutoMinigame 전체의 모든 체크포인트(이동, 카메라 조작, 버튼 대기 등)
    -- 에서 "계속 진행해도 되는가"를 판단하는 단일 기준으로 쓰이고 있다. 여기에 Emergency
    -- 확인 하나만 추가하면, 함수 전체의 모든 지점이 자동으로 "즉시 중단(StopMacro 후
    -- return)"으로 이어진다 - 매크로가 꺼졌을 때와 완전히 동일한 방식으로 처리된다.
    if Settings.Emergency then
        if not __minigameEmergencyCleanupDone then
            __minigameEmergencyCleanupDone = true
            pcall(ClickMinigameGiveUpButton)
        end
        return false
    end
    __minigameEmergencyCleanupDone = false
    return Settings.Sols.autoMinigame and Settings.Sols.masterMacroEnabled
end

local function RunAutoMinigame()
    if not CanStartMacro("AutoMinigame") then return end
    StartMacro("AutoMinigame")
    SetCurrentAction("오토 미니게임 - 시작")

    if not ShouldContinueMinigame() then
        StopMacro("AutoMinigame")
        return
    end

    -- ✅ [사용자 요청] "미니게임을 하러 갈 때도 재설정을 1번 하고 난 뒤에 가게" - 재설정
    -- 후 플레이어 부활 대기 + 0.5초 대기.
    -- ✅ [치명적 버그 수정] "처음 매크로를 틀 때 재설정 후 부활 대기에서 멈춤" -
    -- ResetCharacter()가 이제 "실제로 재설정을 실행했는지"를 true/false로 반환한다
    -- (맨 처음 1회/3초 이내/5스터드 미만 이동이면 내부적으로 스킵하고 false를 반환).
    -- 반환값을 확인 안 하고 무조건 CharacterAdded를 기다리면, 재설정이 스킵된
    -- 경우(특히 세션 첫 재설정) 캐릭터가 죽지 않아 그 이벤트가 절대 발생하지 않으므로
    -- 매번 최대 30초씩 헛되이 멈춰있게 된다. 실제로 재설정했을 때만 부활을 기다린다.
    SetCurrentAction("오토 미니게임 - 재설정 중")
    local oldChar = LocalPlayer.Character
    if oldChar then
        local didReset = ResetCharacter()

        if didReset then
        SetCurrentAction("오토 미니게임 - 캐릭터 부활 대기 중")
        local charWaitDone = false
        task.spawn(function()
            pcall(function() LocalPlayer.CharacterAdded:Wait() end)
            charWaitDone = true
        end)
        local charWaitStart = tick()
        while not charWaitDone and (tick() - charWaitStart) < 30 do
            if not ShouldContinueMinigame() then
                StopMacro("AutoMinigame")
                return
            end
            task.wait(0.1)
        end
        end


        task.wait(0.5)
    end

    if not ShouldContinueMinigame() then
        StopMacro("AutoMinigame")
        return
    end

    -- ===== Click To Move 활성화 후 Lime으로 이동 =====
    EnsureClickToMoveMode(ShouldContinueMinigame)
    if not ShouldContinueMinigame() then
        StopMacro("AutoMinigame")
        return
    end

    local lime = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Lime")
    if not lime then
        StopMacro("AutoMinigame")
        return
    end
    local limePos = lime:IsA("BasePart") and lime.Position or (lime.PrimaryPart and lime.PrimaryPart.Position)
    if not limePos then
        StopMacro("AutoMinigame")
        return
    end

    -- ✅ [사용자 요청] "미니게임에서는 재설정 로직이 없게, 실패하면 한 번 더 이동을
    -- 시도해보고 안되면 포기" - skipReset=true로 넘겨서 실패해도 캐릭터를 재설정하지
    -- 않고, 실패하면 이 자리에서 한 번 더(총 2번) 시도한 뒤 그래도 안 되면 포기 버튼을
    -- 누르고 매크로를 종료한다.
    local movedToLime = MoveToPositionClickStyle(limePos, "Lime", ShouldContinueMinigame, "오토 미니게임", false, true)
    if not movedToLime and ShouldContinueMinigame() then
        movedToLime = MoveToPositionClickStyle(limePos, "Lime", ShouldContinueMinigame, "오토 미니게임", false, true)
    end
    if not movedToLime or not ShouldContinueMinigame() then
        ClickMinigameGiveUpButton()
        task.wait(5)
        StopMacro("AutoMinigame")
        return
    end

    -- ===== 화면을 위로 향하게 하고 E키 -> [Minigame] -> [-1 Minigame Ticket] =====
    -- (자동 상인 구매 참고) 카메라를 목표(Lime) 위쪽에서 수직으로 내려다보는 각도로
    -- 바꾸고, E키를 눌러 대화를 연다.
    -- ✅ [사용자 요청] 카메라 직하향 기준을 내 캐릭터 위치가 아니라 목표(Lime) 위치로.
    -- ✅ [치명적 버그 수정] 카메라 조작 구간에서 에러가 나도 반드시 복구되도록 pcall로 감쌈.
    SetCurrentAction("오토 미니게임 - 대화 여는 중 (E)")
    local cam = workspace.CurrentCamera
    if cam then
        cam.CameraType = Enum.CameraType.Scriptable
    end

    pcall(function()
        if cam then
            cam.CFrame = CFrame.new(limePos + Vector3.new(0, 15, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
        end
    end)

    task.wait(1)

    -- ✅ [치명적 버그 수정] "카메라 직하향은 하는데 E키를 안 누름" - 카메라 조작에서
    -- 에러가 나도 E키 입력은 반드시 별도로 시도되도록 완전히 분리된 pcall로 감쌈.
    pcall(function()
        local vim = Services.VirtualInputManager
        vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.05)
        vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)

    task.wait(1)

    -- ✅ 화면을 위로 향한 상태 그대로 유지, CameraType만 다시 조작 가능하게(자동 상인
    -- 구매와 동일한 방식).
    if cam then
        local keepCFrame = cam.CFrame
        cam.CameraType = Enum.CameraType.Custom
        cam.CFrame = keepCFrame
    end

    if not ShouldContinueMinigame() then
        StopMacro("AutoMinigame")
        return
    end

    -- 첫 번째 버튼([Minigame])이 생길 때까지 대기 후 클릭
    SetCurrentAction("오토 미니게임 - Minigame 버튼 대기 중")
    local choices = nil
    local minigameButton = nil
    local waitStart = tick()
    while (tick() - waitStart) < 60 do
        choices = FindDialogChoices()
        if choices then
            for _, child in ipairs(choices:GetChildren()) do
                if child.ClassName == "TextButton" and child.Text == "[ Minigame ]" then
                    minigameButton = child
                    break
                end
            end
        end
        if minigameButton then break end
        task.wait(0.2)
        if not ShouldContinueMinigame() then
            StopMacro("AutoMinigame")
            return
        end
    end
    if not minigameButton then
        StopMacro("AutoMinigame")
        return
    end

    SetCurrentAction("오토 미니게임 - Minigame 클릭")
    -- ✅ [사용자 요청] 다이얼로그 선택지가 나오면 바로 클릭하지 말고 0.25초 대기 후 클릭
    task.wait(0.25)
    clickExactly(minigameButton)

    if not ShouldContinueMinigame() then
        StopMacro("AutoMinigame")
        return
    end

    -- 두 번째 버튼([-1 Minigame Ticket])이 다시 생길 때까지 대기 후 클릭
    SetCurrentAction("오토 미니게임 - [-1 Minigame Ticket] 버튼 대기 중")
    local ticketButton = nil
    waitStart = tick()
    while (tick() - waitStart) < 60 do
        choices = FindDialogChoices()
        if choices then
            for _, child in ipairs(choices:GetChildren()) do
                if child.ClassName == "TextButton" and child.Text == "[ -1 Minigame Ticket ]" then
                    ticketButton = child
                    break
                end
            end
        end
        if ticketButton then break end
        task.wait(0.2)
        if not ShouldContinueMinigame() then
            StopMacro("AutoMinigame")
            return
        end
    end
    if not ticketButton then
        StopMacro("AutoMinigame")
        return
    end

    SetCurrentAction("오토 미니게임 - [-1 Minigame Ticket] 클릭")
    -- ✅ [사용자 요청] 다이얼로그 선택지가 나오면 바로 클릭하지 말고 0.25초 대기 후 클릭
    task.wait(0.25)
    clickExactly(ticketButton)

    task.wait(5)

    -- ===== Watermelon으로 이동 후 E키 1번 =====
    if not ShouldContinueMinigame() then
        StopMacro("AutoMinigame")
        return
    end

    local watermelon = workspace:FindFirstChild("Watermelon")
    local movedToWatermelon = false
    local watermelonPos = nil
    if watermelon then
        watermelonPos = watermelon:IsA("BasePart") and watermelon.Position
            or (watermelon.PrimaryPart and watermelon.PrimaryPart.Position)
        if watermelonPos then
            -- ✅ [사용자 요청] "미니게임에서는 재설정 로직이 없게, 실패하면 한 번 더
            -- 이동을 시도해보고 안되면 포기" - Watermelon도 동일하게 적용한다.
            movedToWatermelon = MoveToPositionClickStyle(watermelonPos, "Watermelon", ShouldContinueMinigame, "오토 미니게임",
                true, true)
            if not movedToWatermelon and ShouldContinueMinigame() then
                movedToWatermelon = MoveToPositionClickStyle(watermelonPos, "Watermelon", ShouldContinueMinigame,
                    "오토 미니게임", true, true)
            end
            if not movedToWatermelon then
                ClickMinigameGiveUpButton()
                task.wait(5)
                StopMacro("AutoMinigame")
                return
            end
        end
    end

    if ShouldContinueMinigame() then
        -- ✅ [사용자 요청] Watermelon에서 E키를 누를 때도 화면을 위에서 아래로 내려다보는
        -- 각도가 되게 한다 (Lime에서 대화를 열 때와 동일한 방식). 카메라 높이는 3스터드.
        -- ✅ [사용자 요청] 카메라 직하향 기준을 내 캐릭터 위치가 아니라 목표(Watermelon)
        -- 위치로.
        -- ✅ [치명적 버그 수정] 카메라 조작+E키 구간에서 에러가 나도 반드시 복구되도록
        -- pcall로 감쌈(이 아래 "사라짐 대기" 루프는 카메라 CFrame을 더 안 건드리므로
        -- 안전).
        SetCurrentAction("오토 미니게임 - Watermelon에서 화면 직하향 중")
        local wmCam = workspace.CurrentCamera
        if wmCam and watermelonPos then
            wmCam.CameraType = Enum.CameraType.Scriptable
        end

        pcall(function()
            if wmCam and watermelonPos then
                -- ✅ [사용자 요청] 카메라 높이를 15 -> 3스터드로 변경
                wmCam.CFrame = CFrame.new(watermelonPos + Vector3.new(0, 3, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
            end
        end)

        task.wait(1)

        -- ✅ [치명적 버그 수정] "카메라 직하향은 하는데 E키를 안 누름" - (1) 카메라
        -- 조작과 E키 입력을 하나의 pcall로 묶으면 카메라 쪽 에러가 E키 실행 자체를
        -- 막아버리는 문제가 있었고, (2) 이 pcall 안에서 참조하던 vim이 실은 이 함수
        -- 어디에도 선언된 적 없는 변수라(다른 곳의 pcall 클로저 안에서만 지역적으로
        -- 선언됐을 뿐, 이 클로저에서는 전혀 안 보임) 전역(nil) 취급되어
        -- vim:SendKeyEvent 호출 자체가 매번 "nil 인덱싱" 에러를 내고 있었다. 이 에러가
        -- pcall에 조용히 삼켜지면서 E키가 눌리는 것처럼 보이지도, 경고가 뜨지도 않은
        -- 채로 그냥 아무 일도 안 일어났다. 이 pcall 안에서 직접
        -- Services.VirtualInputManager를 참조하도록 수정한다.
        pcall(function()
            SetCurrentAction("오토 미니게임 - Watermelon에서 E키 누르는 중")
            Services.VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(0.05)
            Services.VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end)

        -- ✅ [사용자 요청] "워터멜론 모델이 아예 사라진 시점을 기준으로" - 고정 대기
        -- 대신, workspace에서 Watermelon 인스턴스 자체가 사라지는 것을 완료 신호로
        -- 삼는다. "E키를 눌렀는데도 3초 이상 워터멜론이 사라지지 않으면 포기".
        SetCurrentAction("오토 미니게임 - Watermelon 사라짐 대기 중")
        local disappearWaitStart = tick()
        local watermelonGone = false
        while (tick() - disappearWaitStart) < 3 do
            if not ShouldContinueMinigame() then
                if wmCam then
                    local wmKeepCFrame = wmCam.CFrame
                    wmCam.CameraType = Enum.CameraType.Custom
                    wmCam.CFrame = wmKeepCFrame
                end
                StopMacro("AutoMinigame")
                return
            end
            if not workspace:FindFirstChild("Watermelon") then
                watermelonGone = true
                break
            end
            task.wait(0.1)
        end

        -- ✅ 화면을 위로 향한 상태 그대로 유지, CameraType만 다시 조작 가능하게(자동 상인
        -- 구매/Lime과 동일한 방식).
        if wmCam then
            local wmKeepCFrame = wmCam.CFrame
            wmCam.CameraType = Enum.CameraType.Custom
            wmCam.CFrame = wmKeepCFrame
        end

        -- ✅ [사용자 요청] 3초 이상 워터멜론이 사라지지 않으면 포기 로직 실행
        if not watermelonGone then
            ClickMinigameGiveUpButton()
            task.wait(5)
            StopMacro("AutoMinigame")
            return
        end

        -- ✅ [사용자 요청] "수박이 없어지고 5초 뒤에 끝나야" - 성공적으로 사라진 걸
        -- 확인한 뒤에도 5초를 더 대기한다.
        task.wait(5)
    end

    StopMacro("AutoMinigame")
end

RegisterSingleAction({
    name = "AutoMinigame",
    logName = "오토 미니게임",
    -- ✅ [치명적 버그 수정] "티켓이 1개인데도 미니게임을 함" - forceInitialRun의 기본값이
    -- true라서, 매크로를 켜는 순간 실제 신호(Minigame Ticket 2개 이상)와 무관하게
    -- 자리만 비어있으면 무조건 한 번 실행되고 있었다(상인 자동 구매에서 겪었던 것과
    -- 정확히 같은 원인). "Minigame Ticket 2개 이상 보유"라는 순수 조건 기반 신호이므로,
    -- forceInitialRun = false로 꺼서 실제로 신호가 있을 때만 실행되게 한다.
    forceInitialRun = false,
    isEnabled = function()
        return Settings.Sols.autoMinigame and Settings.Sols.masterMacroEnabled
    end,
    isSignaled = IsAutoMinigameSignaled,
    run = RunAutoMinigame
})

-- =============================
-- [ 2026 Summer Event - 바다에 있는 아이템 자동 수집 ]
-- =============================
-- ✅ [사용자 요청] Workspace 안에 FloatingItem 모델이 있으면(여러 개 가능), Aura
-- Storage 패널을 열어서 AbyssalHunter 아이템을 찾아 장착(또는 사용)한다.
local function ShouldContinueSeaItemCollect()
    -- ✅ [사용자 요청] "이동 중에 Emergency가 뜨면, 그 자리에서 즉시 Emergency로 자리를
    -- 넘기게" - 이 함수는 MoveToPositionClickStyle에도 shouldContinueFn으로 그대로
    -- 넘겨지므로, 여기에 Emergency 확인 하나만 추가하면 이동 함수 내부의 모든
    -- 체크포인트(재시도 루프, 정지 판정 폴링 등)가 자동으로 즉시 중단된다. 이동이
    -- 중단되면 호출부가 "이동 실패"로 판단해 메인 루프를 빠져나가고, 그 직후의
    -- HandleSeaItemEmergencyIfNeeded 호출이 아우라 해제 -> 탭 닫기 -> 자리 반납
    -- 순서를 정확히 처리한다(아직 아우라를 장착하기 전 단계라면 할 게 없어 그냥
    -- 조용히 종료됨).
    return Settings.Sols.autoSeaItemCollect and Settings.Sols.masterMacroEnabled and not Settings.Emergency
end

-- ✅ [사용자 요청] "바다 아이템 자동 수집 중이라면, 아우라를 장착 해제한 다음, Aura 탭을
-- 닫고, Emergency를 실행하게" - 레어 바이옴 등 Emergency 신호가 오면, 오토 미니게임처럼
-- 그냥 즉시 중단하는 게 아니라(그러면 아우라를 낀 채로 바다에 남겨져 위험할 수 있음),
-- 반드시 이 순서(아우라 해제 -> 탭 닫기 -> 매크로 종료)를 거친 뒤에야 자리를 반납한다.
-- confirmButton/auraStorageFrame이 아직 준비 안 됐으면(신호 감지 극초반) 그냥 즉시 종료.
local function HandleSeaItemEmergencyIfNeeded(auraStorageFrame, confirmButton)
    if not Settings.Emergency then return false end

    -- ✅ 아우라 재장착 감시부터 꺼서, 우리가 지금 해제하려는 것과 감시 코루틴이
    -- 서로 충돌(감시가 다시 장착시켜버림)하지 않게 한다.
    getgenv()._SeaItemAuraWatchActive = false

    -- ✅ 아우라 장착 해제 (지금 "Unequip" 상태 = 장착 중이면 눌러서 해제)
    if confirmButton then
        local confirmLabel = confirmButton:FindFirstChildWhichIsA("TextLabel", true)
        if confirmLabel and confirmLabel.Text == "Unequip" then
            SetCurrentAction("바다 아이템 자동 수집 - Emergency로 아우라 해제 중")
            pcall(clickExactly, confirmButton)
            task.wait(0.5)
        end
    end

    -- ✅ Aura Storage 탭 닫기
    SetCurrentAction("바다 아이템 자동 수집 - Emergency로 Aura Storage 닫는 중")
    if auraStorageFrame then
        auraStorageFrame.Visible = false
    end

    -- ✅ 자리를 반납해서 Emergency가 진행될 수 있게 한다.
    StopMacro("AutoSeaItemCollect")
    return true
end

-- ✅ MainInterface 하위에서 "자신의 하위(자손) 어딘가에 TextLabel이 있고, 그 Text 값이
-- targetText인" Frame을 찾는다. 요청하신 "하위 폴더에 TextLabel이 있고, 그 TextLabel의
-- Text 값이 X인 Frame" 조건을 그대로 구현.
local function FindFrameByDescendantLabelText(root, targetText)
    for _, frame in ipairs(root:GetChildren()) do
        if frame:IsA("Frame") then
            for _, desc in ipairs(frame:GetDescendants()) do
                if desc:IsA("TextLabel") and desc.Text == targetText then
                    return frame
                end
            end
        end
    end
    return nil
end

-- ✅ 특정 Position(Scale 기준)을 가진 자식 Frame을 찾는 헬퍼. 요청하신 "Position 값이
-- {x, 0}, {y, 0}인 Frame/ImageButton" 조건을 반복적으로 쓰기 위함.
local function FindChildByPosition(parent, className, xScale, yScale)
    if not parent then return nil end
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA(className)
            and math.abs(child.Position.X.Scale - xScale) < 0.0001
            and math.abs(child.Position.Y.Scale - yScale) < 0.0001 then
            return child
        end
    end
    return nil
end

local function RunAutoSeaItemCollect()
    if not CanStartMacro("AutoSeaItemCollect") then return end
    StartMacro("AutoSeaItemCollect")
    SetCurrentAction("바다 아이템 자동 수집 - 시작")

    -- ✅ [사용자 요청] 신호 감지 직후 재설정을 1번 한다.
    SetCurrentAction("바다 아이템 자동 수집 - 재설정 중")
    local oldChar = LocalPlayer.Character
    if oldChar then
        local didReset = ResetCharacter()

        -- ✅ [치명적 버그 수정] "재설정을 안 했는데도 부활 대기를 해서 손해가 있음" -
        -- ResetCharacter()가 이제 "실제로 재설정을 실행했는지"를 true/false로 반환한다.
        -- 반환값을 안 보고 무조건 기다리면, 재설정이 스킵된 경우(맨 처음 1회/3초 이내/
        -- 5스터드 미만 이동) 캐릭터가 죽지 않아 CharacterAdded가 절대 발생하지 않고
        -- 매번 최대 30초씩 헛되이 멈추게 된다. 실제로 재설정했을 때만 부활을 기다린다.
        if didReset then
        SetCurrentAction("바다 아이템 자동 수집 - 캐릭터 부활 대기 중")
        local charWaitDone = false
        task.spawn(function()
            pcall(function() LocalPlayer.CharacterAdded:Wait() end)
            charWaitDone = true
        end)
        local charWaitStart = tick()
        while not charWaitDone and (tick() - charWaitStart) < 30 do
            if not ShouldContinueSeaItemCollect() then
                StopMacro("AutoSeaItemCollect")
                return
            end
            task.wait(0.1)
        end
        end

        task.wait(1)
    end

    if not ShouldContinueSeaItemCollect() then
        StopMacro("AutoSeaItemCollect")
        return
    end

    local mainInterface = LocalPlayer.PlayerGui:FindFirstChild("MainInterface")
    if not mainInterface then
        warn("[바다 아이템 자동 수집] MainInterface를 찾지 못함")
        StopMacro("AutoSeaItemCollect")
        return
    end

    -- ===== Aura Storage 패널 찾기 및 열기 =====
    local auraStorageFrame = FindFrameByDescendantLabelText(mainInterface, "Aura Storage")
    if not auraStorageFrame then
        warn("[바다 아이템 자동 수집] Aura Storage 프레임을 찾지 못함")
        StopMacro("AutoSeaItemCollect")
        return
    end

    SetCurrentAction("바다 아이템 자동 수집 - Aura Storage 여는 중")
    auraStorageFrame.Visible = true

    task.wait(0.5)

    if not ShouldContinueSeaItemCollect() then
        StopMacro("AutoSeaItemCollect")
        return
    end

    -- ===== 정렬/필터 버튼 클릭 =====
    -- Aura Storage -> [Position {0.995000005,0},{0.0900000036,0}] Frame ->
    -- [Position {0,0},{0,0}] ImageButton
    local sortOuterFrame = FindChildByPosition(auraStorageFrame, "Frame", 0.995000005, 0.0900000036)
    if not sortOuterFrame then
        warn("[바다 아이템 자동 수집] 정렬 1단계 Frame(0.995000005, 0.0900000036)을 찾지 못함")
    end
    local sortButton = sortOuterFrame and FindChildByPosition(sortOuterFrame, "ImageButton", 0, 0)
    if sortOuterFrame and not sortButton then
        warn("[바다 아이템 자동 수집] 정렬 버튼 ImageButton(0, 0)을 찾지 못함")
    end
    if not sortButton then
        StopMacro("AutoSeaItemCollect")
        return
    end

    SetCurrentAction("바다 아이템 자동 수집 - 정렬 버튼 클릭")
    clickExactly(sortButton)

    task.wait(0.25)

    if not ShouldContinueSeaItemCollect() then
        StopMacro("AutoSeaItemCollect")
        return
    end

    -- ===== AbyssalHunter 아이템 찾아 스크롤 후 클릭 =====
    -- ✅ 정확한 계층 구조가 아직 불확실하므로, Aura Storage 프레임 전체의 자손 중에서
    -- "보이는 ScrollingFrame"을 찾는다(sortOuterFrame 계층에 국한하지 않음).
    local scrollingFrame = nil
    for _, child in ipairs(auraStorageFrame:GetDescendants()) do
        if child:IsA("ScrollingFrame") and child.Visible then
            scrollingFrame = child
            break
        end
    end
    if not scrollingFrame then
        warn("[바다 아이템 자동 수집] 보이는 ScrollingFrame을 찾지 못함")
        StopMacro("AutoSeaItemCollect")
        return
    end

    -- ✅ [치명적 버그 수정] "이름에 AbyssalHunter가 포함된 TextButton을 찾지 못함" -
    -- 실제 구조를 확인해보니 TextButton의 이름 자체는 랜덤 숫자(예: "0.1937184895715945")
    -- 이고, "AbyssalHunter"는 그 버튼의 손자(TextButton -> TextLabel -> AbyssalHunter)
    -- 오브젝트의 이름이었다. 이름이 정확히 "AbyssalHunter"인 자손 오브젝트를 먼저 찾고,
    -- 그 오브젝트의 조상을 거슬러 올라가며 가장 가까운 TextButton을 찾는 방식으로 수정.
    local abyssalHunterButton = nil
    for _, desc in ipairs(scrollingFrame:GetDescendants()) do
        if desc.Name == "AbyssalHunter" then
            local ancestor = desc.Parent
            while ancestor and ancestor ~= scrollingFrame do
                if ancestor:IsA("TextButton") then
                    abyssalHunterButton = ancestor
                    break
                end
                ancestor = ancestor.Parent
            end
            if abyssalHunterButton then break end
        end
    end
    if not abyssalHunterButton then
        warn("[바다 아이템 자동 수집] AbyssalHunter를 포함한 TextButton을 찾지 못함")
        StopMacro("AutoSeaItemCollect")
        return
    end

    SetCurrentAction("바다 아이템 자동 수집 - AbyssalHunter 아이템으로 스크롤 중")
    scrollingFrame.CanvasPosition = Vector2.new(0,
        abyssalHunterButton.AbsolutePosition.Y - scrollingFrame.AbsolutePosition.Y + scrollingFrame.CanvasPosition.Y)

    task.wait(0.25)

    if not ShouldContinueSeaItemCollect() then
        StopMacro("AutoSeaItemCollect")
        return
    end

    SetCurrentAction("바다 아이템 자동 수집 - AbyssalHunter 아이템 클릭")
    clickExactly(abyssalHunterButton)

    task.wait(0.25)

    if not ShouldContinueSeaItemCollect() then
        StopMacro("AutoSeaItemCollect")
        return
    end

    -- ===== 확인 버튼 클릭 =====
    -- Aura Storage -> [Position {0.00499999989,0},{0.0900000036,0}] Frame ->
    -- [Position {0,0},{0.600000024,0}] Frame -> Frame -> [Position {0.5,0},{0.125,0}] ImageButton
    local confirmOuterFrame = FindChildByPosition(auraStorageFrame, "Frame", 0.00499999989, 0.0900000036)
    if not confirmOuterFrame then
        warn("[바다 아이템 자동 수집] 확인 1단계 Frame(0.00499999989, 0.0900000036)을 찾지 못함")
    end
    local confirmMidFrame = confirmOuterFrame and FindChildByPosition(confirmOuterFrame, "Frame", 0, 0.600000024)
    if confirmOuterFrame and not confirmMidFrame then
        warn("[바다 아이템 자동 수집] 확인 2단계 Frame(0, 0.600000024)을 찾지 못함")
    end
    local confirmInnerFrame = confirmMidFrame and confirmMidFrame:FindFirstChildWhichIsA("Frame")
    if confirmMidFrame and not confirmInnerFrame then
        warn("[바다 아이템 자동 수집] 확인 3단계 Frame(임의)을 찾지 못함")
    end
    local confirmButton = confirmInnerFrame and FindChildByPosition(confirmInnerFrame, "ImageButton", 0.5, 0.125)
    if confirmInnerFrame and not confirmButton then
        warn("[바다 아이템 자동 수집] 확인 버튼 ImageButton(0.5, 0.125)을 찾지 못함")
    end
    if not confirmButton then
        StopMacro("AutoSeaItemCollect")
        return
    end

    -- ✅ [사용자 요청] 확인 버튼 하위의 TextLabel.Text가 이미 "Unequip"(이미 장착된
    -- 상태)이면 누를 필요 없이 건너뛴다. "Equip"(장착 안 된 상태)일 때만 눌러서 장착.
    local confirmLabel = confirmButton:FindFirstChildWhichIsA("TextLabel", true)
    if not (confirmLabel and confirmLabel.Text == "Unequip") then
        SetCurrentAction("바다 아이템 자동 수집 - 확인 버튼 클릭")
        clickExactly(confirmButton)

        -- ✅ [치명적 버그 수정] "아우라 장착 직후 Click to Move 설정을 만질 때 설정창이
        -- 안 열림" - 확인 버튼을 클릭한 직후 대기 없이 바로 이동(EnsureClickToMoveMode의
        -- ESC/Tab 메뉴 조작)으로 넘어가서, 아우라 장착 처리/UI 갱신이 아직 끝나지 않은
        -- 상태와 ESC/Tab 입력이 겹쳐 게임 설정 메뉴가 제대로 안 열리는 문제가 있었다
        -- (원래 아우라가 이미 장착된 채로 매크로를 켜면, 이 클릭 자체가 생략되어 문제가
        -- 재현되지 않았던 것과 정확히 일치). 클릭이 실제로 일어났을 때만 짧게 대기해서
        -- UI가 안정될 시간을 준다.
        task.wait(1)
    end

    -- ✅ [사용자 요청] "중간에 다른 아우라가 장착되면 바다에 빠질 수 있음" - 이 아우라를
    -- 낀 채로 바다에서 파밍하는 동안(앞으로 이어질 이동/파밍 로직 포함), 확인 버튼의
    -- 텍스트가 갑자기 "Equip"(장착 해제됨)으로 바뀌면 즉시 다시 눌러서 "Unequip"
    -- (장착) 상태로 되돌리는 백그라운드 감시를 시작한다.
    -- ✅ [치명적 버그 수정] "조금이라도 딜레이가 있으면 바로 바다에 빠짐" - 기존엔
    -- task.wait(0.5)로 0.5초 간격 폴링이었는데, 이러면 최악의 경우 거의 0.5초 동안
    -- 아우라가 해제된 채로 방치될 수 있어 그 사이 바다에 빠질 위험이 있었다.
    -- RunService.Heartbeat(매 프레임마다 실행, 보통 1/60초 이하 간격)로 바꿔서 감지
    -- 지연을 사실상 없앤다.
    getgenv()._SeaItemAuraConfirmButton = confirmButton
    getgenv()._SeaItemAuraWatchActive = true
    if not getgenv()._SeaItemAuraWatchStarted then
        getgenv()._SeaItemAuraWatchStarted = true
        local equipStuckSince = nil
        task.spawn(function()
            while true do
                Services.RunService.Heartbeat:Wait()
                -- ✅ 토글이 꺼지면(매크로 자체가 꺼지면) 감시도 함께 멈춘다.
                if not (Settings.Sols.autoSeaItemCollect and Settings.Sols.masterMacroEnabled) then
                    equipStuckSince = nil
                    continue
                end
                if not getgenv()._SeaItemAuraWatchActive then
                    equipStuckSince = nil
                    continue
                end
                local ok, err = pcall(function()
                    local btn = getgenv()._SeaItemAuraConfirmButton
                    -- ✅ [치명적 버그 수정] "아우라 재장착 중에서 빠져나갈 수 없는 무한
                    -- 루프" - 아이템을 먹는(E키 입력) 타이밍과 캐릭터 재설정이 겹치면,
                    -- 이 시점에 감시 중이던 confirmButton이 죽은(orphaned) 인스턴스로
                    -- 남을 수 있다. 기존엔 btn.Parent만 확인했는데, Parent가 nil이
                    -- 아니어도 실제 게임 트리(DataModel)에서는 이미 떨어져 나간 상태일
                    -- 수 있어서 이 확인만으로는 죽은 참조를 걸러내지 못했다.
                    -- IsDescendantOf(game)으로 실제로 살아있는 인스턴스인지 확인해서,
                    -- 죽은 참조면 감시를 즉시 정리한다.
                    if not (btn and btn:IsDescendantOf(game)) then
                        getgenv()._SeaItemAuraConfirmButton = nil
                        equipStuckSince = nil
                        return
                    end
                    local label = btn:FindFirstChildWhichIsA("TextLabel", true)
                    if label and label.Text == "Equip" then
                        SetCurrentAction("바다 아이템 자동 수집 - 아우라 재장착 중")
                        clickExactly(btn)

                        -- ✅ 원인이 죽은 참조든, UI가 닫혀서 클릭이 서버에 반영이 안
                        -- 되는 상황이든, 근본 원인과 무관하게 "빠져나갈 수 없는 무한
                        -- 루프" 자체를 원천 차단한다. 10초 넘게 계속 클릭해도 여전히
                        -- "Equip" 상태가 안 풀리면 포기하고 감시를 정리한다 - 다음에
                        -- RunAutoSeaItemCollect가 다시 실행되면 새 버튼 참조로 자연스럽게
                        -- 복구된다.
                        if not equipStuckSince then
                            equipStuckSince = tick()
                        elseif (tick() - equipStuckSince) > 10 then
                            warn("[바다 아이템 자동 수집] 아우라 재장착이 10초 넘게 반영되지 않아 포기함")
                            getgenv()._SeaItemAuraConfirmButton = nil
                            equipStuckSince = nil
                        end
                    else
                        equipStuckSince = nil
                    end
                end)
                if not ok then
                    warn("[바다 아이템 자동 수집] 아우라 감시 오류: " .. tostring(err))
                end
            end
        end)
    end

    -- ✅ [안정화] "E키가 실제로 안 먹혔을 때" 같은 인스턴스를 다시 집지 않도록, 이번
    -- 실행에서 포기한(수집 실패로 판정한) FloatingItem 인스턴스를 기록해둔다. 이게
    -- 없으면 workspace:FindFirstChild("FloatingItem")가 매번 같은(고장난) 인스턴스만
    -- 계속 반환해서, 아래에 새로 추가한 타임아웃이 있어도 "포기 -> 다시 그 아이템
    -- 발견 -> 다시 시도 -> 다시 포기"를 무한 반복하게 될 수 있음.
    local seaItemGiveUpSet = {}

    local function findNextCollectableFloatingItem()
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj.Name == "FloatingItem" and not seaItemGiveUpSet[obj] then
                return obj
            end
        end
        return nil
    end

    while ShouldContinueSeaItemCollect() do
        -- ✅ [사용자 요청] "바다 아이템 자동 수집 중이라면, 아우라를 장착 해제한 다음,
        -- Aura 탭을 닫고, Emergency를 실행하게" - 각 FloatingItem 사이클이 시작되는
        -- 시점(아이템을 먹는 도중이 아니라)에서 확인해서, 딱 이 타이밍에만 Emergency
        -- 전용 순서를 거치고 자리를 반납한다.
        if HandleSeaItemEmergencyIfNeeded(auraStorageFrame, confirmButton) then return end

        -- ✅ [안정화] 예전엔 FindFirstChild("FloatingItem")로 아무 인스턴스나 하나
        -- 집어왔는데, 그게 하필 이전에 수집을 계속 실패했던(포기한) 인스턴스일 수 있음
        -- (같은 이름이라 구분이 안 됨). 포기 목록에 없는 것만 골라온다.
        local floatingItem = findNextCollectableFloatingItem()
        if not floatingItem then
            break -- 더 이상 (포기하지 않은) FloatingItem이 없으면 순회 종료
        end

        local itemPos = floatingItem:IsA("BasePart") and floatingItem.Position
            or (floatingItem.PrimaryPart and floatingItem.PrimaryPart.Position)
        if not itemPos then
            seaItemGiveUpSet[floatingItem] = true
            continue
        end

        -- ✅ [사용자 요청] "미니게임 맵에서 진행하는 게 아니므로 이동 방식은 기본값
        -- (다른 기능들이 사용하는 방식)으로" - skipReset 없이 기본 동작(실패 시 캐릭터
        -- 재설정 후 함수 내부에서 최대 3회 자동 재시도)을 그대로 사용한다. 이름이 전부
        -- 같은(FloatingItem) 여러 인스턴스가 있을 수 있으므로 skipCache=true만 유지.
        local movedToItem = MoveToPositionClickStyle(itemPos, "FloatingItem", ShouldContinueSeaItemCollect,
            "바다 아이템 자동 수집", true)
        if not movedToItem then
            -- ✅ [안정화] 이동 자체가 끝내 실패했으면(캐릭터가 도달 못 함) 이 아이템은
            -- 포기하고 순회를 완전히 끝내는 대신 다음 아이템을 계속 찾아본다 - 이동
            -- 실패가 이 아이템 하나만의 문제(예: 파도에 휩쓸려 도달 불가)일 수도 있어서,
            -- 다른 FloatingItem까지 전부 포기할 이유는 없다.
            seaItemGiveUpSet[floatingItem] = true
            if not ShouldContinueSeaItemCollect() then break end
            continue
        end

        if not ShouldContinueSeaItemCollect() then break end

        -- ✅ [안정화] "E키가 실제로 안 먹혔을 때를 대비한 탈출구" - 카메라 직하향 + E키
        -- 입력 + 사라짐 확인을 최대 3번까지 재시도하고, 매 시도마다 최대 4초까지만
        -- 기다린다. 전부 실패하면 이 인스턴스를 포기 목록에 넣고 다음 아이템으로
        -- 넘어간다 - 예전엔 여기서 무한 대기해서 기능 전체가 영구히 멈췄었음.
        local collected = false
        local eKeyAttempt = 0
        while ShouldContinueSeaItemCollect() and not collected and eKeyAttempt < 3 do
            eKeyAttempt = eKeyAttempt + 1

            if not floatingItem.Parent then
                collected = true
                break
            end

            -- ✅ [사용자 요청] 바다 아이템 수집할 때도 화면을 위에서 아래로 내려다보는
            -- 각도가 되게 한다 (다른 기능들과 동일한 기본값: 15스터드).
            -- ✅ [사용자 요청] 카메라 직하향 기준을 내 캐릭터 위치가 아니라 목표
            -- (FloatingItem) 위치로.
            -- ✅ [치명적 버그 수정] 카메라 조작 구간에서 에러가 나도 반드시 복구되도록 pcall로 감쌈.
            SetCurrentAction(string.format("바다 아이템 자동 수집 - 화면 직하향 중 (시도 %d/3)", eKeyAttempt))
            local seaCam = workspace.CurrentCamera
            if seaCam then
                seaCam.CameraType = Enum.CameraType.Scriptable
            end

            pcall(function()
                if seaCam then
                    seaCam.CFrame = CFrame.new(itemPos + Vector3.new(0, 15, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
                end
            end)

            task.wait(1)

            -- ✅ [치명적 버그 수정] "카메라 직하향은 하는데 E키를 안 누름" - 카메라 조작에서
            -- 에러가 나도 E키 입력은 반드시 별도로 시도되도록 완전히 분리된 pcall로 감쌈.
            pcall(function()
                SetCurrentAction(string.format("바다 아이템 자동 수집 - FloatingItem에서 E키 누르는 중 (시도 %d/3)", eKeyAttempt))
                Services.VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                task.wait(0.05)
                Services.VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            end)

            task.wait(1)

            -- ✅ 화면을 위로 향한 상태 그대로 유지, CameraType만 다시 조작 가능하게(다른
            -- 곳들과 동일한 방식).
            if seaCam then
                local seaKeepCFrame = seaCam.CFrame
                seaCam.CameraType = Enum.CameraType.Custom
                seaCam.CFrame = seaKeepCFrame
            end

            if not floatingItem.Parent then
                collected = true
                break
            end

            -- ✅ [안정화] 이 FloatingItem 인스턴스가 사라질 때까지 최대 4초만 기다림
            -- (예전엔 타임아웃이 아예 없어서, E키가 안 먹힌 경우 여기서 영원히 멈췄음).
            SetCurrentAction(string.format("바다 아이템 자동 수집 - 수집 확인 대기 중 (시도 %d/3)", eKeyAttempt))
            local disappearWaitStart = tick()
            while (tick() - disappearWaitStart) < 4 do
                if HandleSeaItemEmergencyIfNeeded(auraStorageFrame, confirmButton) then return end
                if not ShouldContinueSeaItemCollect() then break end
                if not floatingItem.Parent then
                    collected = true
                    break
                end
                task.wait(0.1)
            end
        end

        if not collected then
            warn(string.format("[바다 아이템 자동 수집] FloatingItem 수집 실패 (E키 %d회 시도) - 이 아이템은 건너뜀", eKeyAttempt))
            seaItemGiveUpSet[floatingItem] = true
        end
    end

    -- ✅ 루프가 자연 종료된 시점(더 이상 FloatingItem이 없어서)에 Emergency가 겹쳤을
    -- 경우도, 일반 종료 절차(아우라를 낀 채로 그냥 넘어감) 대신 정확히 아우라 해제
    -- 순서를 거치도록 한 번 더 확인한다.
    if HandleSeaItemEmergencyIfNeeded(auraStorageFrame, confirmButton) then return end

    -- ===== 종료: Aura Storage 닫기 -> 재설정 -> 캐릭터 부활 대기 -> 0.5초 대기 =====
    getgenv()._SeaItemAuraWatchActive = false

    SetCurrentAction("바다 아이템 자동 수집 - Aura Storage 닫는 중")
    if auraStorageFrame then
        auraStorageFrame.Visible = false
    end

    SetCurrentAction("바다 아이템 자동 수집 - 종료 재설정 중")
    local endChar = LocalPlayer.Character
    local didEndReset = false
    if endChar then
        didEndReset = ResetCharacter()
    end

    -- ✅ [치명적 버그 수정] 위 시작부와 동일한 이유 - ResetCharacter()가 실제로
    -- 재설정을 실행했을 때만(true 반환) CharacterAdded를 기다린다. 스킵됐으면
    -- (didEndReset == false) 그 이벤트는 발생하지 않으므로 대기 자체를 건너뛴다.
    if didEndReset then
        SetCurrentAction("바다 아이템 자동 수집 - 종료 캐릭터 부활 대기 중")
        local endCharWaitDone = false
        task.spawn(function()
            pcall(function() LocalPlayer.CharacterAdded:Wait() end)
            endCharWaitDone = true
        end)
        local endCharWaitStart = tick()
        while not endCharWaitDone and (tick() - endCharWaitStart) < 30 do
            task.wait(0.1)
        end
    end

    task.wait(0.5)

    StopMacro("AutoSeaItemCollect")
end

RegisterSingleAction({
    name = "AutoSeaItemCollect",
    logName = "바다 아이템 자동 수집",
    -- ✅ [치명적 버그 수정] AutoMinigame과 동일한 원인 - forceInitialRun의 기본값이
    -- true라서, 매크로를 켜는 순간 실제 신호(FloatingItem 존재 여부)와 무관하게 무조건
    -- 한 번 실행될 수 있었다. "FloatingItem 존재 여부"라는 순수 조건 기반 신호이므로,
