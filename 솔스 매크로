        refs.ObtainedItemsContainer.Visible = hasObtained

        -- ✅ [사용자 요청] "아이템 제작 갯수 : 0개" (한 줄, 콜론+숫자) 대신
        -- "아이템 제작 갯수" / "0개" 두 줄로 분리
