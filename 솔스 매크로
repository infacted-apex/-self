                    end

                    local place3 = scriptParts:FindFirstChild("Place3")
                    if not place3 then
                        place3 = Instance.new("Part")
                        place3.Name = "Place3"
                        place3.Position = Vector3.new(134.22, 92.00, -386.61)
                        place3.Anchored = true
                        place3.CanCollide = false
                        place3.Transparency = 1
                        place3.Parent = scriptParts
                    end
                end)

                -- ✅ [최적화] 매 반복마다 MainInterface 전체를 훑던 스캔 대신, 상태 UI와 공유하는
                -- 캐시 리더를 쓴다(한 번 찾은 라벨을 재사용, 못 찾을 때만 2초에 한 번 재스캔).
                local function findFishStorageCount()
                    return getgenv()._ReadFishStorage()
                end

                -- ✅ [최적화] 판매 루프 한 바퀴에 이 함수가 3번씩 불리는데, 매번 MainInterface 전체를
                -- 훑었다. 한 번 찾은 상점 프레임이 아직 살아있으면 그대로 재사용한다.
                local cachedFishingShopFrame = nil
                local function findFishingShopFrame()
                    local mainUI = game.Players.LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("MainInterface")
                    if not mainUI then return nil end
                    if cachedFishingShopFrame and cachedFishingShopFrame.Parent == mainUI then
                        return cachedFishingShopFrame
                    end
                    cachedFishingShopFrame = nil
                    for _, v in ipairs(mainUI:GetChildren()) do
                        if v:IsA("Frame") then
                            local hasFishingShop = false
                            for _, desc in ipairs(v:GetDescendants()) do
                                if desc:IsA("TextLabel") and string.find(string.lower(desc.Text), "fishing shop") then
                                    hasFishingShop = true
                                    break
                                end
                            end
                            if hasFishingShop then
                                cachedFishingShopFrame = v
                                return v
                            end
                        end
                    end
                    return nil
                end

                -- ✅ [최적화] 캐스트 버튼 찾기: 예전엔 매 반복마다 MainInterface의 모든 자손을 훑었다.
                -- 지난번에 버튼을 찾았던 낚시 HUD(배경 투명도 0.4 ImageLabel)를 기억해뒀다가 그 안을
                -- 먼저 찾아보고, 거기 없을 때만 예전과 똑같은 전체 탐색을 한다(찾는 조건은 동일).
                local cachedCastRoot = nil
                local function tryClickCastButtonIn(img1)
                    for _, img2 in ipairs(img1:GetDescendants()) do
                        if img2:IsA("ImageLabel") then
                            local textCount = 0
                            for _, ch2 in ipairs(img2:GetChildren()) do
                                if ch2:IsA("TextLabel") then
                                    textCount = textCount + 1
                                end
                            end

                            if textCount == 4 then
                                for _, img3 in ipairs(img2:GetDescendants()) do
                                    if img3:IsA("ImageLabel") and img3:FindFirstChildWhichIsA("UIListLayout") then
                                        for _, btn in ipairs(img3:GetChildren()) do
                                            if btn:IsA("ImageButton") and btn.LayoutOrder == 0 then
                                                clickExactly(btn)
                                                return true
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                    return false
                end

                local function doFlexibility()
                    -- ✅ [사용자 요청] 아무 신호도 없으면 Flexibility 자체를 완전히 무시하고
                    -- 그냥 진행한다. IsFlexibilityState를 켰다 끄는 오버헤드조차 없이
                    -- 신호가 있을 때만 실제로 "Flexibility가 된다".
                    -- ✅ [치명적 버그 수정] "Merchant가 와도 낚시 중이면 절대 안 비켜줌" -
                    -- 이 함수가 IsAnySingleActionSignaled()(모든 단일성 기능을 자동으로
                    -- 포함하는 통합 함수)를 쓰지 않고, MemoryMatch/AutoItemUse/PotionCraft
                    -- 세 가지만 직접 하드코딩해서 확인하고 있었다. 그래서 나중에 추가된
                    -- MerchantBuy(상인 자동 구매) 신호는 여기서 완전히 누락되어, 낚시가
                    -- 물고기를 낚는 도중(입질 대기 등, 이 함수가 반복 호출되는 구간)에는
                    -- 상인이 도착해도 절대 자리를 비켜주지 않았다. 통합 함수 하나로
                    -- 일원화해서, 앞으로 새 단일성 기능이 추가돼도 이 지점을 놓치지 않게 한다.
                    local hasAnySignal = Settings.Emergency or IsAnySingleActionSignaled()

                    if not hasAnySignal then
                        return false
                    end

                    getgenv().IsFlexibilityState = true

                    if Settings.Emergency then
                        Settings.EmergencyReady = true
                        -- ✅ [버그 수정] 무한 루프 방지용 넉넉한 리미트 (최대 10분)
                        local emergencyWaitStart = tick()
                        while Settings.Emergency and (tick() - emergencyWaitStart) < 600 do
                            task.wait(0.5)
                        end
                        Settings.EmergencyReady = false
                    end

                    -- ✅ [사용자 요청] Memory Match/Potion Craft 등 단일성 행동이 진행 중이거나
                    -- 곧 시작할 신호가 있으면 낚시가 자리를 반납하고, 그 기능이 끝날 때
                    -- 넘겨받는다 (직접 실행하지 않음 - 실행 주체는 각자의 감시 루프뿐이라
                    -- 이중 실행이 구조적으로 불가능함)
                    --
                    -- ✅ [버그 수정] Auto Item Use는 이제 독립 루프(파일 앞쪽)가 낚시 활성
                    -- 여부와 무관하게 타이머로 직접 판단하고 실행까지 전담하므로, 여기서
                    -- 따로 다시 실행하지 않는다 (중복 실행 방지, 실행 주체 단일화).
                    YieldFishingForSingleActions()

                    getgenv().IsFlexibilityState = false

                    -- ✅ [치명적 버그 수정] 다른 단일성 행동(포션 제작 등)이 자리를 쥐고
                    -- 있었던 동안 캐릭터를 완전히 다른 위치(Place4/5 등)로 이동시켰을 수
                    -- 있음. 그런데 기존엔 여기서 자리를 넘겨줬다 되찾은 뒤, 이동 로직을
                    -- 전혀 다시 거치지 않고 "물고기 잡히길 기다리는" 지점부터 그대로
                    -- 이어갔음 - 그러면 낚시가 전혀 다른 위치에 있는데도 그 자리에서
                    -- 아무 반응 없이 영원히 멈춰있는 것처럼 보였음. 실제로 양보가
                    -- 일어났다면(hasAnySignal=true) true를 반환해서, 호출부가 처음
                    -- (이동 단계)부터 다시 시작하게 한다.
                    return true
                end

                while Settings.Sols.autoFishActive do
                    -- ✅ [사용자 요청] 판매 타임아웃으로 인한 재시작 요청 플래그 초기화
                    -- (이 지점에 도달했다는 건 이미 재시작이 반영된 것이므로 플래그를 내림)
                    if getgenv().FishRestartRequested then
                        getgenv().FishRestartRequested = false
                    end
                    if getgenv().MemoryMatchActive or (getgenv().CurrentActiveFeature and getgenv().CurrentActiveFeature ~= "Fishing") then
                        SetCurrentAction("낚시 - 다른 기능 진행 중, 대기")
                        task.wait(0.5)
                        continue
                    end

                    -- ✅ [버그 수정] 새 캐스팅 사이클을 시작하기 전에 통합 신호를 먼저 체크한다.
                    -- (자리를 잡기도 전에 확인해서, 신호가 있으면 아예 ESC/Tab 메뉴 조작이나
                    -- 이동을 시작조차 하지 않게 함 - 이게 없으면 낚시가 메뉴 조작/이동을 이미
                    -- 시작한 뒤에야 신호를 발견해서 캐릭터 리셋과 겹치는 사고가 났었음)
                    if IsAnySingleActionSignaled() then
                        SetCurrentAction("낚시 - 다른 기능에 자리 확인 중")
                        task.wait(0.5)
                        continue
                    end

                    SetCurrentAction("낚시 - 캐스팅 준비 중")
                    StartMacro("Fishing")
                    -- ✅ [치명적 버그 수정] StartMacro가 실패(다른 게 이미 자리를 쥐고 있음)
                    -- 했을 가능성을 확인 안 하고 그냥 진행하면, 자리 없이 이동/캐스팅 로직이
                    -- 실행되며 이동이 씹히는 문제가 생김. 실패했으면 이번 반복은 건너뛴다.
                    if not MacroPriority.IsActive.Fishing then
                        SetCurrentAction("낚시 - 자리를 못 잡아 대기")
                        task.wait(0.5)
                        continue
                    end
                    local lastActivityTime = tick()

                    -- ✅ [안정화] 예전엔 여기서 매 사이클마다 ESC/Tab 메뉴를 직접 열고 닫으며 클릭
                    -- 이동 모드를 확인했는데, (1) 메뉴가 실제로 열려있는지 확인하지 않고 ESC를 눌러서
                    -- 한 번 어긋나면 계속 반대로 뒤집혔고, (2) 방향키 탐색에 한 번 실패하면 매크로
                    -- 전체를 몰래 꺼버리면서(토글 UI는 켜진 채로) 낚시까지 완전히 종료됐다(오래 켜두면
                    -- "낚시가 그냥 멈춰있는" 증상). 바로 아래 Place1/Place2 이동(MoveToPositionClickStyle)
                    -- 이 매 시도마다 공통 함수 EnsureClickToMoveMode(메뉴 상태 확인 + 실패 시 재시도)로
                    -- 이미 같은 확인/전환을 하므로 이 중복 블록은 제거한다.
                    local proceed = true

                    if proceed and Settings.Sols.autoFishActive then
                        while Settings.Sols.autoFishActive and not getgenv().FishRestartRequested do
                            if getgenv().MemoryMatchActive then
                                task.wait(0.5)
                                continue
                            end

                            -- ✅ [사용자 요청] Memory Match/Potion Craft/Auto Item Use 중
                            -- 뭐라도 가능할 경우 낚시 투척보다 먼저 우선 실행되도록 통합 체크
                            -- (직접 실행하지 않고, 신호가 사라질 때까지 기다리기만 함)
                            if Settings.Sols and Settings.Sols.masterMacroEnabled then
                                YieldFishingForSingleActions()
                                if getgenv().MemoryMatchActive then
                                    task.wait(0.5)
                                    continue
                                end
                            end

                            -- ✅ [치명적 버그 수정] YieldFishingForSingleActions()가 자리를
                            -- 넘겨줬다가 다시 되찾는데, 그 결과(진짜로 자리를 되찾았는지)를
                            -- 확인 안 하고 곧바로 아래 이동/캐스팅 로직으로 진입했었음. 그러면
                            -- 낚시가 자리를 아직 못 쥔 상태에서 이동 클릭 로직이 실행되면서
                            -- 이동 명령이 씹히거나 스킵되는 문제가 있었음("다른 기능을 하고
                            -- 다시 낚시로 돌아올 때 이동을 안 하는" 증상의 원인). 자리를
                            -- 진짜로 쥐고 있을 때까지 여기서 기다린다.
                            while Settings.Sols.autoFishActive and not MacroPriority.IsActive.Fishing do
                                SetCurrentAction("낚시 - 다른 기능에 자리 확인 중")
                                task.wait(0.5)
                                if IsAnySingleActionSignaled() then
                                    YieldFishingForSingleActions()
                                else
                                    StartMacro("Fishing")
                                end
                            end
                            if not Settings.Sols.autoFishActive then break end

                            if tick() - lastActivityTime > 180 then
                                break
                            end

                            -- ! - 1
                            SetCurrentAction("낚시 - Place1에서 낚싯대 던지는 중")
                            -- ✅ [치명적 버그 수정] "이동 방식 및 Click to Move 설정이
                            -- 자동 낚시가 사용하는 방식을 그대로 따라가지 않음" - 정확히는
                            -- 반대였다. 낚시의 Place1 캐스팅 이동이, 다른 기능들(레어
                            -- 바이옴, 메모리 매치, 오토 미니게임, 바다 아이템 자동 수집)이
                            -- 전부 쓰는 공통 함수 MoveToPositionClickStyle(EnsureClickToMoveMode
                            -- 포함, 스페이스바 재시도, 5스터드 반경 3초 유지 판정, 최대 3회
                            -- 재시도)를 안 쓰고, 훨씬 예전 방식(EnsureClickToMoveMode 자체를
                            -- 호출하지 않고 카메라만 조작, 단순 3초 정지 판정)을 그대로 쓰고
                            -- 있었다. 완전히 공통 함수로 교체해서 모든 이동 로직이 동일한
                            -- 방식을 따르게 한다. (기존에 local p1이 완전히 똑같이 두 번
                            -- 선언되어 있던 잔여 버그도 함께 정리)
                            local p1 = workspace:FindFirstChild("ScriptParts") and
                                workspace.ScriptParts:FindFirstChild("Place1")
                            local place1TargetPos = p1 and p1.Position or Vector3.new(72.6785, 87.0000, -351.9299)

                            local function shouldContinueFishing()
                                return Settings.Sols.autoFishActive
                            end

                            local touched = MoveToPositionClickStyle(place1TargetPos, "Place1", shouldContinueFishing,
                                "낚시")
                            lastActivityTime = tick() -- [ACT] Phase1 cast

                            local skipToPhase2 = not touched
                            if skipToPhase2 then
                                -- MoveToPositionClickStyle이 이미 실패 시 재설정/대기까지 마치고
                                -- 왔으므로, 여기서는 그냥 다음 단계로 넘어간다.
                            end

                            if not skipToPhase2 then
                                task.wait(1)

                                -- ! - Flexibility
                                local didYield = doFlexibility()

                                -- ✅ [치명적 버그 수정] doFlexibility() 안에서 다른 기능(메모리
                                -- 매치/포션 제작/아이템 사용)에게 자리를 넘겨줬다가 다시 되찾는데,
                                -- doFlexibility()를 부른 쪽은 그 결과(진짜로 자리를 되찾았는지)를
                                -- 확인 안 하고 그냥 아래 while 루프로 진입했었음. 그러면 실제로는
                                -- 아직 Place1에 도착도 못 했거나 자리가 없는 상태인데 "물고기
                                -- 잡히길 기다리는 중"이라고 표시되며 그 다음 로직을 진행해버리는
                                -- 문제가 있었음. 자리를 진짜로 쥐고 있을 때까지 여기서 기다린다.
                                while Settings.Sols.autoFishActive and not MacroPriority.IsActive.Fishing do
                                    SetCurrentAction("낚시 - 다른 기능에 자리 확인 중")
                                    task.wait(0.5)
                                    if IsAnySingleActionSignaled() then
                                        YieldFishingForSingleActions()
                                    else
                                        StartMacro("Fishing")
                                    end
                                end
                                if not Settings.Sols.autoFishActive then continue end

                                -- ✅ [치명적 버그 수정] 다른 단일성 행동에게 실제로 자리를
                                -- 넘겨줬다 되찾았다면(didYield=true), 그 사이 캐릭터가 완전히
                                -- 다른 위치(예: 포션 제작의 Place4/5)로 이동됐을 수 있음. 여기서
                                -- 그대로 "물고기 잡히길 기다리는" 단계로 진입하면 낚시가 전혀
                                -- 엉뚱한 위치에서 아무 반응 없이 멈춰있는 것처럼 보임. 이동
                                -- 단계(! - 1)부터 처음부터 다시 시작한다.
                                if didYield then
                                    SetCurrentAction("낚시 - 다른 기능 종료, 이동부터 재시작")
                                    continue
                                end

                                while Settings.Sols.autoFishActive and not getgenv().FishRestartRequested do
                                    if getgenv().MemoryMatchActive then
                                        task.wait(0.5)
                                        continue
                                    end
                                    if tick() - lastActivityTime > 180 then
                                        break
                                    end

                                    SetCurrentAction("낚시 - 물고기 잡히길 기다리는 중")
                                    local n1, n2 = findFishStorageCount()
                                    if n1 ~= -1 and n1 == n2 then
                                        break
                                    end

                                    local mainUI = game.Players.LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild(
                                        "MainInterface")
                                    if mainUI then
                                        local clicked = false
                                        local rootImageLabel = nil
                                        if cachedCastRoot and cachedCastRoot.Parent and cachedCastRoot:IsDescendantOf(mainUI)
                                            and math.abs(cachedCastRoot.BackgroundTransparency - 0.4) < 0.01 then
                                            if tryClickCastButtonIn(cachedCastRoot) then
                                                clicked = true
                                                rootImageLabel = cachedCastRoot
                                            end
                                        end
                                        if not clicked then
                                            for _, img1 in ipairs(mainUI:GetDescendants()) do
                                                if img1:IsA("ImageLabel") and math.abs(img1.BackgroundTransparency - 0.4) < 0.01 then
                                                    rootImageLabel = img1
                                                    if tryClickCastButtonIn(img1) then
                                                        clicked = true
                                                        cachedCastRoot = img1
                                                        break
                                                    end
                                                end
                                            end
                                        end

                                        if rootImageLabel and clicked then
                                            SetCurrentAction("낚시 - 물고기를 낚는 중")
                                            local targetTextLabel = nil
                                            local waitStart = tick()
                                            local safe1Trigger = false

                                            while Settings.Sols.autoFishActive and not getgenv().FishRestartRequested do
                                                if getgenv().MemoryMatchActive then
                                                    task.wait(0.5)
                                                    continue
                                                end
                                                if tick() - waitStart > 30 then
                                                    safe1Trigger = true
                                                    break
                                                end
                                                targetTextLabel = nil
                                                for _, subImg1 in ipairs(rootImageLabel:GetDescendants()) do
                                                    if subImg1:IsA("ImageLabel") then
                                                        local imgCount = 0
                                                        for _, c in ipairs(subImg1:GetChildren()) do
                                                            if c:IsA("ImageLabel") then imgCount = imgCount + 1 end
                                                        end
                                                        if imgCount == 3 then
                                                            for _, subImg2 in ipairs(subImg1:GetDescendants()) do
                                                                if subImg2:IsA("ImageLabel") then
                                                                    local txtCount = 0
                                                                    for _, c in ipairs(subImg2:GetChildren()) do
                                                                        if c:IsA("TextLabel") then
                                                                            txtCount = txtCount +
                                                                                1
                                                                        end
                                                                    end
                                                                    if txtCount == 2 then
                                                                        for _, t in ipairs(subImg2:GetChildren()) do
                                                                            if t:IsA("TextLabel") and t.Text == "Click / Touch Screen to Reel" then
                                                                                targetTextLabel = t
                                                                                break
                                                                            end
                                                                        end
                                                                    end
                                                                end
                                                                if targetTextLabel then break end
                                                            end
                                                        end
                                                    end
                                                    if targetTextLabel then break end
                                                end

                                                if targetTextLabel and math.abs(targetTextLabel.Position.X.Scale) < 0.01 and math.abs(targetTextLabel.Position.X.Offset) < 0.01 and math.abs(targetTextLabel.Position.Y.Scale) < 0.01 and math.abs(targetTextLabel.Position.Y.Offset) < 0.01 then
                                                    break
                                                end
                                                task.wait(0.1)
                                            end

                                            if safe1Trigger then
                                                -- Fallthrough to Safe 1
                                            else
                                                local function getRepeatA1BarAndZone(root)
                                                    local threeImgParent = nil
                                                    for _, subImg1 in ipairs(root:GetDescendants()) do
