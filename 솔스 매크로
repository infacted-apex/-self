-- ✅ [사용자 요청] A/B 경로를 찾는 헬퍼들.
--   A: PlayerGui 안에서 DisplayOrder==3000이고 Enabled==true인 ScreenGui 안의,
--      AnchorPoint==(1,0.5)인 Frame
--   B: PlayerGui.MainInterface.Dialog.Choices
local function FindMerchantFrameA()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    for _, gui in ipairs(playerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.DisplayOrder == 3000 and gui.Enabled == true then
            for _, frame in ipairs(gui:GetChildren()) do
                if frame:IsA("Frame") and frame.AnchorPoint == Vector2.new(1, 0.5) then
                    return frame
                end
            end
        end
    end
    return nil
end

local function FindDialogChoices()
    local mainInterface = LocalPlayer.PlayerGui:FindFirstChild("MainInterface")
    local dialog = mainInterface and mainInterface:FindFirstChild("Dialog")
    return dialog and dialog:FindFirstChild("Choices")
end

-- ✅ [사용자 요청] "인벤토리를 열고, 아이템을 1번 사용하는 로직도 병합" - 상인 자동 구매의
-- "인벤토리 열기 -> Merchant Teleporter 1개 사용 -> 인벤토리 닫기" 패턴을 그대로 뽑아낸
-- 공통 함수. 이미 인벤토리가 열려있으면 여는 단계는 건너뛴다(다른 곳과 동일한 동작).
-- itemName/useAmountNum: useSpecificItemByNameWithAmount에 그대로 전달할 아이템 이름과
-- 사용 개수. shouldContinueFn: 인자 없이 호출해 "지금 계속 진행해도 되는가"를 반환하는
-- 함수(선택, 안 넘기면 항상 진행). actionLabel: 상태 UI에 표시할 현재 행동 설명.
-- 반환값: 실제로 아이템을 사용했으면 true, 인벤토리를 못 열었거나 Items 탭에서 아이템을
-- 못 찾았으면 false.
local function OpenInventoryAndUseItemOnce(itemName, useAmountNum, shouldContinueFn, actionLabel)
    local function shouldContinue()
        if shouldContinueFn then return shouldContinueFn() end
        return true
    end

    local mainInterface = LocalPlayer.PlayerGui:FindFirstChild("MainInterface")
    local inventory = mainInterface and mainInterface:FindFirstChild("Inventory")
    if not inventory then return false end

    -- 인벤토리가 이미 열려있으면 여는 단계는 스킵
    if not inventory.Visible then
        local sideButtons = mainInterface:FindFirstChild("SideButtons")
        if sideButtons then
            for _, btn in ipairs(sideButtons:GetChildren()) do
                if btn.Name == "TextButton" and btn:FindFirstChild("Usage") and btn.Usage.Text == "Inventory" then
                    SetCurrentAction(string.format("%s - 인벤토리 여는 중", actionLabel or ""))
                    clickExactly(btn)
                    task.wait(0.5)
                    break
                end
            end
        end
    end
    if not inventory.Visible or not shouldContinue() then return false end
    task.wait(0.3)

    -- ✅ [버그 수정] "물고기를 다 팔고 나면 상인 자동 구매가 안 됨" - 이 함수만 인벤토리를 연 뒤
    -- "Items" 탭(ItemsTab)을 누르지 않았다(레어 바이옴 팝핑/오토 아이템 사용은 누르고 있었음).
    -- 물고기 판매 등으로 인벤토리 목록이 다른 탭(물고기 등)에 가 있으면 Merchant Teleporter가
    -- 목록에 없어서 못 찾았다. 게다가 못 찾아도 무조건 "사용했다(true)"고 반환해서, 상인 구매가
    -- 텔레포트도 안 된 채로 대화창을 1분 동안 헛되이 기다리다 끝났다.
    -- 이제 항상 Items 탭을 누르고, 아이템이 목록에 실제로 나타날 때까지 확인한 뒤 사용하며,
    -- 실제로 사용했을 때만 true를 반환한다. 탭 클릭이 한 번 씹힐 수 있으니 못 찾으면 한 번 더
    -- 탭을 누르고 다시 확인한다.
    local function findItemInGrid()
        local grid = inventory:FindFirstChild("Items") and inventory.Items:FindFirstChild("ItemGrid") and
            inventory.Items.ItemGrid:FindFirstChild("ItemGridScrollingFrame")
        return grid and getgenv()._FindInventoryItemByName(grid, itemName) ~= nil
    end

    local found = false
    for attempt = 1, 2 do
        if not shouldContinue() then break end
        local itemsTab = inventory:FindFirstChild("Items") and inventory.Items:FindFirstChild("ItemsTab")
        if itemsTab then
            SetCurrentAction(string.format("%s - Items 탭 선택 중", actionLabel or ""))
            clickExactly(itemsTab)
            task.wait(0.3)
        end
        -- 탭 전환/정렬 직후엔 목록이 바로 안 채워질 수 있어서 최대 3초까지 확인
        local waitStart = tick()
        while (tick() - waitStart) < 3 do
            if findItemInGrid() then
                found = true
                break
            end
            task.wait(0.25)
        end
        if found then break end
    end

    local used = false
    if found and shouldContinue() then
        SetCurrentAction(string.format("%s - %s 사용", actionLabel or "", itemName))
        used = useSpecificItemByNameWithAmount(itemName, useAmountNum) == true
    elseif not found then
        warn(string.format("[%s] 인벤토리 Items 탭에서 '%s'을(를) 찾지 못함", actionLabel or "아이템 사용", itemName))
    end

    -- ✅ [사용자 요청] 인벤토리를 안 닫는 문제 - 사용 후 0.25초 뒤에 닫는다.
    task.wait(0.25)
    if inventory and inventory.Visible then
        inventory.Visible = false
    end

    return used
end

-- ✅ [사용자 요청] "여러 아이템을 사용할 때는 열고-쓰고-쓰고-닫고 방식이어야" - 레어
-- 바이옴 자동 팝핑/오토 아이템 사용에서 확인한, "인벤토리를 딱 한 번 열고 여러 아이템을
-- 순회하며 사용한 뒤 마지막에 한 번만 닫는" 패턴을 범용 공통 함수로 뽑아낸다.
-- items: { {name=아이템명, amount=개수(선택, 기본 useSpecificItemByName 방식으로 있으면
--          바로 사용), condition=function(hasItem, getAmount) -> bool(선택)}, ... } 배열.
--   condition이 있는 항목은 "배타적 우선순위 트리"로 취급해 - 그 중 조건을 만족하는
--   첫 항목 하나만 사용하고 그 즉시 순회를 멈춘다(레어 바이옴의 CYBERSPACE와 동일한 규칙).
--   condition이 없는 항목은 "독립 목록"으로 취급해 - hasItem으로 보유 여부만 확인하고
--   있으면 사용한 뒤 계속 다음 항목으로 순회한다(GLITCHED/DREAMSPACE와 동일한 규칙).
-- shouldContinueFn: 인자 없이 호출해 "지금 계속 진행해도 되는가"를 반환하는 함수(선택).
-- actionLabel: 상태 UI에 표시할 현재 행동 설명.
-- 반환값: 인벤토리를 열어서 순회를 실제로 진행했으면 true, 못 열었으면 false.
local function OpenInventoryAndUseItems(items, shouldContinueFn, actionLabel, closeDelaySeconds)
    local function shouldContinue()
        if shouldContinueFn then return shouldContinueFn() end
        return true
    end

    local mainInterface = LocalPlayer.PlayerGui:FindFirstChild("MainInterface")
    local inventory = mainInterface and mainInterface:FindFirstChild("Inventory")
    if not inventory then return false end

    -- 1. 인벤토리 열기 (이미 열려있으면 스킵)
    if not inventory.Visible then
        local sideButtons = mainInterface:FindFirstChild("SideButtons")
        if sideButtons then
            for _, btn in ipairs(sideButtons:GetChildren()) do
                if btn.Name == "TextButton" and btn:FindFirstChild("Usage") and btn.Usage.Text == "Inventory" then
                    SetCurrentAction(string.format("%s - 인벤토리 여는 중", actionLabel or ""))
                    clickExactly(btn)
                    task.wait(0.5)
                    break
                end
            end
        end
    end
    if not inventory.Visible or not shouldContinue() then return false end
    task.wait(0.3)

    -- ItemsTab 클릭 (레어 바이옴/오토 아이템 사용과 동일)
    local itemsTab = inventory:FindFirstChild("Items") and inventory.Items:FindFirstChild("ItemsTab")
    if itemsTab then clickExactly(itemsTab) end
    task.wait(0.3)
    if not shouldContinue() then
        if inventory.Visible then inventory.Visible = false end
        return false
    end

    -- 아이템 정렬 대기 (레어 바이옴 자동 팝핑과 동일하게 2초)
    task.wait(2)
    if not shouldContinue() then
        if inventory.Visible then inventory.Visible = false end
        return false
    end

    -- ✅ hasItem/getAmount는 정확 일치(exact match) 기준으로 인벤토리를 확인한다
    -- (이름이 겹치는 다른 아이템을 잘못 집는 걸 방지 - 다른 곳과 동일한 방식).
    local function hasItem(itemName)
        local scrollingFrame = inventory:FindFirstChild("Items") and inventory.Items:FindFirstChild("ItemGrid") and
            inventory.Items.ItemGrid:FindFirstChild("ItemGridScrollingFrame")
        if not scrollingFrame then return false end
        return getgenv()._FindInventoryItemByName(scrollingFrame, itemName) ~= nil
    end

    local function getAmount(itemName)
        local scrollingFrame = inventory:FindFirstChild("Items") and inventory.Items:FindFirstChild("ItemGrid") and
            inventory.Items.ItemGrid:FindFirstChild("ItemGridScrollingFrame")
        if not scrollingFrame then return 0 end
        local item = getgenv()._FindInventoryItemByName(scrollingFrame, itemName)
        if item then
            local btn = item:FindFirstChild("Button")
            if btn and btn:FindFirstChild("ItemAmount") then
                local txt = btn.ItemAmount.Text
                local num = txt:match("x(%d+)")
                if num then return tonumber(num) end
            end
            return 1
        end
        return 0
    end

    -- 2. 여러 아이템 순회하며 사용 (닫지 않고 계속)
    for _, entry in ipairs(items) do
        if not shouldContinue() then break end

        -- ✅ entry.enabled == false면 UI 토글로 꺼둔 항목이니 완전히 건너뛴다
        -- (레어 바이옴 자동 팝핑의 개별 포션 온/오프 토글과 동일한 규칙).
        if entry.enabled ~= false then
            local shouldUse
            if entry.condition then
                shouldUse = entry.condition(hasItem, getAmount)
            else
                shouldUse = hasItem(entry.name)
            end

            if shouldUse then
                SetCurrentAction(string.format("%s - %s 사용", actionLabel or "", entry.name))
                local amountToUse = entry.amount
                if type(amountToUse) == "function" then
                    amountToUse = amountToUse(hasItem, getAmount)
                end
                if amountToUse then
                    useSpecificItemByNameWithAmount(entry.name, amountToUse)
                else
                    useSpecificItemByName(entry.name)
                end

                -- ✅ condition이 있는 항목(배타적 우선순위 트리)은 하나만 쓰고 즉시 멈춘다.
                -- condition이 없는 항목(독립 목록)은 계속 다음 항목으로 순회한다.
                if entry.condition then
                    break
                end
            end
        end
    end

    -- 3. 마지막에 딱 한 번만 닫기
    task.wait(closeDelaySeconds or 0.5)
    if inventory and inventory.Visible then
        inventory.Visible = false
    end

    return true
end

local RunAutoMerchantBuy
do
    -- ✅ [버그 수정] "상인 자동 구매 후 재설정을 안 함" - 텔레포트한 뒤 중간에 실패해서
    -- 빠져나가는 경로들(대화 선택지 미발견, Open 버튼 없음 등)은 재설정 없이 그냥 끝나서
    -- 캐릭터가 상인 앞에 그대로 남았다. 텔레포트를 했으면 어느 경로로 끝나든 반드시
    -- 강제 재설정하고 나서 자리를 반납한다.
    local merchantTeleported = false
    local function StopMerchantBuyCleanly()
        if merchantTeleported then
            merchantTeleported = false
            SetCurrentAction("상인 자동 구매 - 복귀 재설정 중")
            ResetCharacter(true)
            task.wait(3)
        end
        getgenv().MerchantBuyWantsSlot = false
        StopMacro("MerchantBuy")
        SetCurrentAction("")
    end

    RunAutoMerchantBuy = function()
        if not CanStartMacro("MerchantBuy") then return end
        StartMacro("MerchantBuy")
        SetCurrentAction("상인 자동 구매 - 시작")

        local merchantName = getgenv().MerchantBuyMerchantName or "Mari"
        -- ✅ 신호는 한 번 소모하면 다시 뜰 때까지 꺼둔다 (같은 도착 로그로 반복 실행되지 않도록)
        getgenv().MerchantBuyWantsSlot = false

        -- ===== 자리 확보 및 상인에게 텔레포트 =====
        -- ✅ [사용자 요청] "인벤토리를 열고 아이템을 1번 사용하는 로직 병합" - 공통 함수
        -- OpenInventoryAndUseItemOnce로 대체 (기존 동작과 완전히 동일).
        local usedTeleporter = OpenInventoryAndUseItemOnce("Merchant Teleporter", 1, nil, "상인 자동 구매")
        if not usedTeleporter then
            StopMerchantBuyCleanly()
            return
        end
        merchantTeleported = true

        task.wait(3)

        -- ===== 대화창을 통해 상점 열기 =====
        SetCurrentAction("상인 자동 구매 - 대화 여는 중 (E)")

        -- ✅ [사용자 요청] E키 입력 앞뒤로 1초 간격 동안 화면이 위에서 아래를 내려다보는
        -- 각도가 되게 한다 (다른 파트 우클릭 이동 때와 동일한 스타일: 캐릭터 위치 위에서
        -- CFrame.Angles(math.rad(-90), 0, 0)으로 수직 아래를 봄).
        -- ✅ [치명적 버그 수정] "Click to Move가 켜져 있어도 작동 안 함, 매크로를 꺼도
        -- 계속 안 됨" - 카메라를 Scriptable로 바꾼 뒤 복구하기 전 구간에서 에러가 나면
        -- 카메라가 영원히 Scriptable로 고정되어 플레이어 조작이 먹통이 되는 문제가
        -- 있었다. 이 구간 전체를 pcall로 감싸서, 에러가 나도 아래에서 반드시 복구한다.
        local cam = workspace.CurrentCamera
        if cam then
            cam.CameraType = Enum.CameraType.Scriptable
        end

        pcall(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if cam and hrp then
                cam.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 15, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
            end
        end)

        task.wait(1)

        -- ✅ [치명적 버그 수정] "카메라 직하향은 하는데 E키를 안 누름" - 카메라 조작에서
        -- 에러가 나도 E키 입력은 반드시 별도로 시도되도록 완전히 분리된 pcall로 감쌈.
        pcall(function()
            local vim = Services.VirtualInputManager
            vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(0.05)
            vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)

            task.wait(1)
        end)

        -- ✅ [사용자 요청] "위에서 아래쪽으로 보게 만들고, 그 상태로 캠을 움직일 수
        -- 있어야 함" - CameraType을 원래(Custom)로 되돌려 사용자가 다시 마우스로 카메라를
        -- 조작할 수 있게 하되, CFrame(위→아래를 보는 각도)은 그대로 유지해서 전환 순간에
        -- 갑자기 원래 각도로 튀지 않게 한다.
        if cam then
            local keepCFrame = cam.CFrame
            cam.CameraType = Enum.CameraType.Custom
            cam.CFrame = keepCFrame
        end

        -- Choices 안에서 TextButton이 생길 때까지 대기 (이름은 랜덤, ClassName만 TextButton)
        SetCurrentAction("상인 자동 구매 - 대화 선택지 대기 중")
        local choices = nil
        local openButton = nil
        local waitStart = tick()
        -- ✅ [사용자 요청] 타임아웃을 15초 -> 60초(1분)로 변경
        while (tick() - waitStart) < 60 do
            choices = FindDialogChoices()
            if choices then
                for _, child in ipairs(choices:GetChildren()) do
                    if child.ClassName == "TextButton" then
                        openButton = child
                        break
                    end
                end
            end
            if openButton then break end
            task.wait(0.2)
            if not Settings.Sols.autoMerchantBuy or not Settings.Sols.masterMacroEnabled then
                StopMerchantBuyCleanly()
                return
            end
        end

        if not (choices and openButton) then
            StopMerchantBuyCleanly()
            return
        end

        task.wait(0.5)

        -- TextButton 중 Text가 "Open"인 것을 찾아 클릭
        local openTextButton = nil
        for _, child in ipairs(choices:GetChildren()) do
            if child.ClassName == "TextButton" and child.Text == "Open" then
                openTextButton = child
                break
            end
        end
        if not openTextButton then
            StopMerchantBuyCleanly()
            return
        end

        SetCurrentAction("상인 자동 구매 - Open 클릭")
        -- ✅ [사용자 요청] 다이얼로그 선택지가 나오면 바로 클릭하지 말고 0.25초 대기 후 클릭
        task.wait(0.25)
        clickExactly(openTextButton)

        task.wait(3)

        -- ===== 사용자가 고른 항목들 구매하기 =====
        SetCurrentAction("상인 자동 구매 - 구매 루프")
        -- ✅ [사용자 요청] 이미 한번 구매한 아이템은 다시 구매하지 않도록, 이번 상인
        -- 방문 동안 구매 완료한 storageKey를 기억해둔다.
        local alreadyBought = {}
        while true do
            if not Settings.Sols.autoMerchantBuy or not Settings.Sols.masterMacroEnabled then
                break
            end

            local frameA = FindMerchantFrameA()
            if not frameA then break end

            -- Position 값이 {0.5,0},{0.99000001,0} 인 Frame - ScrollingFrame
            local shopListFrame = nil
            for _, f in ipairs(frameA:GetChildren()) do
                if f:IsA("Frame")
                    and math.abs(f.Position.X.Scale - 0.5) < 0.001
                    and math.abs(f.Position.Y.Scale - 0.99000001) < 0.001 then
                    shopListFrame = f
                    break
                end
            end
            local shopScrollingFrame = shopListFrame and shopListFrame:FindFirstChildWhichIsA("ScrollingFrame")
            if not shopScrollingFrame then break end

            -- ScrollingFrame 안의 Frame들 중, Frame > CanvasGroup > TextButton의 Text가
            -- 현재 켜진 아이템 토글과 정확히 일치하는 Frame을 찾는다.
            -- ✅ [사용자 요청] "Lucky Potion" 등은 상인마다 별개 토글이므로, 지금 도착한
            -- 상인 이름(merchantName)과 조합한 고유 키로 확인한다. 이미 구매한 것은 건너뛴다.
            local targetItemFrame = nil
            local targetStorageKey = nil
            for _, itemFrame in ipairs(shopScrollingFrame:GetChildren()) do
                if itemFrame:IsA("Frame") then
                    local canvasGroup = itemFrame:FindFirstChildWhichIsA("CanvasGroup")
                    local itemTextButton = canvasGroup and canvasGroup:FindFirstChildWhichIsA("TextButton")
                    if itemTextButton then
                        local storageKey = merchantName .. "_" .. itemTextButton.Text
                        if Settings.Sols.merchantBuyItems[storageKey] == true and not alreadyBought[storageKey] then
                            targetItemFrame = itemFrame
                            targetStorageKey = storageKey
                            break
                        end
                    end
                end
            end

            -- 조건에 충족하는 아이템이 하나도 없으면 구매 루프 종료
            if not targetItemFrame then break end

            -- ✅ 클릭하기 전에 미리 기억해둔다 (구매 과정 중 에러가 나도 같은 아이템을
            -- 무한히 재시도하지 않도록)
            alreadyBought[targetStorageKey] = true

            SetCurrentAction("상인 자동 구매 - 아이템 클릭")
            clickExactly(targetItemFrame)
            task.wait(0.5)

            frameA = FindMerchantFrameA()
            if not frameA then break end

            -- Position 값이 {0.00499999989,0},{0.0799999982,0} 인 Frame - ImageButton (1차 확인)
            local confirmFrame1 = nil
            for _, f in ipairs(frameA:GetChildren()) do
                if f:IsA("Frame")
                    and math.abs(f.Position.X.Scale - 0.00499999989) < 0.0001
                    and math.abs(f.Position.Y.Scale - 0.0799999982) < 0.0001 then
                    confirmFrame1 = f
                    break
                end
            end
            local confirmButton1 = confirmFrame1 and confirmFrame1:FindFirstChildWhichIsA("ImageButton")
            if not confirmButton1 then break end

            SetCurrentAction("상인 자동 구매 - 구매 확인 1")
            clickExactly(confirmButton1)
            task.wait(0.5)

            frameA = FindMerchantFrameA()
            if not frameA then break end

            -- 같은 Position의 Frame 안, AnchorPoint가 (0.5, 1)인 Frame - ImageButton (2차 확인)
            local confirmFrame2Outer = nil
            for _, f in ipairs(frameA:GetChildren()) do
                if f:IsA("Frame")
                    and math.abs(f.Position.X.Scale - 0.00499999989) < 0.0001
                    and math.abs(f.Position.Y.Scale - 0.0799999982) < 0.0001 then
                    confirmFrame2Outer = f
                    break
                end
            end
            local confirmFrame2 = nil
            if confirmFrame2Outer then
                for _, f in ipairs(confirmFrame2Outer:GetChildren()) do
                    if f:IsA("Frame") and f.AnchorPoint == Vector2.new(0.5, 1) then
                        confirmFrame2 = f
                        break
                    end
                end
            end
            local confirmButton2 = confirmFrame2 and confirmFrame2:FindFirstChildWhichIsA("ImageButton")
            if not confirmButton2 then break end

            SetCurrentAction("상인 자동 구매 - 구매 확인 2")
            clickExactly(confirmButton2)
            task.wait(0.5)

            -- ✅ [사용자 요청] 중간에 Emergency 신호가 오면, 각 Side(구매 사이클)가 끝날
            -- 때마다 확인해서 즉시 종료 및 복귀 단계로 넘어간다.
            if Settings.Emergency then
                break
            end
        end

        task.wait(1)

        -- ===== 종료 및 복귀 =====
        SetCurrentAction("상인 자동 구매 - 마무리 재설정 대기 중")
        -- (재설정 자체는 StopMerchantBuyCleanly 안에서 강제로 실행됨)
        StopMerchantBuyCleanly()
    end
end

