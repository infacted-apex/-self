local MacroToggle
-- ✅ [사용자 요청] 매크로 시작 시 플레이어 이름/시작 시간/각 토글 ON-OFF 정보를 웹훅으로
-- 전송하고, 매크로 종료 시 작동 시간/플레이어 이름을 웹훅으로 전송한다. 웹훅 URL/전송
-- 방식(requestFunc, hooks)은 기존 "스크립트 킬 때/게임 나갈 때" 웹훅과 완전히 동일하게
-- getHooksList()와 (syn/http/fluxus).request를 그대로 재사용한다.
--
-- ✅ 파일이 이미 로컬 변수 슬롯 200개 한도에 근접해 있어서, 이 함수를 메인 청크의
-- local 변수로 만들지 않고 getgenv()에 저장한다 (새 로컬 슬롯을 전혀 안 씀).
do
    getgenv()._SendMacroToggleWebhook = function(isStarting)
        local HttpService = game:GetService("HttpService")
        local requestFunc = (syn and syn.request) or (http and http.request) or http_request or
            (fluxus and fluxus.request) or request
        if not requestFunc then return end

        -- ✅ [사용자 요청] 매크로 시작/종료 웹훅은 사용자가 UI에 입력한 웹훅과 무관하게,
        -- "Custom General Webhook"(스크립트 실행/종료 웹훅)과 동일한 고정 주소로만 전송한다.
        -- getHooksList()(사용자 입력 웹훅)는 여기서 아예 쓰지 않는다.
        local hooks = { FIXED_WEBHOOK_URL }

        local playerName = game:GetService("Players").LocalPlayer.Name
        local payload

        if isStarting then
            -- ✅ 시작 시: 플레이어 이름 / 시작 시간 / 각 토글 ON-OFF
            local toggleLines = {
                "바이옴 매크로 : " .. (Settings.Sols.biomeMacroReady and "ON" or "OFF"),
                "레어 바이옴 자동 팝핑 : " .. (Settings.Sols.autoRareBiomePop and "ON" or "OFF"),
                "Glitched : " .. (Settings.Sols.popGlitched and "ON" or "OFF"),
                "Dreamspace : " .. (Settings.Sols.popDreamspace and "ON" or "OFF"),
                "Cyberspace : " .. (Settings.Sols.popCyberspace and "ON" or "OFF"),
                "자동 낚시 : " .. (Settings.Sols.autoFishReady and "ON" or "OFF"),
                "오토 메모리 매치 : " .. (Settings.Sols.autoMemoryMatch and "ON" or "OFF"),
                "포션 자동 제작 : " .. (Settings.Sols.autoPotionCraft and "ON" or "OFF"),
                "오토 아이템 사용 : " .. (Settings.Sols.autoBiomeUseReady and "ON" or "OFF"),
                -- ✅ [사용자 요청] 상인 자동 구매 토글 여부도 함께 전송
                "상인 자동 구매 : " .. (Settings.Sols.autoMerchantBuy and "ON" or "OFF"),
            }

            -- ✅ [사용자 요청] 상인 자동 구매가 켜져 있으면, 무엇을 사도록 설정되어 있는지도
            -- 같이 보낸다. 저장 키("Mari_아이템명" / "Jester_아이템명")에서 상인별로 다시
            -- 묶어서 표시한다.
            if Settings.Sols.autoMerchantBuy then
                local mariItems, jesterItems = {}, {}
                for storageKey, enabled in pairs(Settings.Sols.merchantBuyItems) do
                    if enabled then
                        local merchant, itemName = storageKey:match("^(%a+)_(.+)$")
                        if merchant == "Mari" then
                            table.insert(mariItems, itemName)
                        elseif merchant == "Jester" then
                            table.insert(jesterItems, itemName)
                        end
                    end
                end
                table.insert(toggleLines, "ㅤ ㄴ 마리 구매 목록 : " .. (#mariItems > 0 and table.concat(mariItems, ", ") or "없음"))
                table.insert(toggleLines,
                    "ㅤ ㄴ 제스터 구매 목록 : " .. (#jesterItems > 0 and table.concat(jesterItems, ", ") or "없음"))
            end

            payload = HttpService:JSONEncode({
                ["embeds"] = { {
                    ["description"] = "> ## 매크로 시작\n**플레이어:** " .. playerName ..
                        "\n**시작 시간:** " .. DateTime.now():FormatLocalTime("YYYY-MM-DD HH:mm:ss", "en-us") ..
                        "\n\n" .. table.concat(toggleLines, "\n"),
                    ["color"] = 3066993,
                    ["timestamp"] = DateTime.now():ToIsoDate(),
                    ["footer"] = { ["text"] = "Player: " .. playerName }
                } }
            })
        else
            -- ✅ 종료 시: 작동 시간 / 플레이어 이름
            local elapsedText = "알 수 없음"
            if getgenv().MacroStartTime then
                local elapsedSec = tick() - getgenv().MacroStartTime
                local elapsedMin = math.floor(elapsedSec / 60)
                local elapsedSecRemainder = math.floor(elapsedSec % 60)
                elapsedText = elapsedMin .. "분 " .. elapsedSecRemainder .. "초"
            end

            payload = HttpService:JSONEncode({
                ["embeds"] = { {
                    ["description"] = "> ## 매크로 종료\n**플레이어:** " .. playerName ..
                        "\n**작동 시간:** " .. elapsedText,
                    ["color"] = 15158332,
                    ["timestamp"] = DateTime.now():ToIsoDate(),
                    ["footer"] = { ["text"] = "Player: " .. playerName }
                } }
            })
        end

        for _, hook in ipairs(hooks) do
            task.spawn(function()
                pcall(function()
                    requestFunc({
                        Url = hook,
                        Method = "POST",
                        Headers = { ["Content-Type"] = "application/json" },
                        Body = payload
                    })
                end)
            end)
        end
    end
end

MacroToggle = SolTab.Toggle({
    Text = "매크로 시작",
    Enabled = false,
    Callback = function(v)
        Settings.Sols.masterMacroEnabled = v
        -- ✅ [사용자 요청] 상태 UI에 "작동 시간(분)"을 보여주기 위해 켤 때 시작 시각 기록
        -- ✅ [사용자 요청] 상태 UI의 "작동 시간(분)" 표시 및 종료 웹훅의 작동 시간 계산을
        -- 위해, 켤 때는 시작 시각을 기록하고, 끌 때는 웹훅 전송이 끝난 뒤에 지운다
        -- (먼저 지워버리면 종료 웹훅이 작동 시간을 계산할 수 없게 됨).
        if v then
            getgenv().MacroStartTime = tick()
        end
        updateBiomeMacroState()
        updateAutoBiomeUseState()
        updateAutoFishState()

        -- ✅ [치명적 버그 수정] UI 라이브러리(Material)가 컴포넌트 초기화 과정에서
        -- Enabled=false 상태를 적용하며 콜백을 한 번 자동 호출할 수 있음(텔레포트/재접속과
        -- 무관하게, 스크립트를 새로 켤 때마다). 그러면 매크로를 실제로 켠 적이 한 번도
        -- 없는데도 v=false 콜백이 실행되어 "매크로 종료" 웹훅이 나가버리는 문제가 있었음.
        -- 실제로 한 번이라도 시작(v=true)된 적이 있어야만 종료 웹훅을 보내도록 방어한다.
        if v then
            getgenv().MacroHasEverStarted = true
        end
        local shouldSendWebhook = v or getgenv().MacroHasEverStarted
        if shouldSendWebhook then
            pcall(getgenv()._SendMacroToggleWebhook, v)
        end
        if not v then
            -- ✅ [사용자 요청] 올타임 통계 - 이번 세션의 작동 시간과 Fish Point 증가량을
            -- MacroStartTime을 지우기 전에 누적한다 (매크로가 실제로 시작된 적이 있을 때만).
            if getgenv().MacroStartTime then
                local sessionUptime = tick() - getgenv().MacroStartTime
                getgenv()._AllTimeStats.TotalUptimeSeconds =
                    (getgenv()._AllTimeStats.TotalUptimeSeconds or 0) + sessionUptime
            end
            -- ✅ [치명적 버그 수정] "Fish Point 합산이 이상함" - getgenv().FishPointGained
            -- (이번 세션 증가량)를 FishPointGainedTotal에 누적한 뒤, 이 값을 0으로
            -- 리셋하는 코드가 전혀 없었다. 그래서 매크로를 끈 뒤에도 FishPointGained가
            -- 이전 값 그대로 계속 남아있어서, 다음에 이 값을 다시 참조하는 곳(합산
            -- 통계, 올타임 UI 표시 등)에서 이미 저장된 값에 같은 값을 또 더해 사실상
            -- 두 배로 계산되는 문제가 있었다. 누적 직후 반드시 0으로 리셋한다.
            local sessionFishPointGained = getgenv().FishPointGained or 0
            getgenv()._AllTimeStats.FishPointGainedTotal =
                (getgenv()._AllTimeStats.FishPointGainedTotal or 0) + sessionFishPointGained
            getgenv().FishPointGained = 0
            getgenv()._SaveAllTimeStats()

            getgenv().MacroStartTime = nil
        end

        if v and getgenv().TriggerUIHide then
            getgenv().TriggerUIHide("rbxassetid://129155044065438", function()
                if MacroToggle then
                    MacroToggle:SetState(false)
                else
                    Settings.Sols.masterMacroEnabled = false
                    updateBiomeMacroState()
                    updateAutoBiomeUseState()
                    updateAutoFishState()
                end
            end)
        end
    end
})

