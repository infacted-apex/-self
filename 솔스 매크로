        -- "유령 홀드" 상태에서는 새 클릭이 전혀 인식되지 않는다. 매크로를 꺼도 이
        -- 상태 자체는 안 풀리고(코루틴이 이미 죽어서 스스로 못 고침), 낚시가 클릭을
        -- 초당 여러 번 보내니 오래 켜둘수록 하필 그 좁은 순간에 토글을 끌 확률이
        -- 누적된다 - "오래 켜두면 재발"하던 정확한 원인.
        --
        -- 해결: 다른 모든 기능과 동일하게 강제 종료 대신 협조적 종료로 바꾼다.
        -- Settings.Sols.autoFishActive는 이 함수 맨 위에서 이미 false로 세팅되어 있고,
        -- 낚시 루프 내부 거의 모든 지점이 이 값을 주기적으로 확인해서 스스로 빠져나가게
        -- 되어 있다 - 마우스 누름/뗌 쌍이 항상 온전하게 끝난 뒤에 종료되므로 유령 홀드가
        -- 발생할 수 없다. (코루틴이 끝나면 위에서 추가한 pcall 래퍼가 autoFishConnection
        -- 정리와 StopMacro까지 알아서 처리함.)
        --
        -- 추가 안전장치: 혹시 이 수정 이전 실행에서 이미 마우스가 유령 홀드 상태로 남아
        --있을 수 있으니, 좌/우 버튼 모두 명시적으로 "뗌" 이벤트를 한 번 더 보내서
        -- 확실히 풀어준다 (눌려있지 않은 버튼에 뗌을 보내는 건 아무 부작용이 없음).
        pcall(function()
            local vim = Services.VirtualInputManager
            local cam = workspace.CurrentCamera
            local viewport = cam and cam.ViewportSize
            local cx = viewport and math.floor(viewport.X / 2) or 0
            local cy = viewport and math.floor(viewport.Y / 2) or 0
            vim:SendMouseButtonEvent(cx, cy, 0, false, game, 0) -- 좌클릭 뗌(안전장치)
            vim:SendMouseButtonEvent(cx, cy, 1, false, game, 0) -- 우클릭 뗌(안전장치)
        end)

        -- ✅ [안정화] autoFishConnection을 여기서 바로 nil로 비우지 않는다 - 코루틴을
        -- 더 이상 강제로 끊지 않으므로, 실제로는 아직 몇 초간 살아서 협조적으로 정리
        -- 중일 수 있다. 여기서 미리 nil을 만들면, 그 사이에 낚시를 다시 켰을 때
        -- "실행 중인 게 없다"고 오판해서 새 코루틴을 하나 더 띄워버려 두 낚시 코루틴이
        -- 동시에 카메라/입력을 다투는 문제가 생길 수 있다. 옛 코루틴이 실제로 완전히
        -- 끝났을 때(위쪽 pcall 래퍼)만 스스로 nil로 비우도록 둔다.
        -- ✅ [버그 수정] 그래도 CurrentActiveFeature/MacroPriority가 "Fishing"에 갇히지
        -- 않도록 자리는 여기서 즉시 비워둔다(StopMacro는 이미 비어있으면 안전하게 무시됨).
        StopMacro("Fishing")
    end
end

