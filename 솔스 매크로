-- 메모리 매치(Place3 이동), 포션 제작(MoveToPlaceClickStyle) 등 여러 곳에서 정확히
-- 동일한 시퀀스(카메라를 목표 위치 위에서 수직으로 내려다보는 각도로 바꾸고 -> 1초
-- 대기 -> 화면 중앙 클릭 -> 0.1초 대기 -> 카메라를 원래 상태로 복원)가 반복되고
-- 있었다. 하나의 공통 함수로 통합한다.
-- targetPosition: 카메라를 위치시킬 기준 좌표(Vector3). 이 좌표 바로 위에서 수직 아래를
-- 내려다보는 각도가 된다.
-- shouldContinueFn: 인자 없이 호출해 "지금 계속 진행해도 되는가"를 반환하는 함수(선택,
-- 안 넘기면 항상 진행). 카메라를 조작한 뒤(1초 대기 이후) 이 값이 거짓이면 클릭하지
-- 않고 카메라만 원복한 뒤 즉시 중단한다.
-- 반환값: 클릭까지 실제로 실행했으면 true, 중간에 취소되어 클릭하지 못했으면 false.
local function CameraLookDownAndClick(targetPosition, shouldContinueFn)
    local function shouldContinue()
        if shouldContinueFn then return shouldContinueFn() end
        return true
    end

    local cam = workspace.CurrentCamera
    local originalCamCFrame, originalCamType
    if cam then
        originalCamType = cam.CameraType
        originalCamCFrame = cam.CFrame
        cam.CameraType = Enum.CameraType.Scriptable
        cam.CFrame = CFrame.new(targetPosition) * CFrame.Angles(math.rad(-90), 0, 0)
    end

    -- ✅ [치명적 버그 수정] "Click to Move가 켜져 있어도 (설정 창이 안 열려있어도)
    -- 작동 안 함, 매크로를 꺼도 계속 안 됨" - 카메라를 Scriptable로 바꾼 뒤부터 원래
    -- 상태로 되돌리기 전까지의 구간에서 에러가 나면(특히 최근 추가한 pcall(config.run)
    -- 이 그 에러를 조용히 삼켜버리면서), 카메라가 Scriptable 상태로 영원히 고정되어
    -- 플레이어 조작(우클릭 이동 포함)이 전혀 안 먹히는 문제가 있었다. 이 구간 전체를
    -- pcall로 감싸서, 에러가 나더라도 아래에서 반드시 카메라를 원래 상태로 복구한다.
    local ok = pcall(function()
        task.wait(1)

        if not shouldContinue() then return end

        local viewport = workspace.CurrentCamera.ViewportSize
        local centerX = math.floor(viewport.X / 2)
        local centerY = math.floor(viewport.Y / 2)
        showPremiumIndicator(centerX, centerY)
        Services.VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 1, true, game, 0)
        task.wait(0.05)
        Services.VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 1, false, game, 0)

        task.wait(0.1)
    end)

    -- ✅ pcall 성공/실패와 무관하게, 그리고 shouldContinue()가 도중에 거짓이 됐어도
    -- 반드시 카메라를 원래 상태로 복구한다.
    if cam and originalCamCFrame and originalCamType then
        cam.CameraType = originalCamType
        cam.CFrame = originalCamCFrame
    end

    if not ok then
        return false
    end
    if not shouldContinue() then
        return false
    end

    return true
end

-- ✅ [사용자 요청] "Click To Move 설정 및 이동 기능을 병합" - 기존엔 포션 제작
-- (EnsureClickToMoveModeForPotion)과 낚시(ensureClickToMoveMode, 8000줄대 근처)가
-- 완전히 동일한 로직을 각자 따로 들고 있었다(토글 확인 방식만 다름). 어느 매크로에서
-- 호출됐는지와 무관하게 "지금 계속 진행해도 되는가"만 shouldContinueFn(인자 없는 함수)
-- 으로 받아서 판단하도록 통합했다. 반환값은 기존과 동일(true=설정 완료, false=중단/실패).
local function EnsureClickToMoveMode(shouldContinueFn)
    if not shouldContinueFn() then return false end

    local coreGui = game:GetService("CoreGui")
    local guiService = game:GetService("GuiService")
    local vim = Services.VirtualInputManager
    local selector = nil

    -- ✅ [안정화] "매크로를 오래 켜두면 클릭 이동이 안 먹힘" 재발 원인 - 이 함수의 "느린
    -- 경로"는 메뉴가 항상 닫혀있다고 가정하고 무조건 ESC를 눌러 "연다". 그런데 어떤
    -- 이유로든(직전 호출이 끝맺음을 제대로 못 하고 중간에 취소된 경우 등) 실제로 이미
    -- 열려있는 상태에서 이 ESC를 누르면 오히려 메뉴를 닫아버려서, 그 뒤에 이어지는
    -- Tab/방향키 입력이 전부 엉뚱한 상태(닫힌 메뉴)에 꽂혀 아무 효과가 없어진다. 실패
    -- 폴백에서도 마찬가지로 무조건 ESC를 눌러 "닫는다"고만 가정해서, 실제로는 열어버리는
    -- 경우가 있었다. 한 번이라도 이렇게 실제 상태와 어긋나면, 이후 모든 호출이 매번
    -- 반대 방향으로 상태를 뒤집기만 하면서 영영 정상 동작으로 못 돌아오는 문제가
    -- 있었음 - 장시간 플레이할수록(호출 횟수가 누적될수록) 이 어긋남을 밟을 확률이
    -- 높아져서 "오래 켜두면 재발"하는 것으로 보인다. Roblox가 공식 제공하는
    -- GuiService.MenuIsOpen으로 매번 실제 상태를 확인해서, "열려있을 때만 닫고,
    -- 닫혀있을 때만 연다"는 원칙을 모든 분기에서 일관되게 지키도록 고친다.
    local function isMenuOpenNow()
        local ok, v = pcall(function() return guiService.MenuIsOpen end)
        return ok and v == true
    end

    local success, result = pcall(function()
        local basePage = coreGui.RobloxGui.SettingsClippingShield.SettingsShield.MenuContainer.Page
            .PageViewClipper.PageView.PageViewInnerFrame.Page
        selector = basePage["Movement ModeFrame"].Selector
        return selector.Selection3
    end)

    if success and result and result.Position == UDim2.new(0, 32, 0, 0) then
        -- ✅ [치명적 버그 수정] "Click to Move가 켜져 있어도 작동 안 함" - 이전 수정에서
        -- SettingsClippingShield.Enabled라는 추측성 UI 경로로 "메뉴가 열려있는지"를
        -- 확인했는데, 이 경로 자체가 실제 게임 구조와 안 맞아서 pcall이 조용히 실패하고
        -- menuIsOpen이 항상 false로 고정되고 있었다. 그 결과 메뉴가 실제로 열려있어도
        -- 절대 ESC로 닫지 못해서, Roblox 설정/일시정지 메뉴가 화면에 계속 열린 채로
        -- 남아 모든 입력(클릭 포함)을 가로채 버렸다 - 이게 "Click to Move가 켜져
        -- 있는데도 작동 안 하는" 증상의 정확한 원인이다. 추측성 UI 경로 대신, Roblox가
        -- 공식적으로 제공하는 GuiService.MenuIsOpen(메뉴 열림 여부를 정확히 알려주는
        -- 문서화된 API)을 사용한다.
        if isMenuOpenNow() then
            vim:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)
            task.wait(1.5)
            vim:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)
        end
        return true
    end

    -- 메뉴 열기 (ESC -> Tab) - 실제로 닫혀있을 때만 ESC를 눌러 연다. 이미 열려있는데
    -- 또 누르면 오히려 닫아버려서 이후 모든 입력이 어긋나게 된다.
    if not isMenuOpenNow() then
        vim:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)
        task.wait(1.5)
        vim:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)
    end

    vim:SendKeyEvent(true, Enum.KeyCode.Tab, false, game)
    task.wait(1.5)
    vim:SendKeyEvent(false, Enum.KeyCode.Tab, false, game)

    if not shouldContinueFn() then
        if isMenuOpenNow() then
            vim:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)
            task.wait(1)
            vim:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)
        end
        return false
    end

    pcall(function()
        local basePage = coreGui.RobloxGui.SettingsClippingShield.SettingsShield.MenuContainer.Page
            .PageViewClipper.PageView.PageViewInnerFrame.Page
        selector = basePage["Movement ModeFrame"].Selector
    end)

    local hoverSuccess = false
    if selector then
        for i = 1, 50 do
            if not shouldContinueFn() then break end
            vim:SendKeyEvent(true, Enum.KeyCode.Down, false, game)
            task.wait(0.35)
            vim:SendKeyEvent(false, Enum.KeyCode.Down, false, game)
            if selector.GuiState == Enum.GuiState.Hover then
                hoverSuccess = true
                break
            end
        end

        if not hoverSuccess and shouldContinueFn() then
            for i = 1, 50 do
                if not shouldContinueFn() then break end
                vim:SendKeyEvent(true, Enum.KeyCode.Up, false, game)
                task.wait(0.35)
                vim:SendKeyEvent(false, Enum.KeyCode.Up, false, game)
                if selector.GuiState == Enum.GuiState.Hover then
                    hoverSuccess = true
                    break
                end
            end
        end
    end

    if hoverSuccess then
        local targetReached = false
        local rightAttempts = 0
        while shouldContinueFn() and rightAttempts < 30 do
            rightAttempts = rightAttempts + 1
            local s3 = nil
            pcall(function() s3 = selector.Selection3 end)
            if s3 and s3.Position == UDim2.new(0, 32, 0, 0) then
                targetReached = true
                break
            end
            vim:SendKeyEvent(true, Enum.KeyCode.Right, false, game)
            task.wait(1)
            vim:SendKeyEvent(false, Enum.KeyCode.Right, false, game)
        end

        if targetReached then
            task.wait(1)
            if isMenuOpenNow() then
                vim:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)
                task.wait(1.5)
                vim:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)
            end
            return true
        end
    end

    -- ✅ [안정화] 실패 폴백도 무조건 ESC(=닫기로 가정)가 아니라, 실제로 열려있을 때만
    -- 닫는다. 이 함수는 항상 "메뉴가 닫힌 상태"로 끝나야 하므로, 실제 상태를 최종
    -- 확인해서 맞춘다.
    if isMenuOpenNow() then
        vim:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)
        task.wait(1)
        vim:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)
    end
    return false
end

-- ✅ [사용자 요청] "XXX으로 가기" 하나로 병합된 이동 함수. 지정한 위치(scriptParts 안에
-- placeName으로 캐싱되는 더미 파트)로, 매번 Click To Move 상태를 확인한 뒤 카메라 직하향
-- + 화면 중앙 클릭 방식으로 이동한다.
--   - 3초 이상 거의 멈춰 있으면(약간의 흔들림은 허용) 스페이스바를 1번 눌러 다시 시도해보고,
--   - 그 상태로 다시 3초 이상 멈춰 있으면 그때 이동 실패로 판정한다.
--   - 실패 시 캐릭터를 리셋하고 처음부터 재시도하며, 최대 재시도 횟수는 3회다.
-- shouldContinueFn: 인자 없이 호출해 "지금 계속 진행해도 되는가"를 반환하는 함수.
-- actionLabel: 상태 UI에 표시할 현재 행동 설명(예: "포션 제작", "메모리 매치").
-- ✅ [사용자 요청] "이미 한번 가서 없는 Watermelon으로 계속 감" - 기존엔 이 함수가 항상
-- scriptParts 안에 이름으로 캐싱된 더미 파트를 재사용했다. Place1/Lime처럼 게임 내내
-- 고정된 위치는 이 캐싱이 맞지만, Watermelon처럼 상호작용 후 파괴되고 다른 위치에 새로
-- 생성되는 대상은 캐시된 옛 좌표를 영원히 가리키게 되어, 새 Watermelon이 다른 곳에
-- 생겨도 계속 원래 갔던(이제는 사라진) 위치로만 이동을 시도했다. skipCache=true를
-- 넘기면 캐시를 무시하고 매번 placePosition으로 좌표를 새로 갱신한다.
-- ✅ [사용자 요청] "미니게임에서는 재설정 로직이 없게" - skipReset=true를 넘기면
-- 이동 실패 시 캐릭터를 재설정하지 않고 그냥 실패(false)를 반환한다. 오토 미니게임처럼
-- "실패하면 재설정 없이 한 번 더 시도하고, 그래도 안 되면 포기(다른 방식)"가 필요한
-- 경우를 위한 옵션이다.
local function MoveToPositionClickStyle(placePosition, placeName, shouldContinueFn, actionLabel, skipCache, skipReset)
    -- ✅ skipReset이면 이 함수 내부에서는 딱 1번만 시도하고, 실패 시 재시도 여부를
    -- 호출부(오토 미니게임 등)가 직접 결정한다.
    local MAX_RETRY_ATTEMPTS = skipReset and 1 or 3
    local vim = Services.VirtualInputManager

    if not shouldContinueFn() then return false end

    local scriptParts = workspace:FindFirstChild("ScriptParts")
    if not scriptParts then
        scriptParts = Instance.new("Folder")
        scriptParts.Name = "ScriptParts"
        scriptParts.Parent = workspace
    end
    local placePart = scriptParts:FindFirstChild(placeName)
    if not placePart then
        placePart = Instance.new("Part")
        placePart.Name = placeName
        placePart.Position = placePosition
        placePart.Anchored = true
        placePart.CanCollide = false
        placePart.Transparency = 1
        placePart.Parent = scriptParts
    elseif skipCache then
        -- ✅ 캐시된 더미 파트가 이미 있어도, 매번 최신 실제 좌표로 갱신한다.
        placePart.Position = placePosition
    end

    local function checkTouched()
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp and placePart and (hrp.Position - placePart.Position).Magnitude < 10 then
            return true
        end
        return false
    end

    -- ✅ [치명적 버그 수정] "캐릭터가 파트에 겹친 뒤, 멈춘 걸 확인하고 0.5초 대기 후
    -- 끝나야 하는데, 겹치자마자 그냥 끝나버림" - 기존엔 checkTouched()(단순 거리 판정)가
    -- 참이 되는 즉시 곳곳에서 바로 return true 해버려서, 캐릭터가 아직 이동 중(관성으로
    -- 파트를 스쳐 지나가는 중)이어도 도착으로 오판하고 다음 단계로 넘어갔다. 겹친
    -- 이후에는 "멈출 때까지 기다렸다가, 멈춘 뒤 0.5초를 더 대기"하는 확인 단계를
    -- 반드시 거치도록 만든다.
    -- ✅ [치명적 버그 수정] "겹친 후라면, 겹치지 않은 상태에서 0.5초 멈춰있어도 성공으로
    -- 인식되는 느낌" - 기존엔 "멈춘 걸 확인한 뒤 0.5초"를 그냥 task.wait(0.5)로 통째로
    -- 흘려보내고, 그 0.5초가 끝나는 시점에 딱 한 번만 checkTouched()를 확인했다. 그
    -- 사이(0.5초 동안)에 캐릭터가 관성 등으로 파트를 완전히 벗어났다가 다시 돌아와도
    -- 전혀 감지하지 못했다. 요청하신 대로 "겹쳐 있는 상태로 0.5초 지속"을 정확히
    -- 만족하도록, 그 0.5초 내내 0.1초 간격으로 계속 겹쳐 있는지 확인하고, 중간에 한
    -- 번이라도 벗어나면 그 즉시 실패로 처리한다.
    local function confirmArrival()
        if not checkTouched() then return false end
        -- 겹친 상태에서 멈출 때까지 대기 (최대 5초, 그 이상 걸리면 포기하고 그냥 도착 처리)
        local waitStart = tick()
        while (tick() - waitStart) < 5 do
            if not shouldContinueFn() then return false end
            if not checkTouched() then return false end -- 멈추기 전에 파트를 벗어나면 실패
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp and hrp.Velocity.Magnitude < 1 then
                break -- 멈춘 것으로 판정, 아래에서 0.5초 동안 계속 겹쳐있는지 확인
            end
            task.wait(0.1)
        end

        -- ✅ [사용자 요청] "겹쳐 있는 상태로 0.5초 지속" - 0.5초 내내 계속 파트에 겹쳐
        -- 있는지 0.1초 간격으로 확인한다. 중간에 한 번이라도 벗어나면 즉시 실패.
        local overlapStart = tick()
        while (tick() - overlapStart) < 0.5 do
            if not shouldContinueFn() then return false end
            if not checkTouched() then return false end
            task.wait(0.1)
        end
        return checkTouched()
    end

    local attempts = 0
    while shouldContinueFn() and attempts < MAX_RETRY_ATTEMPTS do
        attempts = attempts + 1
        SetCurrentAction(string.format("%s - %s으로 이동 중 (시도 %d/%d)", actionLabel, placeName, attempts, MAX_RETRY_ATTEMPTS))

        -- ✅ Click To Move는 매번 체크
        -- ✅ [치명적 버그 수정] "ESC 누르고 클릭을 바로 해버리는 느낌" - 기존엔 이
        -- 함수의 반환값(성공/실패)을 전혀 확인하지 않고 바로 다음 단계(카메라 조작 +
        -- 클릭)로 넘어갔다. Click To Move 설정 메뉴가 아직 안 끝났거나(방향키 탐색
        -- 도중 등) 실패했는데도 그대로 클릭을 진행해버려서, 메뉴가 채 닫히기도 전에
        -- 클릭이 발생하는 꼬임 증상이 있었다. 실패하면 이번 시도를 건너뛰고(클릭하지
        -- 않고) 짧게 대기한 뒤 다음 재시도로 넘어간다.
        local clickToMoveReady = EnsureClickToMoveMode(shouldContinueFn)
        if not shouldContinueFn() then return false end
        if not clickToMoveReady then
            task.wait(1)
            continue
        end

        local clicked = CameraLookDownAndClick(placePart.Position, shouldContinueFn)
        if not clicked then return false end

        if confirmArrival() then
            return true
        end

        -- ✅ [사용자 요청] "점프 보정은 캐릭터가 아예 멈춰 있는 게 아니라, 5스터드를
        -- 3초 이상 벗어나지 못하면 되는 것" - 기존엔 순간 속도(Velocity)가 거의 0인
        -- 상태가 3초 지속되는 것으로 "정지"를 판정했는데, 이러면 좁은 범위 안에서 계속
        -- 왔다갔다 하며 멈췄다 움직였다를 반복하는 경우(정지 타이머가 계속 리셋됨)를
        -- 놓칠 수 있었다. 이제는 "위치 기준점(anchorPosition)으로부터 5스터드 반경을
        -- 3초 이상 벗어나지 못했는지"로 판정한다 - 기준점을 벗어나면(5스터드 이상
        -- 이동하면) 그 새 위치를 기준점으로 갱신하고 타이머를 리셋한다.
        local hasJumpedThisAttempt = false
        local jumpPosition = nil

        -- ✅ [사용자 요청] 1단계: 5스터드 반경을 3초 이상 벗어나지 못하면 스페이스바를
        -- 1번 눌러 다시 시도해본다.
        local isStoppedTime = 0
        local anchorPosition = nil
        while true do
            if not shouldContinueFn() then return false end
            task.wait(0.1)
            if confirmArrival() then return true end

            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

            -- ✅ 점프를 이미 썼는데, 그 이후 5스터드 이상 실제로 움직였으면 점프를 다시
            -- 쓸 수 있게 초기화하고 정지 타이머도 리셋한다.
            if hasJumpedThisAttempt and hrp and jumpPosition
                and (hrp.Position - jumpPosition).Magnitude >= 5 then
                hasJumpedThisAttempt = false
                jumpPosition = nil
                isStoppedTime = 0
                anchorPosition = nil
            end

            if hrp then
                if not anchorPosition then
                    anchorPosition = hrp.Position
                    isStoppedTime = 0
                elseif (hrp.Position - anchorPosition).Magnitude >= 5 then
                    -- 5스터드 이상 벗어났으니 기준점을 갱신하고 타이머를 리셋한다
                    anchorPosition = hrp.Position
                    isStoppedTime = 0
                else
                    isStoppedTime = isStoppedTime + 0.1
                end
            end

            if isStoppedTime >= 3 then
                if not hasJumpedThisAttempt then
                    -- 3초간 5스터드를 못 벗어났으니 스페이스바로 한 번 시도
                    vim:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                    task.wait(0.05)
                    vim:SendKeyEvent(false, Enum.KeyCode.Space, false, game)

                    hasJumpedThisAttempt = true
                    jumpPosition = hrp and hrp.Position
                    isStoppedTime = 0
                    anchorPosition = hrp and hrp.Position
                else
                    -- ✅ 이미 점프를 써봤고(그리고 5스터드 이상 움직이지 못했고) 다시
                    -- 3초 동안 5스터드를 못 벗어나면 그때 최종 실패로 처리한다.
                    break
                end
            end
        end

        if not shouldContinueFn() then return false end
        if confirmArrival() then return true end

        -- ✅ [사용자 요청] "미니게임에서는 재설정 로직이 없게" - skipReset이면 캐릭터를
        -- 재설정하지 않고 그냥 실패 처리한다(호출부에서 별도로 재시도/포기를 결정).
        if skipReset then
            return false
        end

        -- ✅ 이동 실패 - 캐릭터를 강제 리셋하고 처음부터 재시도 (최대 MAX_RETRY_ATTEMPTS회)
        ResetCharacter()
        task.wait(5)
    end

    return false
end

-- A 안의 ZIndex==999 인 Frame (전환 페이드 효과)
-- ✅ [사용자 요청] "Click To Move 설정 및 이동 기능을 병합" - 실제 로직은 파일 앞쪽의
-- 공통 함수 EnsureClickToMoveMode(shouldContinueFn)로 통합되었다. 포션 제작 전용
-- 조건(Settings.Sols.masterMacroEnabled)을 그대로 넘겨주는 얇은 래퍼로 남겨서, 기존
-- 호출부(MoveToPlaceClickStyle 등)를 전혀 바꾸지 않아도 되게 한다.
local function EnsureClickToMoveModeForPotion()
    return EnsureClickToMoveMode(function() return Settings.Sols.masterMacroEnabled end)
end

-- 지정한 위치(Place4/Place5 등)로 클릭이동 방식(카메라 직하향 + 클릭)으로 이동
-- ✅ [치명적 버그 수정] 포션 제작 토글이 꺼졌는지 확인하는 함수. MoveToPlaceClickStyle/
-- WaitUntilStationary(이동 단계)와 RunAutoPotionCraft(패턴 경계) 양쪽에서 다 필요해서
-- 이 파일 앞쪽에 전역으로 둔다. 이동 중에 토글을 꺼도 즉시 멈추지 않고 이동이 끝날
-- 때까지 계속 진행되던 문제(사용자 요청)의 원인이 바로 이 확인이 이동 함수 내부에
-- 전혀 없었기 때문이었음.
local function IsPotionCraftToggleOff()
    return not (Settings.Sols.autoPotionCraft and Settings.Sols.masterMacroEnabled)
end

local function MoveToPlaceClickStyle(placePosition, placeName)
    EnsureClickToMoveModeForPotion()

    local scriptParts = workspace:FindFirstChild("ScriptParts")
    if not scriptParts then
        scriptParts = Instance.new("Folder")
        scriptParts.Name = "ScriptParts"
        scriptParts.Parent = workspace
    end
    local placePart = scriptParts:FindFirstChild(placeName)
    if not placePart then
        placePart = Instance.new("Part")
        placePart.Name = placeName
        placePart.Position = placePosition
        placePart.Anchored = true
        placePart.CanCollide = false
        placePart.Transparency = 1
        placePart.Parent = scriptParts
    end

    local clicked = CameraLookDownAndClick(placePart.Position, function() return not IsPotionCraftToggleOff() end)
    if not clicked then return end
end

-- 캐릭터가 duration초 동안 계속 멈춰있으면 반환 (최대 maxWait초까지만 기다림)
local function WaitUntilStationary(duration, maxWait)
    local stationaryTime = 0
    local startTime = tick()
    -- ✅ [치명적 버그 수정] 이 대기는 최대 30초까지 걸릴 수 있는데, 토글 확인이 없어서
    -- 토글을 꺼도 최대 30초 동안 계속 대기를 이어갔음. 매 반복마다 확인해서 즉시 멈춘다.
    while stationaryTime < duration and (tick() - startTime) < (maxWait or 30) and not IsPotionCraftToggleOff() do
        task.wait(0.1)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp and hrp.Velocity.Magnitude < 1 then
            stationaryTime = stationaryTime + 0.1
        else
            stationaryTime = 0
        end
    end
end

-- 앞서 완성한 "ScrollingFrame 없는 스크롤" 방식 그대로 재사용
local function ScrollToPotionButton(targetButton, viewport, itemContainer)
    if not (targetButton and viewport and itemContainer) then
        return
    end
    local layout = itemContainer:FindFirstChildWhichIsA("UIListLayout")
        or itemContainer:FindFirstChildWhichIsA("UIGridLayout")
    if not layout then
        return
    end

    local btnPos = targetButton.AbsolutePosition
    local btnSize = targetButton.AbsoluteSize
    local viewportPos = viewport.AbsolutePosition
    local viewportSize = viewport.AbsoluteSize

    local deltaY = (btnPos.Y + btnSize.Y / 2) - (viewportPos.Y + viewportSize.Y / 2)

    local currentPos = itemContainer.Position
    local newOffsetY = currentPos.Y.Offset - deltaY

    local maxOffset = 0
    local minOffset = -(layout.AbsoluteContentSize.Y - viewport.AbsoluteSize.Y)
    if minOffset > maxOffset then minOffset = maxOffset end


    newOffsetY = math.clamp(newOffsetY, minOffset, maxOffset)
    itemContainer.Position = UDim2.new(currentPos.X.Scale, currentPos.X.Offset, currentPos.Y.Scale, newOffsetY)
end

-- A-1 -> [AnchorPoint 1,0.5 / Size 0.25,0.7] -> [Size 0.98,0.885] -> [Size 0.98,0.947] -> Item -> 색 (0,99,87)인 ImageButton
local function FindPotionCraftTargetButton(rootFrame)
    if not rootFrame then
        return nil, nil, nil
    end
    local panelFound, viewportFound, contentFound, itemFound = false, false, false, false
    for _, panel in ipairs(rootFrame:GetChildren()) do
        if panel:IsA("Frame") and panel.AnchorPoint == Vector2.new(1, 0.5)
            and math.abs(panel.Size.X.Scale - 0.25) < 0.01 and math.abs(panel.Size.Y.Scale - 0.7) < 0.01 then
            panelFound = true
            for _, viewport in ipairs(panel:GetChildren()) do
                if viewport:IsA("Frame") and math.abs(viewport.Size.X.Scale - 0.98) < 0.01 and math.abs(viewport.Size.Y.Scale - 0.885) < 0.01 then
                    viewportFound = true
                    for _, content in ipairs(viewport:GetChildren()) do
                        if content:IsA("Frame") and math.abs(content.Size.X.Scale - 0.98) < 0.01 and math.abs(content.Size.Y.Scale - 0.947) < 0.01 then
                            contentFound = true
                            local itemContainer = content:FindFirstChild("Item")
                            if itemContainer then
                                itemFound = true
                                local btnCount = 0
                                for _, btn in ipairs(itemContainer:GetDescendants()) do
                                    if btn:IsA("ImageButton") then
                                        btnCount = btnCount + 1
                                        local c = btn.BackgroundColor3
                                        local r = math.floor(c.R * 255 + 0.5)
                                        local g = math.floor(c.G * 255 + 0.5)
                                        local b = math.floor(c.B * 255 + 0.5)
                                        if r == 0 and g == 99 and b == 87 then
                                            return btn, viewport, itemContainer
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return nil, nil, nil
end

-- A-1 -> [AnchorPoint 0,0.5 / Position 0.025,0.5] -> [Position 0.5,0.985] -> [AnchorPoint 0,1] -> TextLabel "Open Recipe"를 가진 ImageButton
local function FindOpenRecipeButton(rootFrame)
    if not rootFrame then return nil end
    for _, f1 in ipairs(rootFrame:GetChildren()) do
        if f1:IsA("Frame") and f1.AnchorPoint == Vector2.new(0, 0.5)
            and math.abs(f1.Position.X.Scale - 0.025) < 0.01 and math.abs(f1.Position.Y.Scale - 0.5) < 0.01 then
            for _, f2 in ipairs(f1:GetChildren()) do
                if f2:IsA("Frame") and math.abs(f2.Position.X.Scale - 0.5) < 0.01 and math.abs(f2.Position.Y.Scale - 0.985) < 0.01 then
                    for _, f3 in ipairs(f2:GetChildren()) do
                        if f3:IsA("Frame") and f3.AnchorPoint == Vector2.new(0, 1) then
                            for _, btn in ipairs(f3:GetDescendants()) do
                                if btn:IsA("ImageButton") then
                                    for _, desc in ipairs(btn:GetDescendants()) do
                                        if desc:IsA("TextLabel") and desc.Text == "Open Recipe" then
                                            return btn
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return nil
end

