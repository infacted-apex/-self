-- ✅ [사용자 요청] 아래 SHOW_FATAL_ERROR를 true로 두면, FATAL_ERROR_CODE에 적은
-- 텍스트가 표시되면서 스크립트가 실행되지 않고 즉시 중단된다.
-- 예: FATAL_ERROR_CODE = "Cannot found Username"
--     -> 화면/콘솔에 `Fatal error. Code : "Cannot found Username"` 이 표시되고 종료
local SHOW_FATAL_ERROR = false
local FATAL_ERROR_CODE = ""

if SHOW_FATAL_ERROR then
    local message = string.format('Fatal error. Code : "%s"', FATAL_ERROR_CODE)

    -- 콘솔(개발자 콘솔 F9)에 표시
    warn(message)

    -- ✅ [사용자 요청] 화면 아래쪽에 텍스트를 띄우고, 3초간 유지한 후 서서히
    -- (TweenService로) 사라지게 한다.
    pcall(function()
        local player = game:GetService("Players").LocalPlayer
        if not player then return end
        local playerGui = player:WaitForChild("PlayerGui", 5)
        if not playerGui then return end

        local screenGui = Instance.new("ScreenGui")
        screenGui.Name = "FatalErrorNotice"
        screenGui.IgnoreGuiInset = true
        screenGui.DisplayOrder = 2147483647
        screenGui.ResetOnSpawn = false
        screenGui.Parent = playerGui

        local label = Instance.new("TextLabel")
        label.Name = "FatalErrorLabel"
        label.AnchorPoint = Vector2.new(0.5, 1)
        label.Position = UDim2.new(0.5, 0, 1, -60)
        label.Size = UDim2.new(0, 600, 0, 50)
        label.BackgroundColor3 = Color3.new(0, 0, 0)
        label.BackgroundTransparency = 0.3
        label.BorderSizePixel = 0
        label.TextColor3 = Color3.new(1, 1, 1)
        label.TextSize = 20
        label.Font = Enum.Font.SourceSansBold
        label.Text = string.format('Fatal error. Code : "%s"', FATAL_ERROR_CODE)
        label.TextWrapped = true
        label.Parent = screenGui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = label

        -- 3초 유지 후 서서히(0.8초에 걸쳐) 사라짐
        task.delay(3, function()
            local tweenService = game:GetService("TweenService")
            local fadeInfo = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            tweenService:Create(label, fadeInfo, {
                TextTransparency = 1,
                BackgroundTransparency = 1
            }):Play()
            task.delay(0.8, function()
                screenGui:Destroy()
            end)
        end)
    end)

    -- ✅ 스크립트 실행 자체를 여기서 완전히 중단한다.
    return
end

