getgenv()._SaveAllTimeStats = function()
    pcall(function()
        if writefile then
            -- ✅ [치명적 버그 수정] "Fish Point 합산이 이상하게 보임" - 기존엔
            -- getgenv()._AllTimeStats를 그대로 저장했는데, 이 테이블의 FishPointGainedTotal/
            -- TotalUptimeSeconds는 매크로를 "끌 때"만 갱신되고, 매크로가 켜져 있는 동안(수십
            -- 분씩 계속될 수 있음) 30초마다 도는 이 주기적 저장은 오래된 값 그대로 디스크에
            -- 기록했다. 그래서 다른 계정이 AAA(합산) 통계를 볼 때, 지금 한창 플레이 중인
            -- 계정의 실시간 진행 상황이 전혀 반영되지 않은 값을 읽게 됐다. 저장 직전에
            -- "지금까지 진행 중인 세션의 실시간 증가분"을 반영한 별도 복사본을 만들어 그것을
            -- 저장한다 - 원본 getgenv()._AllTimeStats 자체는 건드리지 않아서, 매크로를 끌
            -- 때의 정상적인 최종 누적 로직과 절대 충돌하지 않는다.
            local original = getgenv()._AllTimeStats
            local snapshot = {}
            for key, value in pairs(original) do
                snapshot[key] = value
            end
            if getgenv().MacroStartTime then
                snapshot.TotalUptimeSeconds = (snapshot.TotalUptimeSeconds or 0)
                    + (tick() - getgenv().MacroStartTime)
                snapshot.FishPointGainedTotal = (snapshot.FishPointGainedTotal or 0)
                    + (getgenv().FishPointGained or 0)
            end
            writefile(ALLTIME_STATS_FILE, HttpService:JSONEncode(snapshot))
        end
    end)
end

