-- [ 바이옴 아이템 자동 사용 시스템 ]
-- =============================
-- ✅ [버그 수정] "매크로를 오래 켜두면 클릭 표시기(파란 원/십자)가 가끔 안 보임"
-- 진짜 원인 두 가지:
--   1) 표시기 ScreenGui에 ResetOnSpawn = false가 빠져 있었다. 로블록스는 기본값(true)인
--      ScreenGui를 캐릭터가 재설정될 때마다 PlayerGui에서 지워버린다. 표시기를 한 번만
--      만들어 재사용하도록 바꾼 뒤로는, 매크로가 처음으로 캐릭터를 재설정하는 순간(포션 제작,
--      레어 바이옴 팝핑, 상인 복귀 등) 표시기가 통째로 사라지고 다시는 안 생겼다.
--      (지난번 DisplayOrder 수정은 진짜 원인이 아니었음 - 오래 켜둘수록 재설정이 한 번은
--      일어나니까 "오래 켜두면" 증상으로 보였던 것)
--   2) 연달아 클릭하면, 이전 클릭이 걸어둔 페이드아웃 트윈이 취소되지 않고 계속 돌아서 새로
--      띄운 표시기까지 같이 투명하게 만들어버렸다(반쯤 보이거나 바로 사라짐).
-- 해결: ResetOnSpawn = false + 혹시 다른 이유로 지워져도 다음 클릭 때 자동으로 다시 만드는
-- 자가 복구 + 새 클릭이 오면 이전 페이드를 확실히 취소.
--
-- ✅ [최적화] 트윈 객체를 클릭마다 새로 만들지 않고 슬롯마다 한 번만 만들어 재생만 한다.
-- 페이드 예약도 클릭마다 task.delay를 쌓지 않고 슬롯당 감시 스레드 하나만 돈다(릴링 중엔
-- 초당 수십 번 호출되는 함수라 차이가 큼). 서로 다른 위치를 연달아 클릭해도 예전처럼 각각
-- 보이도록 슬롯 4개를 돌려 쓰고, 같은 자리 연타(릴링)는 같은 슬롯을 재사용한다.
-- 이 함수는 절대 에러를 던지지 않는다(클릭 직전에 불리므로, 여기서 에러가 나면 클릭 자체가
-- 씹힘).
local showPremiumIndicator
do
    local INDICATOR_COLOR = Color3.fromRGB(0, 160, 255) -- [BLUE] 요청하신 파란색 테마
    local POOL_SIZE = 4
    local SAME_SPOT_PX = 6
    local HOLD_TIME = 0.4
    local FADE_TIME = 0.6
    local EXPAND_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    local FADE_INFO = TweenInfo.new(FADE_TIME, Enum.EasingStyle.Linear)
    local SMALL_SIZE = UDim2.fromOffset(10, 10)
    local BIG_SIZE = UDim2.fromOffset(45, 45)

    local indicatorGui = nil
    local slots = {}

    local function isAlive(inst)
        return inst ~= nil and inst.Parent ~= nil and inst:IsDescendantOf(game)
    end

    local function buildSlot(parent)
        local container = Instance.new("Frame")
        container.Name = "Indicator"
        container.Size = SMALL_SIZE
        container.AnchorPoint = Vector2.new(0.5, 0.5)
        container.BackgroundTransparency = 1
        container.Visible = false
        container.Parent = parent

        local dot = Instance.new("Frame")
        dot.Size, dot.Position = UDim2.fromOffset(4, 4), UDim2.fromScale(0.5, 0.5)
        dot.AnchorPoint, dot.BackgroundColor3 = Vector2.new(0.5, 0.5), INDICATOR_COLOR
        dot.BorderSizePixel = 0
        dot.Parent = container
        Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

        local ring = Instance.new("Frame")
        ring.Size, ring.Position = UDim2.fromOffset(20, 20), UDim2.fromScale(0.5, 0.5)
        ring.AnchorPoint, ring.BackgroundTransparency = Vector2.new(0.5, 0.5), 1
        ring.Parent = container
        local stroke = Instance.new("UIStroke")
        stroke.Color, stroke.Thickness = INDICATOR_COLOR, 1.2
        stroke.Parent = ring
        Instance.new("UICorner", ring).CornerRadius = UDim.new(1, 0)

        local function makeLine(size)
            local line = Instance.new("Frame")
            line.Size, line.Position, line.AnchorPoint = size, UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5)
            line.BackgroundColor3, line.BorderSizePixel = INDICATOR_COLOR, 0
            line.Parent = container
            return line
        end
        local lineH = makeLine(UDim2.fromOffset(30, 1))
        local lineV = makeLine(UDim2.fromOffset(1, 30))

        local TS = Services.TweenService
        return {
            container = container,
            -- 링 자체는 항상 배경이 투명이라 제외, 링은 스트로크만 페이드한다
            fadeFrames = { dot, lineH, lineV },
            stroke = stroke,
            expandTween = TS:Create(container, EXPAND_INFO, { Size = BIG_SIZE }),
            fadeTweens = {
                TS:Create(dot, FADE_INFO, { BackgroundTransparency = 1 }),
                TS:Create(lineH, FADE_INFO, { BackgroundTransparency = 1 }),
                TS:Create(lineV, FADE_INFO, { BackgroundTransparency = 1 }),
                TS:Create(stroke, FADE_INFO, { Transparency = 1 }),
            },
            lastShowAt = 0,
            showCount = 0,
            x = -1e9,
            y = -1e9,
            watcherRunning = false,
        }
    end

    -- 표시기가 없거나(처음) 지워졌으면(재설정 등) 새로 만든다. 성공하면 true.
    local function ensureIndicator(forceRebuild)
        if not forceRebuild and indicatorGui and isAlive(indicatorGui) then
            return true
        end
        if indicatorGui then
            pcall(function() indicatorGui:Destroy() end)
        end
        indicatorGui, slots = nil, {}

        local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if not playerGui then return false end

        local newSlots = {}
        local ok, err = pcall(function()
            local g = Instance.new("ScreenGui")
            g.Name = "TacticalIndicatorGui"
            g.IgnoreGuiInset = true
            g.ResetOnSpawn = false -- ✅ 핵심: 캐릭터 재설정 때 지워지지 않게
            g.DisplayOrder = 2147483647
            for i = 1, POOL_SIZE do
                newSlots[i] = buildSlot(g)
            end
            g.Parent = playerGui
            indicatorGui = g
        end)
        if not ok then
            warn("[타겟 표시기 생성 오류] " .. tostring(err))
            indicatorGui = nil
            return false
        end
        slots = newSlots
        return true
    end

    -- 같은 자리 연타면 그 슬롯을, 아니면 가장 오래전에 쓴 슬롯을 고른다
    local function pickSlot(x, y)
        for _, slot in ipairs(slots) do
            if slot.container.Visible
                and math.abs(slot.x - x) <= SAME_SPOT_PX and math.abs(slot.y - y) <= SAME_SPOT_PX then
                return slot
            end
        end
        local oldest = slots[1]
        for _, slot in ipairs(slots) do
            if slot.lastShowAt < oldest.lastShowAt then
                oldest = slot
            end
        end
        return oldest
    end

    -- 슬롯당 하나만 도는 페이드 감시: 마지막 클릭 후 HOLD_TIME이 지나면 페이드, 페이드가 끝날
    -- 때까지 새 클릭이 없으면 숨김. 그 사이 새 클릭이 오면 다시 대기부터.
    local function startFadeWatcher(slot)
        if slot.watcherRunning then return end
        slot.watcherRunning = true
        task.spawn(function()
            local ok, err = pcall(function()
                while isAlive(slot.container) do
                    local waitLeft = (slot.lastShowAt + HOLD_TIME) - tick()
                    if waitLeft > 0 then
                        task.wait(waitLeft)
                    else
                        local countAtFade = slot.showCount
                        for _, tw in ipairs(slot.fadeTweens) do
                            tw:Play()
                        end
                        task.wait(FADE_TIME)
                        if slot.showCount == countAtFade then
                            slot.container.Visible = false
                            break
                        end
                    end
                end
            end)
            slot.watcherRunning = false
            if not ok then
                warn("[타겟 표시기 오류] " .. tostring(err))
            end
        end)
    end

    showPremiumIndicator = function(x, y)
        local ok, err = pcall(function()
            if not ensureIndicator(false) then return end
            local slot = pickSlot(x, y)
            if not (slot and isAlive(slot.container)) then
                if not ensureIndicator(true) then return end
                slot = pickSlot(x, y)
                if not slot then return end
            end

            slot.lastShowAt = tick()
            slot.showCount = slot.showCount + 1
            slot.x, slot.y = x, y

            -- ✅ 이전 클릭의 페이드/확대를 먼저 확실히 멈추고 처음 상태로 되돌린다
            for _, tw in ipairs(slot.fadeTweens) do
                tw:Cancel()
            end
            slot.expandTween:Cancel()
            for _, frame in ipairs(slot.fadeFrames) do
                frame.BackgroundTransparency = 0
            end
            slot.stroke.Transparency = 0
            slot.container.Position = UDim2.fromOffset(x, y)
            slot.container.Size = SMALL_SIZE
            slot.container.Visible = true
            slot.expandTween:Play()

            startFadeWatcher(slot)
        end)
        if not ok then
            warn("[타겟 표시기 오류] " .. tostring(err))
        end
    end
end

local function clickExactly(button)
    if button and button.AbsoluteSize.X > 0 and button.Visible then
        local absPos = button.AbsolutePosition
        local absSize = button.AbsoluteSize
        local topBarHeight = game:GetService("GuiService"):GetGuiInset().Y
        local centerX = absPos.X + (absSize.X / 2)
        local centerY = absPos.Y + (absSize.Y / 2) + topBarHeight

        showPremiumIndicator(centerX, centerY)
        Services.VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 0)
        task.wait(0.05)
        Services.VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 0)
        return true
    end
    return false
end

