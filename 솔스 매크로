                    username, leaveTimeFormatted, leaveTime, game.PlaceId),
                ["color"] = 0
            } }
        })
        pcall(function()
            requestFunc({
                Url = webhookUrl,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body =
                    leavePayload
            })
        end)
    end

    local coreGui = game:GetService("CoreGui")
    local promptOverlay = coreGui:FindFirstChild("RobloxPromptGui") and
