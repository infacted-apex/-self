    local function executeSolaraAdClick()
        local Camera = workspace.CurrentCamera
        local VirtualInputManager = Services.VirtualInputManager

        local refWidth = 1920
        local refHeight = 1080
        local refX = 1513
        local refY = 239

        local viewportSize = Camera.ViewportSize
        local currentWidth = viewportSize.X
        local currentHeight = viewportSize.Y

        local shiftStrength = 0.03
        local currentAspectRatio = currentWidth / currentHeight
        local baseAspectRatio = 16 / 9
        local extraRightShift = math.max(0, (currentAspectRatio - baseAspectRatio) * currentHeight * shiftStrength)

        local targetX = math.floor(currentWidth * (refX / refWidth) + extraRightShift)
        local targetY = math.floor(currentHeight * (refY / refHeight))

        -- 2회 연타 버스트 클릭 (Window Focus 누락 및 프레임 드랍 방지)
        for attempt = 1, 2 do
            if not checkToggles() then break end

            if mousemoveabs then
                mousemoveabs(targetX, targetY)
            end

            task.wait(0.15)

            if mouse1press and mouse1release then
                mouse1press()
                task.wait(0.08)
                mouse1release()
                myPrint(string.format("[SolaraAd] (%d차) mouse1press + release 클릭 완료!", attempt))
            elseif mouse1click then
                mouse1click()
                myPrint(string.format("[SolaraAd] (%d차) mouse1click 클릭 완료!", attempt))
            end

            -- 이중 방어: 가상 마우스 클릭 신호 동시 전송
            pcall(function()
                VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, true, game, 0)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, false, game, 0)
            end)

            if attempt < 2 then
                task.wait(0.3)
            end
        end
    end

