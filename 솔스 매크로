        local blacklist = {}
        -- 한번 이상 확인해서 이미 알고 있는 카드 정보 (frame -> cardID)
        local remembered = {}

        -- ✅ [제외 항목] Memory Match에 등장하는 "안 좋은 아이템"을 ImageID로 걸러냄.
        -- 실제 목록은 영구 탭 "메모리 매치 제외 아이템 입력칸"에서 설정한 값을 그대로 참조함
        -- (Settings.Sols.memoryMatchExcludedItems) - 입력칸을 바꾸면 바로 다음 체크부터 반영됨.

        -- 카드 안의 ZIndex=1 ImageLabel 오브젝트 자체를 반환 (getCardID / 제외 판정에서 공통 재사용)
        local function getCardImageLabel(cardFrame)
            if not cardFrame or not cardFrame.Parent then return nil end
            local inner = cardFrame:FindFirstChildWhichIsA("Frame")
            if not inner then return nil end
            for _, img in pairs(inner:GetChildren()) do
                if img:IsA("ImageLabel") and img.ZIndex == 1 then
                    return img
                end
            end
            return nil
        end

        -- 카드의 이미지가 제외 목록에 있는 "안 좋은 아이템"인지 판정
        local function isExcludedCardItem(cardFrame)
            local cImage = getCardImageLabel(cardFrame)
            if not cImage or cImage.Image == "" then return false end
            local excludedList = Settings.Sols.memoryMatchExcludedItems or {}
            return excludedList[cImage.Image] == true
        end

        local function isBlacklisted(cardFrame)
            if not cardFrame or not cardFrame.Parent then return true end
            if not cardFrame.Visible then return true end
            local inner = cardFrame:FindFirstChildWhichIsA("Frame")
            if inner and inner.BackgroundTransparency and inner.BackgroundTransparency >= 0.8 then
                return true
            end
            -- ✅ [제외 항목] 안 좋은 아이템(ImageID로 판별)은 매칭 대상에서 완전히 제외
            if isExcludedCardItem(cardFrame) then
                return true
            end
            return blacklist[cardFrame] == true
        end

        -- B 안의 Frame들 안의 Frame 안의 TextLabel Text & ZIndex=1 ImageLabel Image
        local function getCardID(cardFrame)
            if not cardFrame or not cardFrame.Parent then return nil end
            local inner = cardFrame:FindFirstChildWhichIsA("Frame")
            if not inner then return nil end

            local cText = inner:FindFirstChildWhichIsA("TextLabel")
            local cImage = getCardImageLabel(cardFrame)

            if cText and cImage and cImage.Image ~= "" then
                local rectStr = ""
                if cImage:IsA("ImageLabel") then
                    rectStr = tostring(cImage.ImageRectOffset.X) .. "_" .. tostring(cImage.ImageRectOffset.Y)
                end
                return cText.Text .. "_" .. cImage.Image .. "_" .. rectStr
            end
            return nil
        end

        -- 블랙리스트에 없는 유효한 B 내부 Frame들 추출
        local function getValidBFrames()
            if not B or not B.Parent then B = GetFrameB() end
            if not B then return {} end
            local list = {}
            for _, child in ipairs(B:GetChildren()) do
                if child:IsA("Frame") and not isBlacklisted(child) then
