    -- ✅ [사용자 요청] "Glitched" 텍스트 이펙트:
    --   1. 대소문자가 랜덤하게 뒤바뀜 (매 프레임이 아니라 0.15초 간격 - 너무 빠르면 정신없음)
    --   2. 대소문자가 바뀔 때마다 글자색이 랜덤하게 글리치처럼 바뀜
    --   3. 랜덤하게 위치가 팍 튀고(각도도 살짝 줌), Expo 이징으로 0.5초 안에 원래 자리로 복귀
    --
    -- ⚠️ innerLabel(자식 라벨)을 직접 움직인다 - 부모(containerLabel)가 UIListLayout이
    -- 관리하는 자리라면 Position/Rotation을 바꿔도 매번 되돌려져 튀는 모션이 반영되지 않음.
    --
    -- ✅ [사용자 요청] "화면상으로 없어진 건 완전히 제거" - isEnabledFn()이 false면, 루프는
    -- 텍스트/색/위치를 원래 상태로 되돌리고 아무 작업도 하지 않은 채 대기만 한다.
    --
    -- ✅ 스탯 UI에서도 동일한 이펙트를 재사용하기 위해 매개변수화된 함수로 뽑아둔다
    -- (대상 라벨/조건이 다를 뿐 로직은 완전히 동일).
    -- innerLabel: 실제로 텍스트/위치를 움직일 자식 라벨
    -- isEnabledFn: function() -> boolean, 이 이펙트가 지금 보여야 하는지
    -- suffixFn: (선택) function() -> string, 텍스트 뒤에 덧붙일 접미사 (예: " : 3번").
    -- 상태 UI에서는 안 넘기고(이름만), 스탯 UI에서는 개수 표시용으로 넘긴다.
    getgenv()._RunGlitchedEffect = function(innerLabel, isEnabledFn, suffixFn)
        local baseText = "Glitched"
        local rng = Random.new()
        local lastGlitchColor = "#FFFFFF"
        local isJumping = false

        while true do
            -- ✅ [안정화] 루프 본문 전체를 pcall로 감싸서, UI 인스턴스가 예기치 못하게
            -- 파괴되는 등의 이유로 한 프레임에서 에러가 나도 이 이펙트 자체가 영구히
            -- 멈추지 않고 다음 프레임에 계속 이어지게 한다.
            local ok, err = pcall(function()
                if not isEnabledFn() then
                    -- 꺼져 있으면 원래 상태로 정리하고 다음 틱까지 조용히 대기
                    if innerLabel.Rotation ~= 0 then innerLabel.Rotation = 0 end
                    if innerLabel.Position ~= UDim2.new(0, 0, 0, 0) then
                        innerLabel.Position = UDim2.new(0, 0, 0, 0)
                    end
                    task.wait(0.2)
                    return
                end

                -- 1+2. 대소문자 랜덤 토글 + 그때마다 색도 같이 글리치 (0.15초 간격)
                local chars = {}
                for i = 1, #baseText do
                    local c = baseText:sub(i, i)
                    if rng:NextNumber() < 0.5 then
                        chars[i] = c:upper()
                    else
                        chars[i] = c:lower()
                    end
                end
                local displayText = table.concat(chars)

                local glitchColors = { "#FFFFFF", "#AAAAAA", "#00FFFF", "#FF00FF", "#DDDDDD", "#EEEEEE" }
                lastGlitchColor = glitchColors[rng:NextInteger(1, #glitchColors)]

                -- ✅ [사용자 요청] 접미사(개수 등)는 이펙트 색과 무관하게 기본 값 색으로 붙인다.
                local suffix = suffixFn and suffixFn() or ""
                -- ✅ [치명적 버그 수정] "Glitched/Dreamspace가 안 보인다" - innerLabel(Inner
                -- 자식 라벨)이 생성 시점에 TextTransparency = 1(완전 투명)로 초기화되는데, 이
                -- 함수 안에는 그 값을 0으로 되돌리는 코드가 전혀 없었음(Cyberspace는 별도
                -- Inner 자식이 없어서 이 문제가 없었음). 매번 확실하게 선명한 상태로 맞춘다.
                innerLabel.TextTransparency = 0
                innerLabel.Text = string.format('<font color="%s">%s</font>%s', lastGlitchColor, displayText, suffix)

                -- 3. 랜덤하게 팍 튀고 Expo로 0.5초 안에 복귀
                -- ✅ [사용자 요청] 튀는 빈도를 약간 더 늘림 (0.35 -> 0.5)
                if not isJumping and rng:NextNumber() < 0.5 then
                    isJumping = true
                    local jumpX = rng:NextInteger(-6, 6)
                    -- ✅ [사용자 요청] 위아래 튀는 범위 2.5배 감소 (-4~4 -> -1.6~1.6, 정수라 -2~2로 반올림)
                    local jumpY = rng:NextInteger(-2, 2)
                    local jumpRot = rng:NextInteger(-8, 8)

                    innerLabel.Position = UDim2.new(0, jumpX, 0, jumpY)
                    innerLabel.Rotation = jumpRot

                    local returnTween = getgenv()._TweenService:Create(
                        innerLabel,
                        TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
                        { Position = UDim2.new(0, 0, 0, 0), Rotation = 0 }
                    )
                    returnTween:Play()
                    returnTween.Completed:Connect(function()
                        isJumping = false
                    end)
                end

                task.wait(0.15) -- 대소문자/색 전환 속도 (기존엔 매 프레임이라 너무 빨랐음)
            end)
            if not ok then
                warn("[Glitched 이펙트 오류] " .. tostring(err))
                task.wait(0.5) -- 연속 에러로 인한 CPU 과부하 방지
            end
        end
    end

    task.spawn(function()
        getgenv()._RunGlitchedEffect(glitchedTextInner, function()
            -- ✅ [최적화] 매크로가 꺼져 상태 UI가 안 보일 때도 이펙트가 계속 돌던 것을 멈춤
            return Settings.Sols.masterMacroEnabled and Settings.Sols.autoRareBiomePop and Settings.Sols.popGlitched and glitchedPopLabel.Visible
        end)
