-- ✅ [사용자 요청] "AAA 통계(All time All Account)" - Workspace/Zajak/SolsRNG/ 아래
-- 모든 계정(유저 ID) 폴더를 순회하며 각 계정의 올타임 통계 파일을 읽어서 하나로 합산한다.
local ALL_ACCOUNTS_ROOT = "Workspace/Zajak/SolsRNG/"
local function GetAllAccountsCombinedStats()
    local combined = {
        BiomeAppearCounts = {},
        BiomeColors = {},
        StrangeControllerUseCount = 0,
        BiomeRandomizerUseCount = 0,
        PotionCraftCompletedCount = 0,
        FishCaughtCount = 0,
        FishPointGainedTotal = 0,
        TotalUptimeSeconds = 0,
    }

    -- ✅ [치명적 버그 수정] "실시간 업데이트 및 작동 시간이 통합이 안 됨" - 기존엔 자기
    -- 자신(현재 실행 중인 계정)의 통계도 다른 계정과 똑같이 디스크 파일에서만 읽었다.
    -- 디스크 파일은 30초마다 한 번씩만 갱신되고, "지금 이 순간 진행 중인 세션 시간"
    -- 같은 실시간 값은 애초에 저장되지 않으므로, 매크로를 켜놓고 봐도 방금 오른 Fish
    -- Point나 지금까지 흐른 작동 시간이 전혀 반영되지 않았다. 자기 자신의 계정 폴더는
    -- 디스크 대신 메모리(getgenv()._AllTimeStats, 항상 최신)와 진행 중인 세션의 실시간
    -- 보정을 그대로 사용하고, 다른 계정들만 디스크 파일에서 읽어와 합산한다.
    local myStats = getgenv()._AllTimeStats
    local myTotalSec = (myStats.TotalUptimeSeconds or 0)
    if getgenv().MacroStartTime then
        myTotalSec = myTotalSec + (tick() - getgenv().MacroStartTime)
    end
    local myFishPoint = (myStats.FishPointGainedTotal or 0) + (getgenv().FishPointGained or 0)

    combined.StrangeControllerUseCount = myStats.StrangeControllerUseCount or 0
    combined.BiomeRandomizerUseCount = myStats.BiomeRandomizerUseCount or 0
    combined.PotionCraftCompletedCount = myStats.PotionCraftCompletedCount or 0
    combined.FishCaughtCount = myStats.FishCaughtCount or 0
    combined.FishPointGainedTotal = myFishPoint
    combined.TotalUptimeSeconds = myTotalSec
    for biomeName, count in pairs(myStats.BiomeAppearCounts or {}) do
        combined.BiomeAppearCounts[biomeName] = (combined.BiomeAppearCounts[biomeName] or 0) + (count or 0)
    end
    for biomeName, color in pairs(myStats.BiomeColors or {}) do
        combined.BiomeColors[biomeName] = color
    end

    if not (listfiles and isfile and readfile) then
        return combined
    end

    local ok, entries = pcall(listfiles, ALL_ACCOUNTS_ROOT)
    if not ok or not entries then
        return combined
    end

    -- ✅ 자기 자신의 계정 폴더는 위에서 이미 메모리 기준으로 처리했으므로, 디스크
    -- 읽기 단계에서는 건너뛴다(중복 합산 방지).
    local myAccountFolderNormalized = ACCOUNT_FOLDER:gsub("/$", "")

    for _, entryPath in ipairs(entries) do
        local normalizedEntry = entryPath:gsub("/$", "")
        if normalizedEntry ~= myAccountFolderNormalized then
            -- ✅ 계정 폴더(유저 ID로 된 하위 폴더) 안의 ZajakScript_AllTimeStats.json만 대상으로
            local statsPath = entryPath .. "/ZajakScript_AllTimeStats.json"
            if isfile(statsPath) then
                local readOk, data = pcall(readfile, statsPath)
                if readOk and data then
                    local decodeOk, decoded = pcall(function()
                        return HttpService:JSONDecode(data)
                    end)
                    if decodeOk and type(decoded) == "table" then
                        combined.StrangeControllerUseCount = combined.StrangeControllerUseCount +
                            (decoded.StrangeControllerUseCount or 0)
                        combined.BiomeRandomizerUseCount = combined.BiomeRandomizerUseCount +
                            (decoded.BiomeRandomizerUseCount or 0)
                        combined.PotionCraftCompletedCount = combined.PotionCraftCompletedCount +
                            (decoded.PotionCraftCompletedCount or 0)
                        combined.FishCaughtCount = combined.FishCaughtCount + (decoded.FishCaughtCount or 0)
                        combined.FishPointGainedTotal = combined.FishPointGainedTotal +
                            (decoded.FishPointGainedTotal or 0)
                        combined.TotalUptimeSeconds = combined.TotalUptimeSeconds + (decoded.TotalUptimeSeconds or 0)

                        if type(decoded.BiomeAppearCounts) == "table" then
                            for biomeName, count in pairs(decoded.BiomeAppearCounts) do
                                combined.BiomeAppearCounts[biomeName] = (combined.BiomeAppearCounts[biomeName] or 0) +
                                    (count or 0)
                            end
                        end
                        if type(decoded.BiomeColors) == "table" then
                            for biomeName, color in pairs(decoded.BiomeColors) do
                                if not combined.BiomeColors[biomeName] then
                                    combined.BiomeColors[biomeName] = color
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return combined
end
