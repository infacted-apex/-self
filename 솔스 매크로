        refs.potionCraftCountValueLabel2.Text = string.format('<font color="%s">%s번</font>', getgenv()._VALUE_COLOR,
            getgenv().PotionCraftCompletedCount or 0)

        -- ✅ [사용자 요청] Fish 통계 - 지금까지 낚은 물고기 수 / Fish Point 증가량
        refs.fishCaughtCountLabel.Text = string.format('<font color="%s">%s마리</font>', getgenv()._VALUE_COLOR,
            getgenv().FishCaughtCount or 0)
        local fishPointGained = getgenv().FishPointGained or 0
        refs.fishPointValueLabel.Text = string.format("%s", fishPointGained)
    end

