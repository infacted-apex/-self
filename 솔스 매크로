    local function RefreshObtainedItemIcons()
        local obtained = getgenv().MemoryMatchObtainedItems or {}
        local activeIds = {}

        -- ✅ [사용자 요청] "리스트에 없는(MemoryMatchItemDefinitions의 3종류 외의) 아이템도
        -- 떠야 함" - 미리 정의된 3종류만 순회하는 대신, 실제로 획득한 모든 이미지(obtained
        -- 테이블의 키)를 그대로 순회한다. 이름은 정의에 있으면 쓰고, 없으면 이미지만 표시.
        local nameByImageId = {}
        for _, def in pairs(MemoryMatchItemDefinitions) do
            nameByImageId[def.imageId] = def.name
        end

        for imageId, count in pairs(obtained) do
            if count and count > 0 then
                activeIds[imageId] = true
                if not obtainedItemIconCache[imageId] then
                    local iconFrame = Instance.new("Frame")
                    iconFrame.Name = "Icon_" .. (nameByImageId[imageId] or "Unknown")
                    iconFrame.Size = UDim2.new(0, 56, 0, 66)
                    iconFrame.BackgroundTransparency = 1
                    iconFrame.ZIndex = 1001
                    iconFrame.Parent = ObtainedItemsContainer

                    local iconLayout = Instance.new("UIListLayout")
                    iconLayout.SortOrder = Enum.SortOrder.LayoutOrder
                    iconLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
                    iconLayout.VerticalAlignment = Enum.VerticalAlignment.Top
                    iconLayout.Padding = UDim.new(0, 2)
                    iconLayout.Parent = iconFrame

                    local iconImage = Instance.new("ImageLabel")
                    iconImage.Name = "Image"
                    iconImage.LayoutOrder = 1
                    iconImage.Size = UDim2.new(0, 44, 0, 44)
                    iconImage.BackgroundTransparency = 1
                    iconImage.Image = imageId
                    iconImage.ZIndex = 1002
                    iconImage.Parent = iconFrame

                    local iconCountLabel = Instance.new("TextLabel")
                    iconCountLabel.Name = "Count"
                    iconCountLabel.LayoutOrder = 2
                    iconCountLabel.Size = UDim2.new(1, 0, 0, 18)
                    iconCountLabel.BackgroundTransparency = 1
                    iconCountLabel.FontFace = GetKoreanFont()
                    iconCountLabel.TextSize = 15
                    iconCountLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                    iconCountLabel.Text = tostring(count)
                    iconCountLabel.ZIndex = 1002
                    iconCountLabel.Parent = iconFrame

                    obtainedItemIconCache[imageId] = { frame = iconFrame, countLabel = iconCountLabel }
                else
                    obtainedItemIconCache[imageId].countLabel.Text = tostring(count)
                end
            end
        end

        for imageId, entry in pairs(obtainedItemIconCache) do
            if not activeIds[imageId] then
                entry.frame:Destroy()
                obtainedItemIconCache[imageId] = nil
            end
        end

        return next(activeIds) ~= nil
    end

