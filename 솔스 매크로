local function FindRecipeStepContainer(rootFrame)
    if not rootFrame then return nil end
    for _, f1 in ipairs(rootFrame:GetChildren()) do
        if f1:IsA("Frame") and f1.Visible
            and math.abs(f1.Position.X.Scale - 0.5) < 0.01 and math.abs(f1.Position.Y.Scale - 0.5) < 0.01 then
