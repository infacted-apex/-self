-- ✅ [치명적 버그 수정] 이전엔 RunAutoPotionCraft() 내부에 토글(Settings.Sols.autoPotionCraft)을
-- ✅ [사용자 요청] 아래 do...end 블록 안의 헬퍼 함수들(StopPotionCraftCleanly,
-- HandlePotionCraftEmergencyBoundary)이 메인 청크의 로컬 변수 슬롯을 하나씩 차지해서,
-- 파일이 이미 슬롯 한도(200개)에 근접해 있던 상태에서 추가되며 "Out of local registers"
-- 컴파일 에러가 났었음. RunAutoPotionCraft는 RegisterSingleAction에서 참조해야 하므로
-- 미리 선언해두고, 나머지 헬퍼들은 스코프 안에서만 쓰이도록 감싼다.
-- (IsPotionCraftToggleOff는 MoveToPlaceClickStyle/WaitUntilStationary에서도 필요해서
-- 이 파일 앞쪽으로 옮겨졌음)
local RunAutoPotionCraft
do
    -- 재확인하는 코드가 전혀 없었음. 감시 루프(RegisterSingleAction)는 1초마다 토글을 확인하지만,
    -- 그건 "다음 실행을 시작할지"만 결정할 뿐 이미 시작된 시퀀스 도중에는 전혀 개입 안 함.
    -- 그래서 실행 중에 토글을 꺼도 이미 시작된 사이클(이동 -> 클릭 3번 -> 마무리)이 전부 끝날
    -- 때까지 계속 진행됐음 - "가끔 토글을 꺼도 매크로가 작동하는" 문제의 원인. 패턴 경계마다
    -- 이 함수로 확인해서, 꺼졌으면 재설정 없이 즉시 자리를 비우고 종료한다.

    -- ✅ 토글이 꺼졌을 때 자리를 비우고 종료하는 처리를 여러 곳에서 반복해서
    -- 쓰다 보니 중복을 줄이기 위해 하나의 함수로 묶는다.
    local function StopPotionCraftCleanly()
        getgenv().PotionCraftWantsSlot = false
        StopMacro("PotionCraft")
        SetCurrentAction("")
    end

    -- 포션 자동 제작 실행 함수 - 전체 시퀀스
    -- 끝내기 패턴 + Emergency 대기까지 한 번에 처리하는 헬퍼.
    -- 패턴 경계에서 호출: Emergency 신호가 없으면 즉시 false 반환(계속 진행).
    -- 신호가 있으면 EmergencyReady를 켜서 "지금 끝내기 패턴 쓰고 안전하게 넘길게" 알리고,
    -- 끝내기 패턴(재설정 전 1초 대기 -> 재설정 -> 재설정 후 3초 대기)을 실행한 뒤, Emergency가
    -- 완전히 끝날 때까지 대기하고 true를 반환한다. 호출부는 true를 받으면 전체 동작을 한 번 더 재시도.
    local function HandlePotionCraftEmergencyBoundary()
        if not Settings.Emergency then return false end

        Settings.EmergencyReady = true

        -- 끝내기 패턴 (재설정 전 1초 -> 재설정 -> 재설정 후 3초)
        task.wait(1)
        ResetCharacter()
        task.wait(3)

        -- Emergency 행동이 다 끝날 때까지 대기 (넉넉한 리미트 10분)
        local emergencyWaitStart = tick()
        while Settings.Emergency and (tick() - emergencyWaitStart) < 600 do
            task.wait(0.5)
        end
        Settings.EmergencyReady = false
        return true
    end

    -- 포션 자동 제작 - 한 번 시도 (패턴 단위로 구성)
    -- ✅ [안정화] 예전엔 실패/Emergency 때마다 RunAutoPotionCraft()를 자기 자신 안에서 다시
    -- 불렀다(재귀). Luau는 꼬리 호출 최적화가 없어서 호출이 쌓이고, Place6에 계속 못 가는
    -- 상황이면 끝없이 재귀하면서 포션 제작이 자리를 영원히 쥐고 낚시 등 다른 기능을 전부 막았다.
    -- 이제 재시도가 필요하면 "retry"(이동 실패) / "retry_emergency"(Emergency 후 재시작)를
    -- 반환하고, 아래 RunAutoPotionCraft가 반복 횟수를 제한해서 다시 부른다.
    local function PotionCraftAttempt()
        if not CanStartMacro("PotionCraft") then
            return
        end
        StartMacro("PotionCraft")
        SetCurrentAction("포션 제작 - 재설정 및 부활 대기 중")

        -- ===== 시작 패턴 =====
        -- 재설정 및 부활까지 대기
        ResetCharacter()
        task.wait(0.5)
        -- ✅ [안정화] 부활 대기에 시간 제한 (예전엔 CharacterAdded:Wait()/WaitForChild가 무한 대기라
        -- 부활이 꼬이면 포션 제작이 자리를 쥔 채 영원히 멈췄음)
        local respawnWaitStart = tick()
        while not LocalPlayer.Character and (tick() - respawnWaitStart) < 15 do
            task.wait(0.1)
        end
        local char = LocalPlayer.Character
        if char then
            char:WaitForChild("HumanoidRootPart", 10)
        end
        task.wait(0.5)
        -- 1초 대기
        task.wait(1)

        -- ✅ [치명적 버그 수정] 패턴 경계마다 토글이 꺼졌는지 확인한다. 꺼졌으면 재설정
        -- 없이(이미 재설정은 위에서 했음) 곧바로 자리를 비우고 종료 - Emergency처럼
        -- "재시도"하면 안 됨, 사용자가 끈 거니까 그냥 멈춰야 함.
        if IsPotionCraftToggleOff() then
            StopPotionCraftCleanly()
            return
        end

        if HandlePotionCraftEmergencyBoundary() then
            return "retry_emergency"
        end

        -- ===== 이동 패턴 =====
        SetCurrentAction("포션 제작 - Place4로 이동 중")
        -- ✅ [사용자 요청] 실제 실행 순서가 코드 순서와 다르게(경유지 -> Place4 -> Place5) 나온
        -- 문제를 해결하기 위해, 이름표는 그대로 두고 두 좌표값 자체를 맞바꿨다. 이렇게 하면
        -- 게임의 클릭-투-이동 처리 순서와 무관하게, 실제 목표 좌표가 원하는 순서(Place4 위치 ->
        -- 경유지 위치 -> Place6)로 실행된다.
        MoveToPlaceClickStyle(Vector3.new(399.3959, 100.5000, -251.8907), "Place4")

        -- ✅ [사용자 요청] Place4는 "1.5초간 멈춰있어야 확인"(WaitUntilStationary) 대신,
        -- 목표 파트 근처에 도착한 게 감지되는 즉시 다음 이동으로 넘어간다. Place5/Place6에서
        -- 쓰던 "실제 파트와의 거리 확인" 방식을 여기서도 재사용하되, 정지 시간을 기다리지
        -- 않고 0.1초 간격으로 즉시 확인한다. 최대 대기는 WaitUntilStationary와 동일한 30초.
        do
            local place4Part = workspace:FindFirstChild("ScriptParts") and workspace.ScriptParts:FindFirstChild("Place4")
            local startTime4 = tick()
            while (tick() - startTime4) < 30 and not IsPotionCraftToggleOff() do
                local hrp4 = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if place4Part and hrp4 and (hrp4.Position - place4Part.Position).Magnitude < 10 then
                    break -- ✅ 도착 감지되는 즉시 루프 탈출, 곧바로 다음 이동으로
                end
                task.wait(0.1)
            end
        end

        -- ✅ [사용자 요청] 이름표 변경 - 경유지(기존 파트 이름 PotionWaypoint)를 Place5로.
        SetCurrentAction("포션 제작 - Place5로 이동 중")
        MoveToPlaceClickStyle(Vector3.new(531, 113, -210), "Place5")
        WaitUntilStationary(1.5)

        -- ✅ [사용자 요청] 이름표 변경 - 기존 Place5를 Place6으로.
        SetCurrentAction("포션 제작 - Place6로 이동 중")
        MoveToPlaceClickStyle(Vector3.new(-4648.5, 146, -232.5), "Place6")
        WaitUntilStationary(1.5)

        -- ✅ [사용자 요청] 캐릭터가 멈춰 있어도 실제로 최종 목적지(이제 이름이 Place6으로
        -- 바뀐) 파트와 겹쳐있는지 확인. 겹쳐있지 않으면(이동 실패) 시작 패턴부터 처음부터 다시 시도.
        local place6Part = workspace:FindFirstChild("ScriptParts") and workspace.ScriptParts:FindFirstChild("Place6")
        local reachedPlace6 = false
        if place6Part then
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp and (hrp.Position - place6Part.Position).Magnitude < 10 then
                reachedPlace6 = true
            end
        end

        if not reachedPlace6 then
            if IsPotionCraftToggleOff() then
                StopPotionCraftCleanly()
                return
            end
            SetCurrentAction("포션 제작 - 이동 실패, 처음부터 재시도")
            return "retry"
        end

        -- 0.5초 대기
        task.wait(0.5)

        if IsPotionCraftToggleOff() then
            StopPotionCraftCleanly()
            return
        end

        if HandlePotionCraftEmergencyBoundary() then
            return "retry_emergency"
        end

        -- ===== 상호작용 패턴 =====
        SetCurrentAction("포션 제작 - F키 입력 중")
        -- F키 한번 누르기
        Services.VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
        task.wait(0.1)
        Services.VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)

        -- ✅ [사용자 요청] ZIndex 999 페이드 대기 대신 단순히 3초 대기로 변경
        task.wait(3)

        if IsPotionCraftToggleOff() then
            StopPotionCraftCleanly()
            return
        end

        if HandlePotionCraftEmergencyBoundary() then
            return "retry_emergency"
        end

        -- ===== ui 오픈 및 오퍼 패턴 =====
        -- ui 오픈 패턴
        SetCurrentAction("포션 제작 - 재료 목록 탐색 중")
        local craftScreenGui = GetPotionCraftScreenGui()
        local rootFrame = GetPotionCraftRootFrame(craftScreenGui)
        local targetButton, potionViewport, itemContainer = FindPotionCraftTargetButton(rootFrame)

        -- ✅ [주의 리스트] 해당 색(0,99,87)의 ImageButton이 없으면 현재 자동 제작 중인 포션이
        -- 없다는 뜻이므로, 바로 끝내기 패턴을 실행하고 종료 (Emergency 재시도 아님 - 정상 종료)
        if not targetButton then
            SetCurrentAction("포션 제작 - 제작 중인 포션 없음, 종료")
            task.wait(1)
            ResetCharacter()
            task.wait(3)

            StopPotionCraftCleanly()
            return
        end

        SetCurrentAction("포션 제작 - 재료로 스크롤 중")
        ScrollToPotionButton(targetButton, potionViewport, itemContainer)
        -- 1초 대기
        task.wait(1)
        -- 그 ImageButton 클릭
        SetCurrentAction("포션 제작 - 재료 클릭 1번")
        clickExactly(targetButton)
        -- 0.5초 대기
        task.wait(0.5)

        -- "Open Recipe" 버튼 클릭
        rootFrame = GetPotionCraftRootFrame(GetPotionCraftScreenGui())
        local openRecipeBtn = FindOpenRecipeButton(rootFrame)
        if openRecipeBtn then
            SetCurrentAction("포션 제작 - Open Recipe 클릭")
            clickExactly(openRecipeBtn)
        end
        -- 0.5초 대기
        task.wait(0.5)

        if IsPotionCraftToggleOff() then
            StopPotionCraftCleanly()
            return
        end

        if HandlePotionCraftEmergencyBoundary() then
            return "retry_emergency"
        end

        -- 오퍼 패턴: 세 번의 클릭 ({0,0} -> 0.25초 -> {1,0} -> 0.25초 -> {0,0})
        rootFrame = GetPotionCraftRootFrame(GetPotionCraftScreenGui())
        local stepContainer = FindRecipeStepContainer(rootFrame)
        if stepContainer then
            local btnA = FindImageButtonByPosition(stepContainer, 0, 0)
            if btnA then
                SetCurrentAction("포션 제작 - 클릭 1번")
                clickExactly(btnA)
            end
            task.wait(0.25)

            stepContainer = FindRecipeStepContainer(GetPotionCraftRootFrame(GetPotionCraftScreenGui()))
            local btnB = stepContainer and FindImageButtonByPosition(stepContainer, 1, 0)
            if btnB then
                SetCurrentAction("포션 제작 - 클릭 2번")
                clickExactly(btnB)
            end
            task.wait(0.25)

            stepContainer = FindRecipeStepContainer(GetPotionCraftRootFrame(GetPotionCraftScreenGui()))
            local btnC = stepContainer and FindImageButtonByPosition(stepContainer, 0, 0)
            if btnC then
                SetCurrentAction("포션 제작 - 클릭 3번")
                clickExactly(btnC)
            end
        end

        if IsPotionCraftToggleOff() then
            StopPotionCraftCleanly()
            return
        end

        if HandlePotionCraftEmergencyBoundary() then
            return "retry_emergency"
        end

        -- ===== 끝내기 패턴 =====
        SetCurrentAction("포션 제작 - 마무리 재설정 대기 중")
        -- 재설정 전 1초 대기
        task.wait(1)
        -- 재설정 하기
        ResetCharacter()
        -- 재설정 후 3초 대기
        task.wait(3)

        StopPotionCraftCleanly()
    end

    -- ✅ [안정화] 이동 실패 재시도는 최대 3번. 그래도 안 되면 포기하고 2분 동안 포션 제작 신호를
    -- 무시해서(IsPotionCraftSignaled 참고) 낚시 등 다른 기능이 계속 돌 수 있게 한다.
    -- Emergency로 인한 재시작은 횟수에 넣지 않는다(레어 바이옴이 끝나면 정상적으로 다시 해야 하므로).
    local MAX_POTION_MOVE_RETRIES = 3
    RunAutoPotionCraft = function()
        local moveFailures = 0
        local emergencyRestarts = 0
        while true do
            local result = PotionCraftAttempt()
            if result == "retry" then
                moveFailures = moveFailures + 1
            elseif result == "retry_emergency" then
                emergencyRestarts = emergencyRestarts + 1
            else
                return -- 정상 종료 / 토글 꺼짐 / 자리 없음
            end

            if IsPotionCraftToggleOff() then
                StopPotionCraftCleanly()
                return
            end
            if moveFailures >= MAX_POTION_MOVE_RETRIES or emergencyRestarts >= 10 then
                warn("[포션 제작] 재시도 한도 초과 - 2분 뒤에 다시 시도")
                SetCurrentAction("포션 제작 - 계속 실패, 잠시 쉼")
                task.wait(1)
                ResetCharacter()
                task.wait(3)
                getgenv()._PotionCraftCooldownUntil = tick() + 120
                StopPotionCraftCleanly()
                return
            end
        end
    end
end

