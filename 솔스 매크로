        -- 혹시 이전에 이미 떠 있던 HUD가 있다면 그것도 함께 지움.
        local function updateDebugHud(statusText, labelText, parsedNum, validCardCount)
            local existingHud = LocalPlayer.PlayerGui:FindFirstChild("MemoryMatchDebugHud")
            if existingHud then
                existingHud:Destroy()
            end
        end

        local function checkIsZeroChances()
            local label = GetCountLabel()
            local labelText = label and label.Text or nil
            if label and label.Text then
                local clean = label.Text:gsub("%s+", "")
                local num = clean:match("^(%d+)$") or clean:match("(%d+)")
                if num and tonumber(num) == 0 then
                    return true, tostring(label.Text), labelText
                end
            end
            return false, nil, labelText
        end

        local function checkEmergency()
            if Settings and Settings.Emergency then
                SetCurrentAction("메모리 매치 - Emergency 대기 중")
                updateDebugHud("Emergency 대기 중", "N/A", "N/A", 0)

                local mainB = GetMemoryMatchMainFrame()
                if mainB and not mainB.Visible then
                    repeat task.wait(0.2) until (mainB and mainB.Visible) or not (Settings and Settings.Emergency)
                end

                if Settings and Settings.Emergency then
                    -- 1. B 비활성화 전 1초 대기
                    task.wait(1)
                    if mainB then mainB.Visible = false end
                    task.wait(1) -- 비활성화 후 1초 대기

                    -- Emergency 진행
                    Settings.EmergencyReady = true
                    SetCurrentAction("메모리 매치 - Emergency 처리 중")
                    -- ✅ [버그 수정] 무한 루프 방지용 넉넉한 리미트 (최대 10분)
                    local emergencyWaitStart2 = tick()
                    while Settings and Settings.Emergency and (tick() - emergencyWaitStart2) < 600 do
                        task.wait(0.5)
                    end
                    Settings.EmergencyReady = false

                    -- 2. Emergency 종료 후 B 재활성화 전/후 1초 대기
                    task.wait(1)
                    if mainB then mainB.Visible = true end
                    task.wait(1)
                    getgenv().MemoryMatchActive = true
                    getgenv().IsFlexibilityState = true
                    SetCurrentAction("메모리 매치 - Emergency 종료, 이어서 진행")
                end
            end
        end

        -- 반복 A: CountLabel Text 값이 0이 될 때까지
        -- ✅ [버그 수정] 무한 루프 방지용 넉넉한 리미트 (최대 10분)
        local matchLoopStart = tick()
        while true do
            checkEmergency()

            if not checkToggles() then
                updateDebugHud("매크로 끔", "N/A", "N/A", 0)
                break
            end

            if (tick() - matchLoopStart) > 1200 then
                updateDebugHud("게임 종료 (시간 초과)", "N/A", "N/A", 0)
                break
            end

            local isZero, zeroText, currentText = checkIsZeroChances()
            local validFrames = getValidBFrames()
            local curLabel = GetCountLabel()
            local rawText = curLabel and curLabel.Text or currentText or "못 찾음"
            local parsedNum = rawText:match("(%d+)")

            updateDebugHud("플레이 중", rawText, parsedNum, #validFrames)

            if isZero then
                updateDebugHud("게임 종료 (기회 0 감지!)", rawText, "0", #validFrames)
                break
            end

            if #validFrames == 0 then
                updateDebugHud("게임 종료 (남은 카드 없음)", rawText, parsedNum, 0)
                break
            end

            task.wait(1) -- 1초 대기 후 반복 A-1 진행

            checkEmergency()

            -- 이미 알고 있는 짝(중복)이 2개 존재하는지 확인
            local knownPair = nil
            for f1, id1 in pairs(remembered) do
                if not isBlacklisted(f1) then
                    for f2, id2 in pairs(remembered) do
                        if f1 ~= f2 and not isBlacklisted(f2) and id1 == id2 then
                            knownPair = { f1, f2 }
                            break
                        end
                    end
                end
                if knownPair then break end
            end

            if knownPair then
                -- 짝수 번째 클릭 완료: 중복 발견된 B 프레임을 각각 1번씩 클릭 (2초 간격)
                SetCurrentAction("메모리 매치 - 발견된 짝 클릭 중")
                local card1, card2 = knownPair[1], knownPair[2]

                -- ✅ [치명적 버그 수정] 스탯 UI의 "메모리 매치에서 획득한 아이템들" 리스트가
                -- 전혀 안 뜨는 문제의 원인 - remembered[card1](getCardID가 만드는
                -- "텍스트_이미지경로_오프셋" 합성 문자열)을 저장했는데, 표시 쪽은 순수
                -- 이미지 경로(rbxassetid://...)만으로 비교해서 절대 일치하지 않았음.
                -- getCardImageLabel로 순수 이미지 경로를 직접 가져와서 저장한다.
                --
                -- ✅ [사용자 요청] 카드 안의 텍스트(cText)가 실제 획득 개수를 나타내는데,
                -- 항상 +1로만 카운트하던 문제. 카드의 텍스트를 숫자로 읽어서 그만큼 더한다
                -- (숫자로 읽을 수 없으면 안전하게 1개로 간주).
                local matchedCardImage = getCardImageLabel(card1)
                local matchedItemId = matchedCardImage and matchedCardImage.Image or nil
                local matchedInner = card1:FindFirstChildWhichIsA("Frame")
                local matchedCardText = matchedInner and matchedInner:FindFirstChildWhichIsA("TextLabel")
                local matchedQuantity = 1
                if matchedCardText then
                    local parsedNum = tonumber((matchedCardText.Text:gsub("[^%d]", "")))
                    if parsedNum and parsedNum > 0 then
                        matchedQuantity = parsedNum
                    end
                end

                ClickGui(card1)
                task.wait(2)
                ClickGui(card2)
                task.wait(3)

                blacklist[card1] = true
                blacklist[card2] = true
                remembered[card1] = nil
                remembered[card2] = nil

                if matchedItemId and matchedItemId ~= "" then
                    if not getgenv().MemoryMatchObtainedItems then
                        getgenv().MemoryMatchObtainedItems = {}
                    end
                    getgenv().MemoryMatchObtainedItems[matchedItemId] =
                        (getgenv().MemoryMatchObtainedItems[matchedItemId] or 0) + matchedQuantity
                    -- ✅ [사용자 요청] 올타임 통계에도 같이 누적
                    getgenv()._AllTimeAddObtainedItem(matchedItemId, matchedQuantity)
                end
            else
                -- 짝이 없다면: 이미 확인한 프레임 및 블랙리스트 제외, 랜덤한 1개 클릭 (홀수 클릭)
                local unclickedPool = {}
                for _, f in ipairs(validFrames) do
                    if not remembered[f] and not isBlacklisted(f) then
                        table.insert(unclickedPool, f)
                    end
                end

                -- ✅ [버그 수정] 안 뒤집은 카드가 하나도 없으면(전부 이미 remembered에 있음)
                -- 이미 클릭한 카드를 랜덤으로 골라 재클릭하던 문제가 있었음. 이 상태에선
                -- 아무것도 클릭하지 않고, 다음 반복의 knownPair 확인이 알아서 짝을 찾게 둔다.
                if #unclickedPool == 0 then
                    SetCurrentAction("메모리 매치 - 대기 중 (안 뒤집은 카드 없음)")
                else
                    local firstCard = unclickedPool[math.random(1, #unclickedPool)]

                    SetCurrentAction("메모리 매치 - 카드 클릭 1번 (홀수)")
                    ClickGui(firstCard)
                    task.wait(3) -- 3초 대기

                    local id1 = getCardID(firstCard)
                    if id1 then remembered[firstCard] = id1 end

                    -- ✅ [제외 항목] 방금 뒤집은 카드가 "안 좋은 아이템"이면, 짝이 이미 있어도(홀수
                    -- 후 중복 발견) 짝수 클릭으로 새로 짝을 찾으려는 시도도 하지 않고 완전히 건너뛴다.
                    if isExcludedCardItem(firstCard) then
                        blacklist[firstCard] = true
                        remembered[firstCard] = nil

                        -- ✅ [치명적 버그 수정] 카드 하나만 뒤집고 두 번째 클릭을 안 하면,
                        -- 게임 내부적으로 이 카드가 "짝을 기다리는 상태"로 계속 열려있게 되어서
                        -- 다음번 아무 카드나 뒤집을 때 그게 이 카드와 잘못 비교되어버림
                        -- (이미 클릭한 카드 재클릭, 진짜 짝을 못 맞추는 등 온갖 문제의 원인이었음).
                        -- 제외 카드라도 반드시 다른 카드를 하나 더 클릭해서 대기 상태를 해소해야 함.
                        -- ✅ [버그 수정] remembered(이미 클릭해서 앞면 상태이거나 애매한) 카드는
                        -- 마무리 클릭 대상에서 제외 - 확실히 안 뒤집은(뒷면) 카드만 골라야 함.
                        -- 안 그러면 이미 클릭한 곳을 또 클릭하는 문제가 생김.
                        local closeoutPool = {}
                        for _, f in ipairs(validFrames) do
                            if f ~= firstCard and not remembered[f] and not isBlacklisted(f) then
                                table.insert(closeoutPool, f)
                            end
                        end
                        if #closeoutPool > 0 then
                            local closeoutCard = closeoutPool[math.random(1, #closeoutPool)]
                            SetCurrentAction("메모리 매치 - 마무리 클릭 (제외 항목 처리)")
                            ClickGui(closeoutCard)
                            task.wait(3)
                            if isExcludedCardItem(closeoutCard) then
                                blacklist[closeoutCard] = true
                                remembered[closeoutCard] = nil
                            else
                                local closeoutId = getCardID(closeoutCard)
                                if closeoutId then remembered[closeoutCard] = closeoutId end
                            end
                        end
                    else
                        -- ! - 만약 이미 클릭을 해서 홀수가 되었는데 그 때에 중복이 발견된다면, 그걸 누르기
                        local matchedSecondCard = nil
                        if id1 then
                            for f, id in pairs(remembered) do
                                if f ~= firstCard and not isBlacklisted(f) and id == id1 then
                                    matchedSecondCard = f
                                    break
                                end
                            end
                        end

                        local secondCard = nil
                        if matchedSecondCard then
                            secondCard = matchedSecondCard
                        else
                            -- 중복이 없으면: 1번째 카드가 아니고 + 아직 탐색 안 한 프레임 중 랜덤 1개 선택 (짝수 클릭)
                            local secondPool = {}
                            for _, f in ipairs(validFrames) do
                                if f ~= firstCard and not remembered[f] and not isBlacklisted(f) then
                                    table.insert(secondPool, f)
                                end
                            end

                            if #secondPool > 0 then
                                secondCard = secondPool[math.random(1, #secondPool)]
                            else
                                local fallbackPool = {}
                                for _, f in ipairs(validFrames) do
                                    if f ~= firstCard and not isBlacklisted(f) then
                                        table.insert(fallbackPool, f)
                                    end
                                end
                                if #fallbackPool > 0 then
                                    secondCard = fallbackPool[math.random(1, #fallbackPool)]
                                end
                            end
                        end

                        if secondCard then
                            SetCurrentAction("메모리 매치 - 카드 클릭 2번 (짝수)")
                            ClickGui(secondCard)
                            task.wait(3) -- 3초 대기

                            local id2 = getCardID(secondCard)
                            if id2 then remembered[secondCard] = id2 end

                            -- ✅ [제외 항목] 방금 뒤집은 두 번째 카드가 제외 대상이면, 이미지가
                            -- 일치해도(짝수 클릭) 매칭을 확정하지 않는다.
                            if isExcludedCardItem(secondCard) then
                                blacklist[secondCard] = true
                                remembered[secondCard] = nil
                            elseif id1 and id2 and id1 == id2 then
                                blacklist[firstCard] = true
                                blacklist[secondCard] = true
                                remembered[firstCard] = nil
                                remembered[secondCard] = nil

                                -- ✅ [치명적 버그 수정] id1(getCardID의 합성 문자열, "텍스트_이미지경로_오프셋")
                                -- 대신 순수 이미지 경로(cImage.Image)를 저장해야 표시될 수 있음.
                                -- ✅ [사용자 요청] 카드의 텍스트(숫자)를 읽어서 그만큼 카운트에 더한다.
                                local matchedCardImage2 = getCardImageLabel(secondCard)
                                local matchedItemId2 = matchedCardImage2 and matchedCardImage2.Image or nil
                                local matchedInner2 = secondCard:FindFirstChildWhichIsA("Frame")
                                local matchedCardText2 = matchedInner2 and
                                    matchedInner2:FindFirstChildWhichIsA("TextLabel")
                                local matchedQuantity2 = 1
                                if matchedCardText2 then
                                    local parsedNum2 = tonumber((matchedCardText2.Text:gsub("[^%d]", "")))
                                    if parsedNum2 and parsedNum2 > 0 then
                                        matchedQuantity2 = parsedNum2
                                    end
                                end
                                if matchedItemId2 and matchedItemId2 ~= "" then
                                    if not getgenv().MemoryMatchObtainedItems then
                                        getgenv().MemoryMatchObtainedItems = {}
                                    end
                                    getgenv().MemoryMatchObtainedItems[matchedItemId2] =
                                        (getgenv().MemoryMatchObtainedItems[matchedItemId2] or 0) + matchedQuantity2
                                    -- ✅ [사용자 요청] 올타임 통계에도 같이 누적
                                    getgenv()._AllTimeAddObtainedItem(matchedItemId2, matchedQuantity2)
                                end
                            else
                                -- ✅ [버그 수정] 진짜 안 맞은 경우(불일치) - 게임이 두 카드를 다시
                                -- 뒷면으로 뒤집는 애니메이션이 끝날 시간을 안 주고 바로 다음 라운드로
                                -- 넘어가서, 아직 뒤집히는 중인 카드를 너무 빨리 재클릭해 무반응이
                                -- 나던 문제가 있었음. firstCard/secondCard의 remembered 기록은
                                -- (뒷면으로 돌아가도 카드 정체성 자체는 그대로이므로) 그대로 유지하되,
                                -- 애니메이션이 끝나도록 추가로 여유를 준다.
                                task.wait(2)
                            end
                        end
                    end
                end
            end
        end

        getgenv().MemoryMatchActive = false

        -- B 안의 ImageButton의 Visible 값이 켜지면 1초 대기 후 B 안의 ImageButton 1번 클릭
        local function GetEndButtonB()
            local mainBFrame = GetMemoryMatchMainFrame()
            if not mainBFrame then return nil end
            local cardBoardFrame = GetFrameB()

            for _, desc in ipairs(mainBFrame:GetDescendants()) do
                if desc:IsA("ImageButton") or desc:IsA("TextButton") then
                    if not cardBoardFrame or not desc:IsDescendantOf(cardBoardFrame) then
                        return desc
                    end
                end
            end
            return nil
        end

        SetCurrentAction("메모리 매치 - 종료 버튼 대기 중")
        local bEndBtn = GetEndButtonB()
        if bEndBtn then
            -- ✅ [안정화] 시간 제한 추가 - 예전엔 종료 버튼이 끝내 안 보이면 자리를 쥔 채 영원히
            -- 기다려서 다른 모든 기능이 멈췄다.
            local endBtnWaitStart = tick()
            while not bEndBtn.Visible and checkToggles() and (tick() - endBtnWaitStart) < 30 do
                task.wait(0.5)
            end
        else
            local startTime = tick()
            while tick() - startTime < 8 and checkToggles() do
                bEndBtn = GetEndButtonB()
                if bEndBtn and bEndBtn.Visible then break end
                task.wait(0.5)
            end
        end

        task.wait(1)

        if not checkToggles() then return end

        if bEndBtn then
            SetCurrentAction("메모리 매치 - 종료 버튼 클릭")
            ClickGui(bEndBtn)
        end

        -- 메모리 매치가 끝나면 Place3으로 간 뒤 E키 1번 누르기
        task.wait(1)

        SetCurrentAction("메모리 매치 - 종료 후 Place3으로 이동 중")
        moveToPlace3AutoFishStyle()
        if not checkToggles() then return end
        task.wait(0.5)

        -- ✅ [사용자 요청] 메모리 매치를 할 때도 화면을 위에서 아래로 내려다보는 각도가
        -- 되게 한다 (상인 자동 구매/오토 미니게임과 동일한 방식).
        -- ✅ [치명적 버그 수정] 카메라 조작 구간에서 에러가 나도 반드시 복구되도록 pcall로 감쌈.
        SetCurrentAction("메모리 매치 - 종료 화면 직하향 중")
        local mmCam3 = workspace.CurrentCamera
        if mmCam3 then
            mmCam3.CameraType = Enum.CameraType.Scriptable
        end

        pcall(function()
            local mmChar3 = LocalPlayer.Character
            local mmHrp3 = mmChar3 and mmChar3:FindFirstChild("HumanoidRootPart")
            if mmCam3 and mmHrp3 then
                mmCam3.CFrame = CFrame.new(mmHrp3.Position + Vector3.new(0, 15, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
            end
        end)

        task.wait(1)

        -- ✅ [치명적 버그 수정] "카메라 직하향은 하는데 E키를 안 누름" - 카메라 조작에서
        -- 에러가 나도 E키 입력은 반드시 별도로 시도되도록 완전히 분리된 pcall로 감쌈.
        pcall(function()
            SetCurrentAction("메모리 매치 - 종료 E키 입력 중")
            Services.VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(0.1)
            Services.VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            task.wait(0.5)
        end)

        -- ✅ 화면을 위로 향한 상태 그대로 유지, CameraType만 다시 조작 가능하게.
        if mmCam3 then
            local mmKeepCFrame3 = mmCam3.CFrame
            mmCam3.CameraType = Enum.CameraType.Custom
            mmCam3.CFrame = mmKeepCFrame3
        end

        -- ✅ [치명적 버그 수정] 기존엔 E키 누른 뒤 0.5초 딱 한 번만 대기하고 바로
        -- innerFrame.Visible을 확인해서, 게임 쪽 UI가 그 짧은 시간 안에 아직 갱신이
        -- 안 됐으면 "다음 라운드 없음"으로 오판하고 그냥 끝내버렸음. 최대 3초까지
        -- 0.1초 간격으로 재확인해서, 실제로 다음 라운드가 있는데도 대기를 안 하고
        -- 없다고 판단해버리는 문제를 없앤다.
        local endA = nil
        local innerFrame = nil
        local visibleWaitStart = tick()
        while (tick() - visibleWaitStart) < 3 do
            endA = GetFrameA()
            innerFrame = endA and endA:FindFirstChildWhichIsA("Frame")
            if innerFrame and innerFrame.Visible then
                break
            end
            task.wait(0.1)
        end

        -- ✅ [버그 수정] "원래대로 진행합니다"라고 로그만 찍고 실제로는 그냥 종료 정리로
        -- 떨어지던 문제. Visible이 켜져있으면 진짜로 함수를 다시 실행해서 이어가야 함.
        if innerFrame and innerFrame.Visible then
            -- 종료 정리(MemoryMatchActive=false, A.Visible=false, StopMacro)를 타지 않고
            -- 함수를 다시 실행해서 새 라운드 감지·진행을 그대로 이어간다.
            -- ✅ [안정화] 자기 자신을 다시 부르는(재귀) 대신 "again"을 반환하고, 감시 루프의
            -- run()이 반복해서 다시 부른다(Luau는 꼬리 호출 최적화가 없어 재귀가 계속 쌓임).
            return "again"
        end
        if getgenv().CurrentActiveFeature == "MemoryMatch" then
            getgenv().CurrentActiveFeature = nil
        end
    end
    getgenv().MemoryMatchActive = false
    if getgenv().CurrentActiveFeature == "MemoryMatch" then
        getgenv().CurrentActiveFeature = nil
    end

    -- ✅ [사용자 요청] 메모리 매치가 종료되면 A의 Visible 값을 꺼준다.
    local finalA = GetFrameA()
    if finalA then
        finalA.Visible = false
    end

    -- ✅ [우선순위 시스템] Memory Match 종료
    StopMacro("MemoryMatch")
end

-- 메모리 매치 감시 루프 - RegisterSingleAction 등록 방식으로 배선
RegisterSingleAction({
    name = "MemoryMatch",
    signalFlagName = "MemoryMatchWantsSlot",
    logName = "메모리 매치",
    isEnabled = function()
        return Settings.Sols.autoMemoryMatch and Settings.Sols.masterMacroEnabled
    end,
    -- ✅ IsMemoryMatchSignaled()는 UI를 직접 스캔하는 "느린" 버전인데, 이걸 매 틱마다
    -- 호출하면서 그 결과로 캐시된 플래그(MemoryMatchWantsSlot)도 같이 갱신한다.
    -- 다른 곳(doFlexibility 등)에서는 이 캐시된 값(IsMemoryMatchSignaledFast)만 읽는다.
    isSignaled = function()
        local uiSignaled = IsMemoryMatchSignaled()
        if not getgenv().MemoryMatchActive then
            getgenv().MemoryMatchWantsSlot = uiSignaled
        end
        return uiSignaled
    end,
    -- ✅ [안정화] RegisterSingleAction이 config.run을 자체적으로 pcall로 감싸긴 하지만,
    -- 그 보호는 "MacroPriority 자리(MemoryMatch)"만 정리해줄 뿐 getgenv().MemoryMatchActive
    -- 플래그는 손대지 않는다. 만약 RunAutoMemoryMatchLogic 실행 도중(MemoryMatchActive를
    -- true로 세팅한 이후) 예상 못한 에러가 나면, 그 플래그가 true로 영구히 남아서
    -- IsMemoryMatchSignaledFast()가 항상 true를 반환 -> 낚시를 포함한 모든 기능이 "메모리
    -- 매치가 진행 중"이라고 오판해 영구 대기에 빠지는 심각한 문제가 있었음. 여기서 직접
    -- pcall로 감싸서, 에러가 나도 반드시 플래그와 자리를 정리하도록 한다.
    -- ✅ [안정화] RunAutoMemoryMatchLogic 안에는 정리(자리 반납)를 건너뛰고 그냥 return하는
    -- 경로가 여러 군데 있었다(예: 메모리 매치 창 A를 못 찾음). 그러면 메모리 매치가 자리를 쥔
    -- 채로 끝나서, "메모리 매치 진행 중" 신호가 계속 켜져 있고 낚시를 포함한 다른 모든 기능이
    -- 영구히 대기했다(오래 켜두면 매크로가 그냥 멈춰있는 증상의 원인 중 하나). 이제 어떤
    -- 경로로 끝나든 여기서 반드시 정리한다(정상 종료 경로에서 이미 정리됐어도 다시 해도 무해).
    run = function()
        local rounds = 0
        while true do
            rounds = rounds + 1
            local ok, result = pcall(RunAutoMemoryMatchLogic)
            if not ok then
                warn("[메모리 매치 오류] " .. tostring(result))
                break
            end
            -- 다음 라운드가 바로 이어지면 다시 실행 (안전장치로 최대 10라운드 연속)
            if result ~= "again" or rounds >= 10 then
                break
            end
        end
        getgenv().MemoryMatchActive = false
        if getgenv().CurrentActiveFeature == "MemoryMatch" then
            getgenv().CurrentActiveFeature = nil
        end
        if MacroPriority.IsActive.MemoryMatch then
            StopMacro("MemoryMatch")
        end
    end,
    onDisable = function()
        if getgenv().MemoryMatchActive then
            getgenv().MemoryMatchActive = false
        end
    end
})

