                    iconImage.ZIndex = 1001
                    iconImage.ImageTransparency = 0
                    iconImage.Parent = ExcludedItemsContainer

                    excludedIconCache[def.name] = iconImage
                end
            end
        end

        -- 더 이상 제외 목록에 없는 아이콘은 제거
        for name, iconInstance in pairs(excludedIconCache) do
            if not activeNames[name] then
                iconInstance:Destroy()
                excludedIconCache[name] = nil
            end
        end

        return next(activeNames) ~= nil
    end

