    getgenv()._UpdateStatsUI = function()
        local refs = getgenv()._StatsUIRefs

        -- 일반 바이옴 등장 횟수 - 색은 "인식중인 바이옴"과 동일한 방식(게임 알림의
        -- 실제 텍스트 색)을 쓴다. 각 바이옴이 마지막으로 떴을 때의 색을 개별 저장해뒀다가
        -- 재사용하므로, 새 바이옴이 떠도 다른 바이옴들의 색 정보가 사라지지 않는다.
        local counts = getgenv().BiomeAppearCounts or {}
        local biomeColors = getgenv().BiomeColors or {}
        for _, biomeName in ipairs(refs.NORMAL_BIOME_ORDER) do
            local label = refs.normalBiomeLabels[biomeName]
            local count = counts[biomeName]
            if count and count > 0 then
                label.Visible = true
                local colorHex = nil
                local c = biomeColors[biomeName]
                if c then
                    colorHex = string.format("#%02X%02X%02X", c.R * 255, c.G * 255, c.B * 255)
                end
                -- ✅ [사용자 요청] 색은 바이옴 이름(SNOWY)에만 입히고, 콜론(:)과 개수는
                -- 항상 기본 색을 유지해야 하는데, 기존엔 콜론까지 이름과 같은 <font> 태그
                -- 안에 있어서 같이 물들여지고 있었음. 콜론을 별도 태그로 분리한다.
                local nameColor = colorHex or getgenv()._LABEL_COLOR
                label.Text = string.format(
                    '<font color="%s">%s</font><font color="%s"> :</font> <font color="%s">%s번</font>',
                    nameColor, biomeName, getgenv()._LABEL_COLOR, getgenv()._VALUE_COLOR, count
                )
            else
                label.Visible = false
            end
        end

        -- ✅ [치명적 버그 수정] 레어 바이옴(Glitched/Dreamspace/Cyberspace) 라벨들이
        -- "팝핑 대상 토글이 켜져 있는지"만 확인해서, 실제로 한 번도 안 뜬 상태에서도
        -- 계속 보이고 있었음. 일반 바이옴과 동일하게, 실제 등장 횟수(BiomeAppearCounts)가
        -- 1 이상일 때만 보이도록 통일한다.
        local rareCounts = getgenv().BiomeAppearCounts or {}
        local rareBiomePopOn = Settings.Sols.autoRareBiomePop == true
        refs.statsGlitchedLabel.Visible = rareBiomePopOn and Settings.Sols.popGlitched == true
            and (rareCounts.GLITCHED or 0) > 0
        refs.statsDreamspaceLabel.Visible = rareBiomePopOn and Settings.Sols.popDreamspace == true
            and (rareCounts.DREAMSPACE or 0) > 0
        refs.statsCyberspaceLabel.Visible = rareBiomePopOn and Settings.Sols.popCyberspace == true
            and (rareCounts.CYBERSPACE or 0) > 0

        -- 아이템 사용 통계
        refs.strangeControllerCountLabel.Text = getgenv()._RichLine("Strange Controller :",
            (getgenv().StrangeControllerUseCount or 0) .. "번")
        refs.biomeRandomizerCountLabel.Text = getgenv()._RichLine("Biome Randomizer :",
            (getgenv().BiomeRandomizerUseCount or 0) .. "번")

        -- 메모리 매치 획득 아이템
