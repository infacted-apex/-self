local function RunAutoMemoryMatchLogic()
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    -- ✅ [안정화] 타임아웃 없는 WaitForChild가 실패하면 이 감시 루프(RegisterSingleAction의
    -- watcher task.spawn)가 영구히 멈춰서 메모리 매치 기능 전체가 죽는 문제가 있었음.
    -- 10초 타임아웃을 두고, 실패 시 이번 실행만 조용히 포기하고 다음 틱에 재시도한다.
    local PlayerGui = LocalPlayer:WaitForChild("PlayerGui", 10)
    local MainInterface = PlayerGui and PlayerGui:WaitForChild("MainInterface", 10)
    if not MainInterface then return end
    local vim = game:GetService("VirtualInputManager")
    local coreGui = game:GetService("CoreGui")

    -- ✅ [우선순위 시스템] Memory Match 시작 전 우선순위 체크
    if not CanStartMacro("MemoryMatch") then
        return
    end

    StartMacro("MemoryMatch")

    if getgenv().CurrentActiveFeature and getgenv().CurrentActiveFeature ~= "MemoryMatch" then
        StopMacro("MemoryMatch")
        return
    end
    getgenv().CurrentActiveFeature = "MemoryMatch"

    -- ✅ [사용자 요청] 콘솔 print 전부 삭제, 오른쪽 상태 UI만 유지. 호출부(50여 곳)를
    -- 일일이 지우는 대신 함수 자체를 no-op으로 바꿔서 안전하게 출력만 없앤다.
    local function myPrint(msg)
    end

    local function checkToggles()
        if not (Settings and Settings.Sols and Settings.Sols.autoMemoryMatch and Settings.Sols.masterMacroEnabled) then
            if getgenv().CurrentActiveFeature == "MemoryMatch" then getgenv().CurrentActiveFeature = nil end
            return false
        end
        return true
    end

    -- GUI 클릭 함수
    local function ClickGui(guiObj)
        if not guiObj then return end
        local absPos = guiObj.AbsolutePosition
        local absSize = guiObj.AbsoluteSize
        if absSize.X <= 0 then return end
        local topBarH = game:GetService("GuiService"):GetGuiInset().Y
        local cx = math.floor(absPos.X + absSize.X / 2)
        local cy = math.floor(absPos.Y + absSize.Y / 2 + topBarH)
        -- ✅ [사용자 요청] 클릭할 때 시각적 표시(이펙트) 추가
        showPremiumIndicator(cx, cy)
        vim:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
        task.wait(0.1)
        vim:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
    end

    -- ✅ [최적화] 한 번도 호출되지 않는 죽은 함수 3개(moveToPlace3, clickAdClose, ensureClickToMove)
    -- 제거함 - moveToPlace3AutoFishStyle / executeSolaraAdClick / ensureClickToMoveMode로 대체되어
    -- 실제로는 항상 그쪽만 쓰이고 있었음.

    -- ===========================
    -- 메인 로직 시작
    -- ===========================

    local function isClose(udim, scaleX, scaleY)
        if not udim then return false end
        return math.abs(udim.X.Scale - scaleX) < 0.05 and math.abs(udim.Y.Scale - scaleY) < 0.05
    end

    local function GetFrameA()
        for _, frame in ipairs(MainInterface:GetChildren()) do
            if frame:IsA("Frame") then
                local posMatch = (frame.Position == UDim2.new(0.5, 0, 0.5, 0)) or isClose(frame.Position, 0.5, 0.5)
                local sizeMatch = (frame.Size == UDim2.new(0.300000012, 0, 0.300000012, 0)) or
                    isClose(frame.Size, 0.3, 0.3)
                if posMatch and sizeMatch then
                    return frame
                end
            end
        end

        -- 보완: 하위에 "Start Memory Match" 텍스트를 가진 중앙 프레임 보완 검색
        for _, frame in ipairs(MainInterface:GetChildren()) do
            if frame:IsA("Frame") and isClose(frame.Position, 0.5, 0.5) then
                if HasStartMemoryMatchText(frame) then
                    return frame
                end
            end
        end
        return nil
    end

    local function GetMemoryMatchMainFrame()
        for _, frame in ipairs(MainInterface:GetChildren()) do
            if frame:IsA("Frame") then
                for _, desc in ipairs(frame:GetDescendants()) do
                    if desc:IsA("TextLabel") and desc.Text == "Memory Match" then
                        return frame
                    end
                end
            end
        end
