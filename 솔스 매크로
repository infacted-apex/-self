local function addMerchantItemToggle(tab, merchantName, itemName)
    local storageKey = merchantName .. "_" .. itemName
    tab.Toggle({
        Text = itemName,
        -- ✅ [사용자 요청] UI 라이브러리 저장소에도 혹시 모를 텍스트 충돌을 막기 위해
        -- SaveKey를 명시적으로 지정 (이 값 자체는 Settings.Sols.merchantBuyItems로도
        -- 별도 관리되지만, 이중 안전장치로 추가한다).
        SaveKey = storageKey,
        Enabled = Settings.Sols.merchantBuyItems[storageKey] == true,
        Callback = function(v)
            Settings.Sols.merchantBuyItems[storageKey] = v or nil
        end
    })
end

