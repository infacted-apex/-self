local function SaveConfig()
    -- ✅ [치명적 버그 수정] "기능 설정/자동 팝핑 설정/상인 아이템 설정이 유지 안 됨" -
    -- 기존엔 세션/전역/탭별 저장 세 가지를 pcall 하나로 묶어서, 앞쪽(세션 또는 전역
    -- 저장)에서 에러가 나면 pcall이 그 즉시 중단되어 뒤쪽의 탭별 저장 루프 자체가
    -- 아예 실행되지 않았다(토글 자체는 정상 반응하는데 파일이 전혀 안 생기던 증상과
    -- 정확히 일치). 각 저장을 독립적인 pcall로 분리해서, 하나가 실패해도 나머지는
    -- 계속 저장을 시도하도록 한다. 에러가 나면 warn으로 남겨서 원인을 알 수 있게 한다.
    local ok1, err1 = pcall(function()
        if writefile then
            writefile(CONFIG_FILE, HttpService:JSONEncode(ConfigSystem.SavedStates))
        end
    end)
    if not ok1 then warn("[SaveConfig] 세션 저장 실패: " .. tostring(err1)) end

    local ok2, err2 = pcall(function()
        if writefile then
            writefile(GLOBAL_PERMANENT_FILE, HttpService:JSONEncode(ConfigSystem.GlobalPermanentStates))
        end
    end)
    if not ok2 then warn("[SaveConfig] 전역 영구 저장 실패: " .. tostring(err2)) end

    -- ✅ [사용자 요청] 탭별 영구 설정은 각각 별도의 파일에 저장 - 파일명 자체가
    -- 다르므로 다른 탭끼리는 절대 겹치지 않는다. 탭 하나가 실패해도 다른 탭 저장에
    -- 영향이 없도록 각각 개별 pcall로 감싼다.
    for tabTitle, stateTable in pairs(ConfigSystem.PermanentStatesByTab) do
        local ok3, err3 = pcall(function()
            if writefile then
                writefile(GetPermanentFilePath(tabTitle), HttpService:JSONEncode(stateTable))
            end
        end)
        if not ok3 then warn("[SaveConfig] 탭 저장 실패 (" .. tostring(tabTitle) .. "): " .. tostring(err3)) end
    end
end


local original_UI_New = UI.New
UI.New = function(...)
    local args = { ... }
    local tabTitle = (type(args[1]) == "table" and args[1].Title) or ""
    local page = original_UI_New(...)

    local function hookComponent(compName)
        local originalComp = page[compName]
        if not originalComp then return end

        page[compName] = function(options)
            local originalCallback = options.Callback
            local status, result = pcall(function()
                -- ✅ [사용자 요청] options.SaveKey가 있으면 그걸 저장 키로 우선 사용한다.
                -- 같은 탭 안에서 화면 텍스트가 겹치는 항목(예: 자동 팝핑 설정의 여러
                -- "Warp Potion")을 구분하기 위한 것.
                local rawName = options.SaveKey or options.Text or ""
                local cName = rawName:gsub("^%s*(.-)%s*$", "%1") -- 공백 제거
                if cName == "" then return originalComp(options) end

                -- ✅ [치명적 버그 수정] 예전 자작스크는 영구 유지 탭이 "영구" 하나뿐이라
                -- tabTitle == "영구"로 하드코딩되어 있었는데, SolsRNG는 그 역할을 여러
                -- 탭으로 나눴다. PERMANENT_TABS 목록으로 관리한다.
                local isPermanentTab = PERMANENT_TABS[tabTitle] == true
                local isPermanent = isPermanentTab or PERMANENT_ITEMS[cName] or false
                local hasSyncedValue = false
                local syncedValue = nil

                -- ✅ [사용자 요청] 탭에 속한 영구 항목은 그 탭 전용 테이블/파일에서,
                -- 전역 영구 항목(PERMANENT_ITEMS)은 전역 테이블/파일에서 읽는다.
                local permanentStore = nil
                if isPermanentTab then
                    if not ConfigSystem.PermanentStatesByTab[tabTitle] then
                        ConfigSystem.PermanentStatesByTab[tabTitle] = {}
                    end
                    permanentStore = ConfigSystem.PermanentStatesByTab[tabTitle]
                else
                    permanentStore = ConfigSystem.GlobalPermanentStates
                end

                -- [데이터 로드]
                if isPermanent then
                    if permanentStore[cName] ~= nil then
                        syncedValue = permanentStore[cName]
                        hasSyncedValue = true
                        if compName == "TextField" then
                            syncedValue = tostring(syncedValue)
                        end
                        options.Def = syncedValue
                        options.Default = syncedValue
                    end
                elseif ConfigSystem.IsTeleportLoad and ConfigSystem.AutoLoad and ConfigSystem.SavedStates[cName] ~= nil then
                    syncedValue = ConfigSystem.SavedStates[cName]
                    hasSyncedValue = true

                    -- 타입 강제 변환 (라이브러리 충돌 방지)
                    if compName == "TextField" then
                        syncedValue = tostring(syncedValue)
                        options.Text = cName .. " - 동기화됨" -- 버그 수정: 값(syncedValue) 대신 이름(cName) 유지
                        options.Def = syncedValue
                    else
                        syncedValue = (syncedValue == true)
                        options.Enabled = syncedValue
                        options.Def = syncedValue
                    end
                end

                -- [콜백 래퍼]
                local initialCall = true
                local wrappedCallback = function(val)
                    if initialCall then
                        initialCall = false
                        if hasSyncedValue and (val == "" or val == nil or val == false) then
                            return
                        end
                    end

                    if isPermanent then
                        permanentStore[cName] = val
                    else
                        ConfigSystem.SavedStates[cName] = val
                    end

                    SaveConfig()
                    if originalCallback then
                        originalCallback(val)
                    end
                end

                options.Callback = wrappedCallback

                -- [컴포넌트 생성]
                local compObj = originalComp(options)

                -- [동기화 강제 적용]
                if hasSyncedValue then
                    task.spawn(function()
                        task.wait(0.5)
                        pcall(function()
                            if compName == "TextField" and compObj and compObj.SetText then
                                compObj:SetText(syncedValue)
                            elseif compName == "Toggle" and compObj and compObj.SetState then
                                compObj:SetState(syncedValue)
                            end

                            -- 프로그래밍적으로 값을 설정한 후에는 initialCall 플래그를 해제하여
                            -- 사용자의 첫 입력(특히 값을 완전히 지우는 액션)이 무시되지 않도록 수정
                            initialCall = false

                            -- ✅ [치명적 버그 수정] "재접속 시 매크로 시작 웹훅이 3번
                            -- 보내짐" - compObj:SetState(syncedValue)가 대부분의 UI
                            -- 컴포넌트에서 내부적으로 이미 Callback을 트리거하는데, 바로
                            -- 아래에서 originalCallback(syncedValue)을 또 명시적으로 직접
                            -- 호출해서 콜백이 중복 실행되고 있었다(컴포넌트 최초 생성 시
                            -- 자동 호출 1번 + SetState의 자동 호출 1번 + 이 명시적 호출
                            -- 1번 = 총 3번). Toggle은 SetState가 콜백을 확실히 트리거하니
                            -- 이 명시적 호출을 생략한다. TextField 등 다른 컴포넌트는
                            -- SetState 트리거 여부가 불확실할 수 있어 기존 동작을 유지한다.
                            if originalCallback and compName ~= "Toggle" then
                                -- [버그 수정] 아바타 변경 기능은 InitCharacter에서 1초 대기 후 별도로 실행하므로,
                                -- 초기 동기화 시점(서버 진입 중)에는 콜백 호출을 생략하여 중복 실행 및 깜빡임 방지
                                if not (compName == "Toggle" and cName == "아바타 변경 ON/OFF" and ConfigSystem.IsTeleportLoad) then
                                    originalCallback(syncedValue)
                                end
                            end
                        end)
                    end)
                end

                ConfigSystem.Components[cName] = compObj
                ConfigSystem.Callbacks[cName] = wrappedCallback
                return compObj
            end)

            if not status then
                warn("ConfigSystem Hook Error [" .. tostring(compName) .. "]: " .. tostring(result))
                return originalComp(options) -- 오류 시 원본 생성 시도 (UI 유실 방지)
            end
            return result
        end
    end

    hookComponent("Toggle")
    -- hookComponent("Slider") -- 슬라이더 자동 저장/불러오기 제외
    hookComponent("Dropdown")
    hookComponent("TextField")
    hookComponent("Button")

    return page
end

